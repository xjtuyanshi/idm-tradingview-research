e_eventPulse := EVENT_NONE
e_markerPrice := na

bool e_exactDuplicate = e_modeOk and e_sourceAvailable and e_dataReady and not na(e_lastProcessedTime) and e_time == e_lastProcessedTime
bool e_backward = e_modeOk and e_sourceAvailable and e_dataReady and not na(e_lastProcessedTime) and e_time < e_lastProcessedTime
bool e_newSourceBar = e_modeOk and e_sourceAvailable and e_dataReady and (na(e_lastProcessedTime) or e_time > e_lastProcessedTime)

if not e_modeOk
    e_lastProcessedTime := na
    e_contiguousBars := 0
    e_state := STATE_DISABLED
    e_epochDirection := DIRECTION_NONE
