bool r_backwardReset = r_processNow and not na(r_lastConfirmedTime) and e_time < r_lastConfirmedTime
bool r_gapReset = r_processNow and not na(r_lastConfirmedTime) and e_time > r_lastConfirmedTime and e_time - r_lastConfirmedTime != r_BAR_INTERVAL_MS

