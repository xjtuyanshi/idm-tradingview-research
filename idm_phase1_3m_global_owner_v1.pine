    bool itemIdentityOk = r_f_identity_ok(itemSourceId, itemSourceVersion)
    bool itemExpired = itemEnabled and itemValidUntil > 0 and e_time >= itemValidUntil
    bool itemInvalidExpiry = itemEnabled and (itemValidUntil <= 0 or (itemPublishedAt > 0 and itemPublishedAt >= itemValidUntil) or (itemKnownAt > 0 and itemKnownAt >= itemValidUntil))
    bool itemStale = itemEnabled and itemPublishedAt > 0 and itemKnownAt > 0 and itemPublishedAt <= e_time and itemKnownAt <= e_time and itemValidUntil > e_time and e_time - math.max(itemPublishedAt, itemKnownAt) > r_staleMs
    bool itemValid = r_f_band_valid(itemEnabled, itemRole, itemLower, itemUpper, itemKind, itemSourceId, itemSourceVersion, itemPublishedAt, itemKnownAt, itemValidUntil, itemStability, r_staleMs, e_time)
    string itemCanonicalSourceId = r_f_canonical_identity_component(itemSourceId)
    string itemCanonicalSourceVersion = r_f_canonical_identity_component(itemSourceVersion)
    string itemIdentityKey = r_f_identity_key(itemSourceId, itemSourceVersion)
    string itemEffectiveKey = itemValid ? r_f_band_effective_key(itemKind, itemIdentityKey, itemRole, itemLower, itemUpper, itemPublishedAt, itemKnownAt, itemValidUntil) : ""
    array.set(r_bandValid, i, itemValid)
    array.set(r_bandCanonicalSourceId, i, itemCanonicalSourceId)
    array.set(r_bandCanonicalSourceVersion, i, itemCanonicalSourceVersion)
    array.set(r_bandIdentityKey, i, itemIdentityKey)
    array.set(r_bandEffectiveKey, i, itemEffectiveKey)
    r_enabledBandCount += itemEnabled ? 1 : 0
    r_validBandCount += itemValid ? 1 : 0
    r_earliestBandValidUntil := itemValid ? (na(r_earliestBandValidUntil) ? itemValidUntil : math.min(r_earliestBandValidUntil, itemValidUntil)) : r_earliestBandValidUntil
    r_anyBandUnknownKind := r_anyBandUnknownKind or (itemEnabled and not itemKindOk)
    r_anyBandExpired := r_anyBandExpired or itemExpired
    r_anyBandStale := r_anyBandStale or itemStale
    r_anyBandInvalidExpiry := r_anyBandInvalidExpiry or itemInvalidExpiry
    r_anyBandIdentityInvalid := r_anyBandIdentityInvalid or (itemEnabled and not itemIdentityOk)
    r_anyBandContractInvalid := r_anyBandContractInvalid or (itemEnabled and itemKindOk and not itemExpired and not itemInvalidExpiry and not itemValid)
