                bool planTargetReached = r_latestDirection == r_ROLE_SUPPORT ? e_high >= r_latestTarget : e_low <= r_latestTarget
                if planInvalidated
                    r_latestPlanStatus := r_PLAN_INVALIDATED
                    r_latestPlanEndTime := e_timeClose
