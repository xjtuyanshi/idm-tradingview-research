                    e_reason := REASON_MAIN_OPPORTUNITY_ACTIVE

        else if e_epochDirection != DIRECTION_NONE and e_slowDirection != e_epochDirection
            e_state := STATE_WAIT_TREND
            e_epochDirection := DIRECTION_NONE
            e_epochStartTime := na
            e_opportunityActive := false
            e_outcome := OUTCOME_NO_OPPORTUNITY
            e_outcomeDirection := DIRECTION_NONE
            e_reason := REASON_SLOW_CONTEXT_LOST
            e_eventPulse := EVENT_CONTEXT_RESET

        else if e_epochDirection == DIRECTION_NONE
            if e_slowDirection == DIRECTION_NONE
                e_state := STATE_WAIT_TREND
                e_outcome := OUTCOME_NO_OPPORTUNITY
                e_outcomeDirection := DIRECTION_NONE
                e_reason := REASON_WAIT_SLOW_TREND
            else
