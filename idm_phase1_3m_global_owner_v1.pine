            else if e_activeTargetReached
                bool e_targetAlsoLostSlow = e_slowDirection != e_epochDirection
                e_opportunityActive := false
                e_outcome := OUTCOME_NO_OPPORTUNITY
                e_outcomeDirection := DIRECTION_NONE
                e_reason := REASON_TARGET_REACHED
                e_eventPulse := EVENT_TARGET_REACHED
                if e_targetAlsoLostSlow
                    e_state := STATE_WAIT_TREND
                    e_epochDirection := DIRECTION_NONE
                    e_epochStartTime := na
                else
                    e_state := STATE_WAIT_CLEAR
            else if e_slowDirection != e_epochDirection
                e_state := STATE_WAIT_TREND
                e_epochDirection := DIRECTION_NONE
                e_epochStartTime := na
                e_opportunityActive := false
