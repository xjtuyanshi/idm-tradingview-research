else if e_exactDuplicate and not e_transportRepeatAllowed
    e_reason := REASON_DATA_DUPLICATE_IGNORED
else if e_newSourceBar
    bool e_gapReset = not na(e_lastProcessedTime) and e_time - e_lastProcessedTime != PRIMARY_INTERVAL_MS
    e_lastProcessedTime := e_time

    if e_gapReset
        e_contiguousBars := 1
        e_state := STATE_WAIT_TREND
        e_epochDirection := DIRECTION_NONE
        e_epochStartTime := na
        e_episodeStartTime := na
        e_priorExcursion := na
