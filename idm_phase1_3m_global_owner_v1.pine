int r_sourceSurfaceReason = not r_symbolOk ? r_SURFACE_SYMBOL : not r_timeframeOk ? r_SURFACE_TIMEFRAME : not r_standardChartOk ? r_SURFACE_NON_STANDARD : not r_paramsOk ? r_SURFACE_PARAMS : not r_atrEnabled ? r_SURFACE_ATR_DISABLED : not r_atrKindOk ? r_SURFACE_ATR_UNKNOWN : r_atrExpired ? r_SURFACE_ATR_EXPIRED : not r_atrValid ? r_SURFACE_ATR_CONTRACT : r_enabledBandCount == 0 ? r_SURFACE_BAND_DISABLED : r_anyBandUnknownKind ? r_SURFACE_BAND_UNKNOWN : r_anyBandExpired ? r_SURFACE_BAND_EXPIRED : r_anyBandInvalidExpiry ? r_SURFACE_BAND_CONTRACT : r_anyBandIdentityInvalid ? r_SURFACE_BAND_CONTRACT : r_anyBandStale ? r_SURFACE_BAND_STALE : r_duplicateIdentityConflict ? r_SURFACE_DUPLICATE_IDENTITY : r_validBandCount == 0 ? r_SURFACE_BAND_CONTRACT : r_SURFACE_OK
bool r_sourceSurfaceOk = r_sourceSurfaceReason == r_SURFACE_OK
bool r_outwardSurfaceOk = r_sourceSurfaceOk and r_processNow

