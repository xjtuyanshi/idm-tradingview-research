f_source_priority(int source) =>
    source == LEVEL_PRIOR_EXCURSION_10M ? 1 : source == LEVEL_CONFIRMED_PIVOT_10M ? 2 : source == LEVEL_PREVIOUS_COMPLETED_DAY_HIGH or source == LEVEL_PREVIOUS_COMPLETED_DAY_LOW ? 3 : 99

f_provenance_rank(int value) =>
    nz(value, -1)

f_candidate_before(int direction, float leftPrice, int leftSource, int leftTime, float rightPrice, int rightSource, int rightTime) =>
    bool priceBefore = direction == DIRECTION_LONG ? leftPrice < rightPrice : leftPrice > rightPrice
    bool samePrice = leftPrice == rightPrice
    int leftPriority = f_source_priority(leftSource)
    int rightPriority = f_source_priority(rightSource)
    priceBefore or samePrice and (leftPriority < rightPriority or leftPriority == rightPriority and f_provenance_rank(leftTime) < f_provenance_rank(rightTime))

f_source_text(int source) =>
    source == LEVEL_PRIOR_EXCURSION_10M ? "PRIOR_EXCURSION_10M" : source == LEVEL_CONFIRMED_PIVOT_10M ? "CONFIRMED_PIVOT_10M" : source == LEVEL_PREVIOUS_COMPLETED_DAY_HIGH ? "PREVIOUS_COMPLETED_DAY_HIGH" : source == LEVEL_PREVIOUS_COMPLETED_DAY_LOW ? "PREVIOUS_COMPLETED_DAY_LOW" : "UNKNOWN"

f_source_card_text(int source) =>
    source == LEVEL_PRIOR_EXCURSION_10M ? "前段离云位" : source == LEVEL_CONFIRMED_PIVOT_10M ? "确认枢轴" : source == LEVEL_PREVIOUS_COMPLETED_DAY_HIGH ? "前完整日高" : source == LEVEL_PREVIOUS_COMPLETED_DAY_LOW ? "前完整日低" : "未知"

float e_cloudUpper = math.max(e_ema5, e_ema12)
float e_cloudLower = math.min(e_ema5, e_ema12)
int e_slowDirection = na(e_ema21) or na(e_ema48) ? DIRECTION_NONE : e_ema21 > e_ema48 and e_close >= e_ema48 ? DIRECTION_LONG : e_ema21 < e_ema48 and e_close <= e_ema48 ? DIRECTION_SHORT : DIRECTION_NONE
int e_fastDirection = na(e_ema5) or na(e_ema12) ? DIRECTION_NONE : e_ema5 > e_ema12 ? DIRECTION_LONG : e_ema5 < e_ema12 ? DIRECTION_SHORT : DIRECTION_NONE
bool e_dataReady = not na(e_time) and not na(e_timeClose) and not na(e_dayKey) and not na(e_open) and not na(e_high) and not na(e_low) and not na(e_close) and e_high >= e_low and e_high >= math.max(e_open, e_close) and e_low <= math.min(e_open, e_close) and not na(e_ema5) and not na(e_ema12) and not na(e_ema21) and not na(e_ema48) and not na(e_minimumTick) and e_minimumTick > 0

var int e_lastProcessedTime = na
var int e_contiguousBars = 0
var int e_state = STATE_WAIT_TREND
var int e_epochDirection = DIRECTION_NONE
