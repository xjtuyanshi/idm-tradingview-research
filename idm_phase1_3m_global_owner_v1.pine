                else
                    bool e_laterReclaim = e_epochDirection == DIRECTION_LONG ? e_fastDirection == DIRECTION_LONG and e_close > e_reactionHigh and e_close > e_cloudUpper : e_fastDirection == DIRECTION_SHORT and e_close < e_reactionLow and e_close < e_cloudLower
                    if not e_laterReclaim
                        e_reason := REASON_WAIT_LATER_RECLAIM
                    else
