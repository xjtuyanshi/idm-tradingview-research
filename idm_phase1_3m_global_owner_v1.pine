                array.clear(e_frozenCandidateTimes)
                array.clear(e_frozenCandidateConsumed)

        else if e_state == STATE_WAIT_CLEAR
            bool e_fullDeparture = e_epochDirection == DIRECTION_LONG ? e_fastDirection == DIRECTION_LONG and e_low > e_cloudUpper and e_close > e_cloudUpper : e_fastDirection == DIRECTION_SHORT and e_high < e_cloudLower and e_close < e_cloudLower
            if e_fullDeparture
                e_state := STATE_ARMED
                e_episodeStartTime := e_time
                e_priorExcursion := e_epochDirection == DIRECTION_LONG ? e_high : e_low
                e_priorExcursionTime := e_time
                e_pullbackTime := na
                e_reactionHigh := na
                e_reactionLow := na
                e_frozenInvalidation := na
                e_reactionAge := 0
                e_activeAge := 0
                e_opportunityActive := false
                e_opportunityDirection := DIRECTION_NONE
                e_opportunityTime := na
                e_entryReference := na
                e_invalidation := na
                e_nextNamedLevel := na
                e_nextNamedLevelSource := LEVEL_UNKNOWN
                e_nextNamedLevelProvenanceTime := na
                e_risk := na
                e_space := na
                e_spaceR := na
                e_outcome := OUTCOME_NO_OPPORTUNITY
                e_outcomeDirection := DIRECTION_NONE
                e_reason := REASON_EPISODE_ARMED
                array.clear(e_frozenCandidatePrices)
                array.clear(e_frozenCandidateSources)
                array.clear(e_frozenCandidateTimes)
                array.clear(e_frozenCandidateConsumed)
            else
                e_reason := REASON_WAIT_FULL_CLEAR

        else if e_state == STATE_ARMED
            bool e_firstTouch = e_epochDirection == DIRECTION_LONG ? e_low <= e_cloudUpper : e_high >= e_cloudLower
            if e_firstTouch
                e_pullbackTime := e_time
                e_reactionHigh := e_high
                e_reactionLow := e_low
                e_frozenInvalidation := e_epochDirection == DIRECTION_LONG ? math.min(e_low, e_ema48) - 2.0 * e_minimumTick : math.max(e_high, e_ema48) + 2.0 * e_minimumTick
                e_reactionAge := 0
                e_state := STATE_WAIT_REACTION
                e_outcomeDirection := e_epochDirection
                array.clear(e_frozenCandidatePrices)
                array.clear(e_frozenCandidateSources)
                array.clear(e_frozenCandidateTimes)
                array.clear(e_frozenCandidateConsumed)

                bool e_priorForwardAtTouch = not na(e_priorExcursion) and (e_epochDirection == DIRECTION_LONG ? e_priorExcursion > e_high : e_priorExcursion < e_low)
                if e_priorForwardAtTouch
                    array.push(e_frozenCandidatePrices, e_priorExcursion)
                    array.push(e_frozenCandidateSources, LEVEL_PRIOR_EXCURSION_10M)
                    array.push(e_frozenCandidateTimes, e_priorExcursionTime)
                    array.push(e_frozenCandidateConsumed, false)

                if e_epochDirection == DIRECTION_LONG and array.size(e_pivotHighPrices) > 0
                    for e_i = 0 to array.size(e_pivotHighPrices) - 1
                        float e_candidatePrice = array.get(e_pivotHighPrices, e_i)
                        bool e_candidateConsumed = array.get(e_pivotHighConsumed, e_i)
                        if not e_candidateConsumed and e_candidatePrice > e_high
                            array.push(e_frozenCandidatePrices, e_candidatePrice)
                            array.push(e_frozenCandidateSources, LEVEL_CONFIRMED_PIVOT_10M)
                            array.push(e_frozenCandidateTimes, array.get(e_pivotHighTimes, e_i))
                            array.push(e_frozenCandidateConsumed, false)
                if e_epochDirection == DIRECTION_SHORT and array.size(e_pivotLowPrices) > 0
                    for e_i = 0 to array.size(e_pivotLowPrices) - 1
                        float e_candidatePrice = array.get(e_pivotLowPrices, e_i)
                        bool e_candidateConsumed = array.get(e_pivotLowConsumed, e_i)
                        if not e_candidateConsumed and e_candidatePrice < e_low
                            array.push(e_frozenCandidatePrices, e_candidatePrice)
                            array.push(e_frozenCandidateSources, LEVEL_CONFIRMED_PIVOT_10M)
                            array.push(e_frozenCandidateTimes, array.get(e_pivotLowTimes, e_i))
                            array.push(e_frozenCandidateConsumed, false)
                if e_epochDirection == DIRECTION_LONG and not na(e_previousDayHigh) and not e_previousDayHighConsumed and e_previousDayHigh > e_high
                    array.push(e_frozenCandidatePrices, e_previousDayHigh)
                    array.push(e_frozenCandidateSources, LEVEL_PREVIOUS_COMPLETED_DAY_HIGH)
                    array.push(e_frozenCandidateTimes, e_previousDayAvailableTime)
                    array.push(e_frozenCandidateConsumed, false)
                if e_epochDirection == DIRECTION_SHORT and not na(e_previousDayLow) and not e_previousDayLowConsumed and e_previousDayLow < e_low
                    array.push(e_frozenCandidatePrices, e_previousDayLow)
                    array.push(e_frozenCandidateSources, LEVEL_PREVIOUS_COMPLETED_DAY_LOW)
                    array.push(e_frozenCandidateTimes, e_previousDayAvailableTime)
                    array.push(e_frozenCandidateConsumed, false)

                // Freeze an ordered candidate set at touch: nearest price,
                // then source priority, then earliest causal provenance.
                int e_frozenCount = array.size(e_frozenCandidatePrices)
                if e_frozenCount > 1
                    for e_sortIndex = 1 to e_frozenCount - 1
                        float e_sortPrice = array.get(e_frozenCandidatePrices, e_sortIndex)
                        int e_sortSource = array.get(e_frozenCandidateSources, e_sortIndex)
                        int e_sortTime = array.get(e_frozenCandidateTimes, e_sortIndex)
                        bool e_sortConsumed = array.get(e_frozenCandidateConsumed, e_sortIndex)
                        int e_insertIndex = e_sortIndex - 1
                        while e_insertIndex >= 0
                            bool e_sortBefore = f_candidate_before(e_epochDirection, e_sortPrice, e_sortSource, e_sortTime, array.get(e_frozenCandidatePrices, e_insertIndex), array.get(e_frozenCandidateSources, e_insertIndex), array.get(e_frozenCandidateTimes, e_insertIndex))
                            if not e_sortBefore
                                break
                            array.set(e_frozenCandidatePrices, e_insertIndex + 1, array.get(e_frozenCandidatePrices, e_insertIndex))
                            array.set(e_frozenCandidateSources, e_insertIndex + 1, array.get(e_frozenCandidateSources, e_insertIndex))
                            array.set(e_frozenCandidateTimes, e_insertIndex + 1, array.get(e_frozenCandidateTimes, e_insertIndex))
                            array.set(e_frozenCandidateConsumed, e_insertIndex + 1, array.get(e_frozenCandidateConsumed, e_insertIndex))
                            e_insertIndex -= 1
                        array.set(e_frozenCandidatePrices, e_insertIndex + 1, e_sortPrice)
                        array.set(e_frozenCandidateSources, e_insertIndex + 1, e_sortSource)
                        array.set(e_frozenCandidateTimes, e_insertIndex + 1, e_sortTime)
                        array.set(e_frozenCandidateConsumed, e_insertIndex + 1, e_sortConsumed)

                if e_epochDirection == DIRECTION_LONG
                    e_outcome := OUTCOME_WATCH_LONG
                    e_eventPulse := EVENT_WATCH_LONG
                    e_markerPrice := e_low
                else
                    e_outcome := OUTCOME_WATCH_SHORT
                    e_eventPulse := EVENT_WATCH_SHORT
                    e_markerPrice := e_high
                e_reason := REASON_FIRST_PULLBACK_WATCH
            else
                if e_epochDirection == DIRECTION_LONG
                    if na(e_priorExcursion) or e_high > e_priorExcursion
                        e_priorExcursion := e_high
                        e_priorExcursionTime := e_time
                else
                    if na(e_priorExcursion) or e_low < e_priorExcursion
                        e_priorExcursion := e_low
                        e_priorExcursionTime := e_time
                e_reason := REASON_WAIT_FIRST_PULLBACK

        // Finalize the current ET day only after state logic has consumed
        // the previous-completed snapshot.
        if e_currentDayBarCount == 0
            e_currentDayFirstTime := e_time
            e_currentDayLastTime := e_time
            e_currentDayBarCount := 1
            e_currentDayContiguous := hour(e_time, "America/New_York") == 0 and minute(e_time, "America/New_York") == 0 and second(e_time, "America/New_York") == 0
        else
            e_currentDayContiguous := e_currentDayContiguous and e_time - e_currentDayLastTime == PRIMARY_INTERVAL_MS
            e_currentDayLastTime := e_time
            e_currentDayBarCount += 1
        e_currentDayHigh := na(e_currentDayHigh) ? e_high : math.max(e_currentDayHigh, e_high)
        e_currentDayLow := na(e_currentDayLow) ? e_low : math.min(e_currentDayLow, e_low)

        // Register 2/2 pivots after state advancement.  A pivot becoming
        // known on the touch bar therefore cannot backfill that episode.
        if e_contiguousBars >= PIVOT_LEFT_BARS + PIVOT_RIGHT_BARS + 1 and not na(e_newPivotHigh)
            array.push(e_pivotHighPrices, e_newPivotHigh)
            array.push(e_pivotHighTimes, e_newPivotHighTime)
            array.push(e_pivotHighConsumed, false)
            if array.size(e_pivotHighPrices) > MAX_PIVOT_LEVELS
                array.shift(e_pivotHighPrices)
                array.shift(e_pivotHighTimes)
                array.shift(e_pivotHighConsumed)
        if e_contiguousBars >= PIVOT_LEFT_BARS + PIVOT_RIGHT_BARS + 1 and not na(e_newPivotLow)
            array.push(e_pivotLowPrices, e_newPivotLow)
            array.push(e_pivotLowTimes, e_newPivotLowTime)
            array.push(e_pivotLowConsumed, false)
            if array.size(e_pivotLowPrices) > MAX_PIVOT_LEVELS
                array.shift(e_pivotLowPrices)
                array.shift(e_pivotLowTimes)
                array.shift(e_pivotLowConsumed)
// PRIMARY10M_CANONICAL_R3_END phase1-10m-primary-opportunity-3.0

// Exact canonical POSITION_REVERSAL producer core, namespaced and fed by
// the same transported raw 10m tuple.  No standalone UI/alerts are copied.
bool r_processNow = go_processPayload

r_f_role_code(string roleText) => roleText == r_ROLE_SUPPORT_TEXT ? r_ROLE_SUPPORT : roleText == r_ROLE_RESISTANCE_TEXT ? r_ROLE_RESISTANCE : r_ROLE_NONE
r_f_identity_component_ok(string value) =>
    int componentLength = str.length(value)
    bool componentOk = componentLength >= 1 and componentLength <= r_IDENTITY_COMPONENT_MAX_LENGTH and value == str.trim(value)
    if componentOk
        string firstCharacter = str.substring(value, 0, 1)
        string lastCharacter = str.substring(value, componentLength - 1, componentLength)
        componentOk := str.contains(r_IDENTITY_ASCII_ALNUM, firstCharacter) and str.contains(r_IDENTITY_ASCII_ALNUM, lastCharacter)
    if componentOk
        for characterIndex = 0 to componentLength - 1
            string character = str.substring(value, characterIndex, characterIndex + 1)
            if not str.contains(r_IDENTITY_COMPONENT_SAFE_CHARS, character)
                componentOk := false
    componentOk
r_f_canonical_identity_component(string value) => r_f_identity_component_ok(value) ? value : ""
r_f_identity_ok(string sourceId, string sourceVersion) => r_f_identity_component_ok(sourceId) and r_f_identity_component_ok(sourceVersion)
r_f_identity_key(string sourceId, string sourceVersion) => r_f_identity_ok(sourceId, sourceVersion) ? r_IDENTITY_ENCODING_VERSION + ":" + sourceId + "@" + sourceVersion : ""
r_f_band_kind_allowed(string sourceKind) => str.trim(sourceKind) == r_SOURCE_KIND_SATY_ATR_MAP_LEVEL
r_f_atr_kind_allowed(string sourceKind) => str.trim(sourceKind) == r_SOURCE_KIND_PREVIOUS_COMPLETED_DAILY_ATR
r_f_absolute_window_ok(int publishedAt, int knownAt, int validUntil, int barOpen) => publishedAt > 0 and knownAt > 0 and validUntil > 0 and publishedAt <= barOpen and knownAt <= barOpen and barOpen < validUntil and publishedAt < validUntil and knownAt < validUntil
r_f_fresh(int publishedAt, int knownAt, int r_staleMs, int barOpen) => publishedAt > 0 and knownAt > 0 and publishedAt <= barOpen and knownAt <= barOpen and barOpen - math.max(publishedAt, knownAt) <= r_staleMs
r_f_delivery_window_ok(int publishedAt, int knownAt, int validUntil, int r_staleMs, int barOpen, int barClose) => r_f_absolute_window_ok(publishedAt, knownAt, validUntil, barOpen) and r_f_fresh(publishedAt, knownAt, r_staleMs, barOpen) and barClose < validUntil and barClose - math.max(publishedAt, knownAt) <= r_staleMs
r_f_band_valid(bool enabled, int role, float lower, float upper, string sourceKind, string sourceId, string sourceVersion, int publishedAt, int knownAt, int validUntil, string stability, int r_staleMs, int barOpen) => enabled and role != r_ROLE_NONE and not na(lower) and not na(upper) and lower <= upper and r_f_band_kind_allowed(sourceKind) and r_f_identity_ok(sourceId, sourceVersion) and stability == r_STABILITY_PRIOR and r_f_absolute_window_ok(publishedAt, knownAt, validUntil, barOpen) and r_f_fresh(publishedAt, knownAt, r_staleMs, barOpen)
r_f_atr_source_bar_ok(string sourceTimeframe, int sourceOpen, int sourceClose, int knownAt, int barOpen) => str.trim(sourceTimeframe) == r_DAILY_TIMEFRAME and sourceOpen > 0 and sourceClose > sourceOpen and sourceClose <= knownAt and knownAt <= barOpen
r_f_atr_valid(bool enabled, float atrValue, string sourceKind, string sourceId, string sourceVersion, int publishedAt, int knownAt, int validUntil, string sourceTimeframe, int sourceOpen, int sourceClose, string stability, int r_staleMs, int barOpen) => enabled and not na(atrValue) and atrValue > 0 and r_f_atr_kind_allowed(sourceKind) and r_f_identity_ok(sourceId, sourceVersion) and stability == r_STABILITY_PRIOR and r_f_absolute_window_ok(publishedAt, knownAt, validUntil, barOpen) and r_f_fresh(publishedAt, knownAt, r_staleMs, barOpen) and r_f_atr_source_bar_ok(sourceTimeframe, sourceOpen, sourceClose, knownAt, barOpen)
r_f_scaled(float value) => str.tostring(int(math.round(value * r_EFFECTIVE_NUMBER_SCALE)))
r_f_band_effective_key(string sourceKind, string identityKey, int role, float lower, float upper, int publishedAt, int knownAt, int validUntil) => r_IDENTITY_ENCODING_VERSION + "|B|" + str.trim(sourceKind) + "|" + identityKey + "|" + (role == r_ROLE_SUPPORT ? r_ROLE_SUPPORT_TEXT : role == r_ROLE_RESISTANCE ? r_ROLE_RESISTANCE_TEXT : r_ROLE_DISABLED_TEXT) + "|" + r_f_scaled(lower) + "|" + r_f_scaled(upper) + "|" + str.tostring(publishedAt) + "|" + str.tostring(knownAt) + "|" + str.tostring(validUntil)
r_f_atr_effective_key(string sourceKind, string identityKey, float atrValue, int publishedAt, int knownAt, int validUntil, string sourceTimeframe, int sourceOpen, int sourceClose) => r_IDENTITY_ENCODING_VERSION + "|A|" + str.trim(sourceKind) + "|" + identityKey + "|" + r_f_scaled(atrValue) + "|" + str.tostring(publishedAt) + "|" + str.tostring(knownAt) + "|" + str.tostring(validUntil) + "|" + str.trim(sourceTimeframe) + "|" + str.tostring(sourceOpen) + "|" + str.tostring(sourceClose)
r_f_price(float value) => na(value) ? "—" : str.tostring(value, format.mintick)
r_f_time(int value) => na(value) ? "—" : str.format_time(value, "MM-dd HH:mm", "America/New_York") + " ET"
r_f_state_text(int state) => state == r_ST_APPROACH ? "位置观察｜等待收回/压回" : state == r_ST_READY ? "条件已确认" : state == r_ST_FAILED ? "本轮不做" : state == r_ST_EXPIRED ? "反应窗口已到期" : state == r_ST_DISABLED ? "来源不可用" : "等待位置"
r_f_reason_text(int r_reason) => r_reason == r_RS_READY ? "空间 ≥ 1R｜条件计划已冻结" : r_reason == r_RS_ACCEPTED_BREAK ? "位置已被接受突破｜不倒填" : r_reason == r_RS_TARGET_MISSING ? "无开盘前已知的最近反向目标" : r_reason == r_RS_TARGET_CONSUMED ? "最近目标已消耗｜不跳远" : r_reason == r_RS_RISK_INVALID ? "冻结风险/收益无效" : r_reason == r_RS_SPACE_LT_1R ? "最近目标空间 < 1R｜不做" : r_reason == r_RS_REACTION_EXPIRED ? "第三根仍无已确认反应" : r_reason == r_RS_WAIT_CLEAR_REQUIRED ? "等待完整离位 0.12 ATR" : r_reason == r_RS_WAIT_CLEAR_COMPLETED ? "完整离位完成｜下一 K 才可新建" : r_reason == r_RS_POSITION_CONFLICT ? "同 K 支撑/阻力冲突｜不做" : r_reason == r_RS_MULTIPLE_SAME_SIDE ? "同向多位置同时触及｜不做" : r_reason == r_RS_DATA_DUPLICATE ? "重复时间戳｜忽略" : r_reason == r_RS_DATA_NON_MONOTONIC ? "时间倒退｜数据重置" : r_reason == r_RS_DATA_GAP_RESET ? "10m 断档｜数据重置" : r_reason == r_RS_DATA_RESET ? "图表/来源异常｜关闭输出" : r_reason == r_RS_WATCH_ONLY ? "仅观察｜不是方向授权" : "等待开盘前已知位置"
r_f_plan_status_text(int planStatus) => planStatus == r_PLAN_ACTIVE ? "当前条件计划有效" : planStatus == r_PLAN_INVALIDATED ? "保护位先到｜计划结束" : planStatus == r_PLAN_TARGET_REACHED ? "目标先到｜计划结束" : planStatus == r_PLAN_EXPIRED ? "12 根许可已到期" : planStatus == r_PLAN_SUPPRESSED ? "数据/来源重置｜计划隐藏" : "无当前计划"
r_f_surface_reason_text(int surfaceReason) => surfaceReason == r_SURFACE_SYMBOL ? "配置错误｜仅支持 CAPITALCOM:SPX500" : surfaceReason == r_SURFACE_TIMEFRAME ? "配置错误｜仅支持原生 10m" : surfaceReason == r_SURFACE_NON_STANDARD ? "配置错误｜仅支持标准 K 线" : surfaceReason == r_SURFACE_PARAMS ? "冻结参数合同无效" : surfaceReason == r_SURFACE_ATR_DISABLED ? "未配置｜先启用上一完成日 ATR" : surfaceReason == r_SURFACE_ATR_UNKNOWN ? "ATR 来源类型未识别" : surfaceReason == r_SURFACE_ATR_EXPIRED ? "ATR 已过期｜更新日更来源" : surfaceReason == r_SURFACE_ATR_CONTRACT ? "ATR 合同无效｜检查时间/身份" : surfaceReason == r_SURFACE_BAND_DISABLED ? "未配置｜至少启用一个具名位" : surfaceReason == r_SURFACE_BAND_UNKNOWN ? "具名位来源类型未识别" : surfaceReason == r_SURFACE_BAND_EXPIRED ? "具名位已过期｜更新日更来源" : surfaceReason == r_SURFACE_BAND_STALE ? "具名位已超 36 小时｜更新日更来源" : surfaceReason == r_SURFACE_DUPLICATE_IDENTITY ? "具名位身份重复" : surfaceReason == r_SURFACE_BAND_CONTRACT ? "具名位合同无效｜检查时间/身份" : "来源可用"
r_f_plan_gate(int r_side, float barHigh, float barLow, float r_episodeHigh, float r_episodeLow, float atrValue, bool targetPresent, float targetPrice) =>
    float trigger = r_side == r_ROLE_SUPPORT ? barHigh : barLow
    float buffer = math.max(2.0 * r_MINIMUM_TICK, r_STOP_BUFFER_ATR * atrValue)
    float invalidation = r_side == r_ROLE_SUPPORT ? r_episodeLow - buffer : r_episodeHigh + buffer
    float risk = r_side == r_ROLE_SUPPORT ? trigger - invalidation : invalidation - trigger
    bool targetConsumed = targetPresent and (r_side == r_ROLE_SUPPORT ? r_episodeHigh >= targetPrice : r_episodeLow <= targetPrice)
    float reward = targetPresent ? (r_side == r_ROLE_SUPPORT ? targetPrice - trigger : trigger - targetPrice) : na
    float spaceR = not na(reward) and risk > 0 ? reward / risk : na
    int outState = not targetPresent ? r_ST_FAILED : targetConsumed ? r_ST_FAILED : risk <= 0 or na(reward) or reward <= 0 ? r_ST_FAILED : spaceR < r_MINIMUM_SPACE_R ? r_ST_FAILED : r_ST_READY
    int outReason = not targetPresent ? r_RS_TARGET_MISSING : targetConsumed ? r_RS_TARGET_CONSUMED : risk <= 0 or na(reward) or reward <= 0 ? r_RS_RISK_INVALID : spaceR < r_MINIMUM_SPACE_R ? r_RS_SPACE_LT_1R : r_RS_READY
    [outState, outReason, trigger, invalidation, risk, reward, spaceR]

int r_staleMs = r_DEFAULT_STALE_AFTER_MS
bool r_symbolOk = ticker.standard(syminfo.tickerid) == r_EXPECTED_SYMBOL
bool r_timeframeOk = "10" == "10"
bool r_standardChartOk = chart.is_standard
bool r_paramsOk = r_MAX_REACTION_BARS == 3 and r_MINIMUM_SPACE_R == 1.0 and r_STOP_BUFFER_ATR == 0.002 and r_REARM_ATR == 0.12 and r_OPPORTUNITY_LIFETIME_BARS == 12 and r_DEFAULT_STALE_AFTER_MS == 129600000 and r_MINIMUM_TICK == 0.1 and r_EFFECTIVE_NUMBER_SCALE == 10000000000 and r_IDENTITY_ENCODING_VERSION == "CID1" and r_IDENTITY_COMPONENT_MAX_LENGTH == 64
bool r_hostSurfaceOk = r_symbolOk and r_timeframeOk and r_standardChartOk and r_paramsOk
bool r_atrKindOk = r_f_atr_kind_allowed(r_atrSourceKindInput)
bool r_atrExpired = r_atrEnabled and r_atrValidUntilInput > 0 and e_time >= r_atrValidUntilInput
bool r_atrValid = r_f_atr_valid(r_atrEnabled, r_atrInput, r_atrSourceKindInput, r_atrSourceIdInput, r_atrSourceVersionInput, r_atrPublishedAtInput, r_atrKnownAtInput, r_atrValidUntilInput, r_atrSourceTimeframeInput, r_atrCompletedSourceOpenInput, r_atrCompletedSourceCloseInput, r_atrStabilityInput, r_staleMs, e_time)
string r_atrCanonicalSourceId = r_f_canonical_identity_component(r_atrSourceIdInput)
string r_atrCanonicalSourceVersion = r_f_canonical_identity_component(r_atrSourceVersionInput)
string r_atrIdentityKey = r_f_identity_key(r_atrSourceIdInput, r_atrSourceVersionInput)
string r_atrEffectiveKey = r_atrValid ? r_f_atr_effective_key(r_atrSourceKindInput, r_atrIdentityKey, r_atrInput, r_atrPublishedAtInput, r_atrKnownAtInput, r_atrValidUntilInput, r_atrSourceTimeframeInput, r_atrCompletedSourceOpenInput, r_atrCompletedSourceCloseInput) : ""

array<bool> r_bandEnabled = array.from(r_l1Enabled, r_l2Enabled, r_l3Enabled, r_l4Enabled)
array<string> r_bandSourceKind = array.from(r_l1SourceKind, r_l2SourceKind, r_l3SourceKind, r_l4SourceKind)
array<int> r_bandRole = array.from(r_f_role_code(r_l1RoleText), r_f_role_code(r_l2RoleText), r_f_role_code(r_l3RoleText), r_f_role_code(r_l4RoleText))
array<float> r_bandLower = array.from(r_l1Lower, r_l2Lower, r_l3Lower, r_l4Lower)
array<float> r_bandUpper = array.from(r_l1Upper, r_l2Upper, r_l3Upper, r_l4Upper)
array<string> r_bandSourceId = array.from(r_l1SourceId, r_l2SourceId, r_l3SourceId, r_l4SourceId)
array<string> r_bandSourceVersion = array.from(r_l1SourceVersion, r_l2SourceVersion, r_l3SourceVersion, r_l4SourceVersion)
array<int> r_bandPublishedAt = array.from(r_l1PublishedAt, r_l2PublishedAt, r_l3PublishedAt, r_l4PublishedAt)
array<int> r_bandKnownAt = array.from(r_l1KnownAt, r_l2KnownAt, r_l3KnownAt, r_l4KnownAt)
array<int> r_bandValidUntil = array.from(r_l1ValidUntil, r_l2ValidUntil, r_l3ValidUntil, r_l4ValidUntil)
array<string> r_bandStability = array.from(r_l1Stability, r_l2Stability, r_l3Stability, r_l4Stability)
array<bool> r_bandValid = array.new_bool(4, false)
array<string> r_bandCanonicalSourceId = array.new_string(4, "")
array<string> r_bandCanonicalSourceVersion = array.new_string(4, "")
array<string> r_bandIdentityKey = array.new_string(4, "")
array<string> r_bandEffectiveKey = array.new_string(4, "")
int r_enabledBandCount = 0
int r_validBandCount = 0
int r_earliestBandValidUntil = na
bool r_anyBandUnknownKind = false
bool r_anyBandExpired = false
bool r_anyBandStale = false
bool r_anyBandInvalidExpiry = false
bool r_anyBandIdentityInvalid = false
bool r_anyBandContractInvalid = false
for i = 0 to 3
    bool itemEnabled = array.get(r_bandEnabled, i)
    string itemKind = array.get(r_bandSourceKind, i)
