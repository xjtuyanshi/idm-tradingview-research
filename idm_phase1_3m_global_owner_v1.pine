                            e_reason := REASON_MAIN_OPPORTUNITY_ACTIVE

        else if e_state == STATE_ACTIVE
            bool e_activeInvalidated = e_opportunityDirection == DIRECTION_LONG ? e_close < e_invalidation : e_close > e_invalidation
            bool e_activeTargetReached = not na(e_nextNamedLevel) and (e_opportunityDirection == DIRECTION_LONG ? e_high >= e_nextNamedLevel : e_low <= e_nextNamedLevel)
            if e_activeInvalidated
                bool e_activeAlsoLostSlow = e_slowDirection != e_epochDirection
                e_opportunityActive := false
                e_outcome := OUTCOME_NO_OPPORTUNITY
                e_outcomeDirection := DIRECTION_NONE
                e_reason := REASON_FROZEN_INVALIDATION_BROKEN
                e_eventPulse := EVENT_INVALIDATED
                e_markerPrice := e_invalidation
