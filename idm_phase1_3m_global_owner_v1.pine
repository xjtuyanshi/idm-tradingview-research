dAt[1], l2KnownAt[1], l2ValidUntil[1], l2Stability[1], l3Enabled[1], l3SourceKind[1], l3SourceId[1], l3SourceVersion[1], l3RoleText[1], l3Lower[1], l3Upper[1], l3PublishedAt[1], l3KnownAt[1], l3ValidUntil[1], l3Stability[1], l4Enabled[1], l4SourceKind[1], l4SourceId[1], l4SourceVersion[1], l4RoleText[1], l4Lower[1], l4Upper[1], l4PublishedAt[1], l4KnownAt[1], l4ValidUntil[1], l4Stability[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

