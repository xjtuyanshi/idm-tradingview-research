                                if not e_candidateConsumed and e_candidateForward
                                    bool e_candidateBetter = na(e_selectedPrice) or f_candidate_before(e_epochDirection, e_candidatePrice, e_candidateSource, e_candidateTime, e_selectedPrice, e_selectedSource, e_selectedTime)
                                    if e_candidateBetter
