//@version=6
// IDM v14 — Layer 1: the named-level map
//
// This layer contains no statistics, no signals and no assumptions.  It draws
// the levels Saty's own posts refer to by name, and nothing else.  That makes
// it verifiable by inspection: load it next to the official "Saty ATR Levels"
// and every ATR line must sit exactly on top of its counterpart.
//
// Construction is copied from the official indicator's published source
// (TradingView PUB;99165984ef224287a726a7f24576b530, author satymahajan):
//
//     period_index   = use_current_close ? 0 : 1
//     ticker         = ticker.new(prefix, ticker, session=session.extended)
//     previous_close = security(ticker, tf, close[period_index])
//     atr            = security(ticker, tf, ta.atr(atr_length)[period_index])
//     lower_trigger  = previous_close - trigger_percentage * atr
//     upper_trigger  = previous_close + trigger_percentage * atr
//
// Verified 2026-07-26 against the official indicator on CAPITALCOM:SPX500:
// anchor 7417.50, ATR 88.48, call 7438.38, put 7396.62, +1 ATR 7505.98 —
// reproduced to the cent by this construction.
//
// The three session levels (overnight, pre-market, previous day) are the ones
// his pre-market scripts lean on most and that our engine never had:
//   "hold pre-market support ... break back over pre-market highs"
//   "back to PDC and overnight lows"

indicator("IDM v14 Map", shorttitle="IDM v14 Map", overlay=true,
     max_lines_count=120, max_labels_count=80)

const string VERSION_ID = "14.0.0-map"

// ── Inputs ────────────────────────────────────────────────────────────────
string G_ATR  = "01 · ATR 位（对齐官方 Saty ATR Levels）"
string G_SESS = "02 · 时段位（盘前 / 夜盘 / 前日）"
string G_VIEW = "03 · 显示"

string MODE_DAY = "Day 日内"
string MODE_WEEK = "Multiday 周"
string MODE_MONTH = "Swing 月"
string MODE_QUARTER = "Position 季"

string atrMode = input.string(MODE_DAY, "ATR 模式", group=G_ATR,
     options=[MODE_DAY, MODE_WEEK, MODE_MONTH, MODE_QUARTER],
     tooltip="与官方指标的 Trading Type 一一对应。Day=日线 ATR，Multiday=周线，" +
         "Swing=月线，Position=季线。")
int atrLen = input.int(14, "ATR 长度", minval=2, group=G_ATR)
float trigPct = input.float(0.236, "Trigger 比例", step=0.001, group=G_ATR)
bool useCurrentClose = input.bool(false, "用当前周期收盘（官方默认关）", group=G_ATR,
     tooltip="关=用上一个已完成周期的收盘做锚（官方默认，无前视）。")
bool showFib = input.bool(true, "显示全部斐波那契位", group=G_ATR)
bool showExt = input.bool(false, "显示延伸位 ±1.272 / ±1.618", group=G_ATR)

bool showOvernight = input.bool(true, "夜盘高低 (18:00→09:30 ET)", group=G_SESS)
bool showPremarket = input.bool(true, "盘前高低 (04:00→09:30 ET)", group=G_SESS)
bool showPrevDay = input.bool(true, "前日高低 PDH / PDL", group=G_SESS)

bool showLabels = input.bool(true, "显示价格标签", group=G_VIEW)
bool showTable = input.bool(true, "显示信息表（用于和官方指标对账）", group=G_VIEW)
int lineWidth = input.int(1, "线宽", minval=1, maxval=4, group=G_VIEW)

// ── Palette ───────────────────────────────────────────────────────────────
color COL_ANCHOR = color.new(color.white, 0)
color COL_TRIGGER_UP = color.new(color.aqua, 0)
color COL_TRIGGER_DN = color.new(color.yellow, 0)
color COL_KEY = color.new(color.silver, 20)
color COL_ATR_FULL = color.new(color.white, 20)
color COL_MID = color.new(color.gray, 40)
color COL_ON = color.new(color.purple, 30)
color COL_PM = color.new(color.orange, 30)
color COL_PD = color.new(color.blue, 40)

// ── ATR level engine (mirrors the official construction) ──────────────────
f_tf() =>
    atrMode == MODE_WEEK ? "W" :
     atrMode == MODE_MONTH ? "M" :
     atrMode == MODE_QUARTER ? "3M" : "D"

int periodIndex = useCurrentClose ? 0 : 1
var string tkr = ticker.new(syminfo.prefix, syminfo.ticker,
     session=session.extended)

[anchor, atrVal, periodHigh, periodLow] = request.security(tkr, f_tf(),
     [close[periodIndex], ta.atr(atrLen)[periodIndex], high, low],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

f_at(float ratio) => anchor + ratio * atrVal

float lvlTrigUp = f_at(trigPct)
float lvlTrigDn = f_at(-trigPct)

// ── Session ranges ────────────────────────────────────────────────────────
// Overnight spans midnight; Pine session strings handle that directly.
f_sess_range(string sess, bool enabled) =>
    var float hi = na
    var float lo = na
    bool inSess = enabled and
         not na(time(timeframe.period, sess, "America/New_York"))
    bool started = inSess and not inSess[1]
    if started
        hi := high
        lo := low
    else if inSess
        hi := math.max(nz(hi, high), high)
        lo := math.min(nz(lo, low), low)
    [hi, lo, inSess]

[onHigh, onLow, onActive] = f_sess_range("1800-0930", showOvernight)
[pmHigh, pmLow, pmActive] = f_sess_range("0400-0930", showPremarket)

[pdh, pdl] = request.security(tkr, "D", [high[1], low[1]],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

// ── Plots: ATR ladder ─────────────────────────────────────────────────────
plot(f_at(0.0), "PDC 锚", color=COL_ANCHOR, linewidth=lineWidth + 1,
     style=plot.style_stepline)
plot(lvlTrigUp, "Call trigger +0.236", color=COL_TRIGGER_UP,
     linewidth=lineWidth, style=plot.style_stepline)
plot(lvlTrigDn, "Put trigger -0.236", color=COL_TRIGGER_DN,
     linewidth=lineWidth, style=plot.style_stepline)
plot(showFib ? f_at(0.382) : na, "+0.382 GG入口", color=COL_MID,
     linewidth=lineWidth, style=plot.style_stepline)
plot(showFib ? f_at(-0.382) : na, "-0.382 GG入口", color=COL_MID,
     linewidth=lineWidth, style=plot.style_stepline)
plot(showFib ? f_at(0.5) : na, "+0.5 midrange", color=COL_KEY,
     linewidth=lineWidth, style=plot.style_stepline)
plot(showFib ? f_at(-0.5) : na, "-0.5 midrange", color=COL_KEY,
     linewidth=lineWidth, style=plot.style_stepline)
plot(showFib ? f_at(0.618) : na, "+0.618 GG完成", color=COL_KEY,
     linewidth=lineWidth, style=plot.style_stepline)
plot(showFib ? f_at(-0.618) : na, "-0.618 GG完成", color=COL_KEY,
     linewidth=lineWidth, style=plot.style_stepline)
plot(showFib ? f_at(0.786) : na, "+0.786", color=COL_MID,
     linewidth=lineWidth, style=plot.style_stepline)
plot(showFib ? f_at(-0.786) : na, "-0.786", color=COL_MID,
     linewidth=lineWidth, style=plot.style_stepline)
plot(f_at(1.0), "+1 ATR", color=COL_ATR_FULL, linewidth=lineWidth,
     style=plot.style_stepline)
plot(f_at(-1.0), "-1 ATR", color=COL_ATR_FULL, linewidth=lineWidth,
     style=plot.style_stepline)
plot(showExt ? f_at(1.272) : na, "+1.272 ext", color=COL_MID,
     linewidth=lineWidth, style=plot.style_stepline)
plot(showExt ? f_at(-1.272) : na, "-1.272 ext", color=COL_MID,
     linewidth=lineWidth, style=plot.style_stepline)
plot(showExt ? f_at(1.618) : na, "+1.618 ext", color=COL_MID,
     linewidth=lineWidth, style=plot.style_stepline)
plot(showExt ? f_at(-1.618) : na, "-1.618 ext", color=COL_MID,
     linewidth=lineWidth, style=plot.style_stepline)

// ── Plots: session levels ─────────────────────────────────────────────────
plot(showOvernight ? onHigh : na, "夜盘高", color=COL_ON,
     linewidth=lineWidth, style=plot.style_stepline)
plot(showOvernight ? onLow : na, "夜盘低", color=COL_ON,
     linewidth=lineWidth, style=plot.style_stepline)
plot(showPremarket ? pmHigh : na, "盘前高", color=COL_PM,
     linewidth=lineWidth, style=plot.style_stepline)
plot(showPremarket ? pmLow : na, "盘前低", color=COL_PM,
     linewidth=lineWidth, style=plot.style_stepline)
plot(showPrevDay ? pdh : na, "PDH 前日高", color=COL_PD,
     linewidth=lineWidth, style=plot.style_stepline)
plot(showPrevDay ? pdl : na, "PDL 前日低", color=COL_PD,
     linewidth=lineWidth, style=plot.style_stepline)

// ── Right-edge labels (create once, then set — never delete/recreate) ─────
f_tag(label lb, float px, string txt, color col) =>
    if not na(px)
        label.set_xy(lb, bar_index + 6, px)
        label.set_text(lb, txt)
        label.set_color(lb, color.new(col, 85))
        label.set_textcolor(lb, col)
        label.set_style(lb, label.style_label_left)
        label.set_size(lb, size.small)
    else
        label.set_text(lb, "")
        label.set_color(lb, color.new(color.black, 100))
        label.set_textcolor(lb, color.new(color.black, 100))

var label lbAnchor = label.new(na, na, "", xloc=xloc.bar_index)
var label lbTrigUp = label.new(na, na, "", xloc=xloc.bar_index)
var label lbTrigDn = label.new(na, na, "", xloc=xloc.bar_index)
var label lbAtrUp = label.new(na, na, "", xloc=xloc.bar_index)
var label lbAtrDn = label.new(na, na, "", xloc=xloc.bar_index)
var label lbOnHi = label.new(na, na, "", xloc=xloc.bar_index)
var label lbOnLo = label.new(na, na, "", xloc=xloc.bar_index)
var label lbPmHi = label.new(na, na, "", xloc=xloc.bar_index)
var label lbPmLo = label.new(na, na, "", xloc=xloc.bar_index)

if barstate.islast and showLabels
    f_tag(lbAnchor, f_at(0.0), "PDC " + str.tostring(f_at(0.0), format.mintick),
         color.white)
    f_tag(lbTrigUp, lvlTrigUp, "Call trig " +
         str.tostring(lvlTrigUp, format.mintick), color.aqua)
    f_tag(lbTrigDn, lvlTrigDn, "Put trig " +
         str.tostring(lvlTrigDn, format.mintick), color.yellow)
    f_tag(lbAtrUp, f_at(1.0), "+1 ATR " +
         str.tostring(f_at(1.0), format.mintick), color.white)
    f_tag(lbAtrDn, f_at(-1.0), "-1 ATR " +
         str.tostring(f_at(-1.0), format.mintick), color.white)
    f_tag(lbOnHi, showOvernight ? onHigh : na, "夜盘高 " +
         str.tostring(onHigh, format.mintick), color.purple)
    f_tag(lbOnLo, showOvernight ? onLow : na, "夜盘低 " +
         str.tostring(onLow, format.mintick), color.purple)
    f_tag(lbPmHi, showPremarket ? pmHigh : na, "盘前高 " +
         str.tostring(pmHigh, format.mintick), color.orange)
    f_tag(lbPmLo, showPremarket ? pmLow : na, "盘前低 " +
         str.tostring(pmLow, format.mintick), color.orange)

// ── Reconciliation table ──────────────────────────────────────────────────
// Mirrors the official indicator's own table so the two can be compared at a
// glance.  If these two rows disagree, this script is wrong — not the market.
var table tbl = table.new(position.top_right, 2, 5,
     border_width=1, frame_width=1, frame_color=color.new(color.gray, 60))

float periodRange = periodHigh - periodLow
float rangePct = atrVal > 0 ? periodRange / atrVal * 100 : na
float posRatio = atrVal > 0 ? (close - anchor) / atrVal : na

if barstate.islast and showTable
    table.cell(tbl, 0, 0, "IDM v14 Map", text_color=color.white,
         bgcolor=color.new(color.blue, 60), text_size=size.small)
    table.cell(tbl, 1, 0, atrMode, text_color=color.white,
         bgcolor=color.new(color.blue, 60), text_size=size.small)
    table.cell(tbl, 0, 1, "ATR(" + str.tostring(atrLen) + ")",
         text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 1, str.tostring(atrVal, "#.##"),
         text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 2, "锚 PDC", text_color=color.silver,
         text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(anchor, format.mintick),
         text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 3, "本周期区间/ATR", text_color=color.silver,
         text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(periodRange, "#.##") + " (" +
         str.tostring(rangePct, "#.#") + "%)", text_color=color.white,
         text_size=size.small)
    table.cell(tbl, 0, 4, "现价位置", text_color=color.silver,
         text_size=size.small)
    table.cell(tbl, 1, 4, (posRatio >= 0 ? "+" : "") +
         str.tostring(posRatio, "#.###") + " ATR",
         text_color=posRatio >= 0 ? color.aqua : color.yellow,
         text_size=size.small)

// ── Data-window audit fields (for machine verification) ───────────────────
plot(anchor, "audit: anchor", color=na, display=display.data_window)
plot(atrVal, "audit: atr", color=na, display=display.data_window)
plot(posRatio, "audit: position in ATR", color=na, display=display.data_window)
plot(onHigh, "audit: overnight high", color=na, display=display.data_window)
plot(onLow, "audit: overnight low", color=na, display=display.data_window)
plot(pmHigh, "audit: premarket high", color=na, display=display.data_window)
plot(pmLow, "audit: premarket low", color=na, display=display.data_window)
