f_role_code(string roleText) => roleText == ROLE_SUPPORT_TEXT ? ROLE_SUPPORT : roleText == ROLE_RESISTANCE_TEXT ? ROLE_RESISTANCE : ROLE_NONE
f_identity_component_ok(string value) =>
    int componentLength = str.length(value)
    bool componentOk = componentLength >= 1 and componentLength <= IDENTITY_COMPONENT_MAX_LENGTH and value == str.trim(value)
    if componentOk
        string firstCharacter = str.substring(value, 0, 1)
        string lastCharacter = str.substring(value, componentLength - 1, componentLength)
        componentOk := str.contains(IDENTITY_ASCII_ALNUM, firstCharacter) and str.contains(IDENTITY_ASCII_ALNUM, lastCharacter)
    if componentOk
        for characterIndex = 0 to componentLength - 1
            string character = str.substring(value, characterIndex, characterIndex + 1)
            if not str.contains(IDENTITY_COMPONENT_SAFE_CHARS, character)
                componentOk := false
    componentOk
f_canonical_identity_component(string value) => f_identity_component_ok(value) ? value : ""
f_identity_ok(string sourceId, string sourceVersion) => f_identity_component_ok(sourceId) and f_identity_component_ok(sourceVersion)
f_identity_key(string sourceId, string sourceVersion) => f_identity_ok(sourceId, sourceVersion) ? IDENTITY_ENCODING_VERSION + ":" + sourceId + "@" + sourceVersion : ""
f_band_kind_allowed(string sourceKind) => str.trim(sourceKind) == SOURCE_KIND_SATY_ATR_MAP_LEVEL
f_atr_kind_allowed(string sourceKind) => str.trim(sourceKind) == SOURCE_KIND_PREVIOUS_COMPLETED_DAILY_ATR
f_absolute_window_ok(int publishedAt, int knownAt, int validUntil, int barOpen) => publishedAt > 0 and knownAt > 0 and validUntil > 0 and publishedAt <= barOpen and knownAt <= barOpen and barOpen < validUntil and publishedAt < validUntil and knownAt < validUntil
f_fresh(int publishedAt, int knownAt, int staleMs, int barOpen) => publishedAt > 0 and knownAt > 0 and publishedAt <= barOpen and knownAt <= barOpen and barOpen - math.max(publishedAt, knownAt) <= staleMs
f_band_valid(bool enabled, int role, float lower, float upper, string sourceKind, string sourceId, string sourceVersion, int publishedAt, int knownAt, int validUntil, string stability, int staleMs, int barOpen) => enabled and role != ROLE_NONE and not na(lower) and not na(upper) and lower <= upper and f_band_kind_allowed(sourceKind) and f_identity_ok(sourceId, sourceVersion) and stability == STABILITY_PRIOR and f_absolute_window_ok(publishedAt, knownAt, validUntil, barOpen) and f_fresh(publishedAt, knownAt, staleMs, barOpen)
f_atr_source_bar_ok(string sourceTimeframe, int sourceOpen, int sourceClose, int knownAt, int barOpen) => str.trim(sourceTimeframe) == DAILY_TIMEFRAME and sourceOpen > 0 and sourceClose > sourceOpen and sourceClose <= knownAt and knownAt <= barOpen
f_atr_valid(bool enabled, float atrValue, string sourceKind, string sourceId, string sourceVersion, int publishedAt, int knownAt, int validUntil, string sourceTimeframe, int sourceOpen, int sourceClose, string stability, int staleMs, int barOpen) => enabled and not na(atrValue) and atrValue > 0 and f_atr_kind_allowed(sourceKind) and f_identity_ok(sourceId, sourceVersion) and stability == STABILITY_PRIOR and f_absolute_window_ok(publishedAt, knownAt, validUntil, barOpen) and f_fresh(publishedAt, knownAt, staleMs, barOpen) and f_atr_source_bar_ok(sourceTimeframe, sourceOpen, sourceClose, knownAt, barOpen)
f_scaled(float value) => str.tostring(int(math.round(value * EFFECTIVE_NUMBER_SCALE)))
f_band_effective_key(string sourceKind, string identityKey, int role, float lower, float upper, int publishedAt, int knownAt, int validUntil) => IDENTITY_ENCODING_VERSION + "|B|" + str.trim(sourceKind) + "|" + identityKey + "|" + (role == ROLE_SUPPORT ? ROLE_SUPPORT_TEXT : role == ROLE_RESISTANCE ? ROLE_RESISTANCE_TEXT : ROLE_DISABLED_TEXT) + "|" + f_scaled(lower) + "|" + f_scaled(upper) + "|" + str.tostring(publishedAt) + "|" + str.tostring(knownAt) + "|" + str.tostring(validUntil)
f_atr_effective_key(string sourceKind, string identityKey, float atrValue, int publishedAt, int knownAt, int validUntil, string sourceTimeframe, int sourceOpen, int sourceClose) => IDENTITY_ENCODING_VERSION + "|A|" + str.trim(sourceKind) + "|" + identityKey + "|" + f_scaled(atrValue) + "|" + str.tostring(publishedAt) + "|" + str.tostring(knownAt) + "|" + str.tostring(validUntil) + "|" + str.trim(sourceTimeframe) + "|" + str.tostring(sourceOpen) + "|" + str.tostring(sourceClose)
f_price(float value) => na(value) ? "—" : str.tostring(value, format.mintick)
f_time(int value) => na(value) ? "—" : str.format_time(value, "MM-dd HH:mm", "America/New_York") + " ET"
f_state_text(int state) => state == ST_APPROACH ? "位置观察" : state == ST_READY ? "10m 反应 READY" : state == ST_FAILED ? "本 episode 已失败" : state == ST_EXPIRED ? "本 episode 已到期" : state == ST_DISABLED ? "来源禁用" : "等待位置"
f_reason_text(int reason) => reason == RS_READY ? "空间 ≥ 1R｜机会已冻结" : reason == RS_ACCEPTED_BREAK ? "accepted break｜不倒填" : reason == RS_TARGET_MISSING ? "无 prior-known opposite target" : reason == RS_TARGET_CONSUMED ? "最近目标本 episode 已触及｜不跳远" : reason == RS_RISK_INVALID ? "冻结风险/收益无效" : reason == RS_SPACE_LT_1R ? "最近目标空间 < 1R" : reason == RS_REACTION_EXPIRED ? "第三根仍无 confirmed 反应" : reason == RS_WAIT_CLEAR_REQUIRED ? "等待完整离位 0.12 ATR" : reason == RS_WAIT_CLEAR_COMPLETED ? "完整离位完成｜下一 K 才可新建" : reason == RS_POSITION_CONFLICT ? "同 K 支撑/阻力冲突" : reason == RS_MULTIPLE_SAME_SIDE ? "同向多位置同时触及｜NO_PERMISSION" : reason == RS_DATA_RESET ? "host/source/gap fail closed" : reason == RS_WATCH_ONLY ? "仅观察｜未授权" : "等待 prior-known 位置"
f_surface_reason_text(int surfaceReason) => surfaceReason == SURFACE_SYMBOL ? "仅支持 CAPITALCOM:SPX500" : surfaceReason == SURFACE_TIMEFRAME ? "仅支持原生 10m" : surfaceReason == SURFACE_NON_STANDARD ? "仅支持标准 K 线" : surfaceReason == SURFACE_PARAMS ? "冻结参数合同无效" : surfaceReason == SURFACE_ATR_DISABLED ? "SATy/ATR 来源未启用" : surfaceReason == SURFACE_ATR_UNKNOWN ? "SATy/ATR 来源未知" : surfaceReason == SURFACE_ATR_EXPIRED ? "SATy/ATR 来源已过期" : surfaceReason == SURFACE_ATR_CONTRACT ? "ATR 上一完成日合同无效" : surfaceReason == SURFACE_BAND_DISABLED ? "SATy/ATR 来源未启用" : surfaceReason == SURFACE_BAND_UNKNOWN ? "SATy/ATR 来源未知" : surfaceReason == SURFACE_BAND_EXPIRED ? "SATy/ATR 来源已过期" : surfaceReason == SURFACE_DUPLICATE_IDENTITY ? "SATy 来源 identity 重复" : surfaceReason == SURFACE_BAND_CONTRACT ? "SATy 具名位合同无效" : "来源可用"
f_plan_gate(int side, float barHigh, float barLow, float episodeHigh, float episodeLow, float atrValue, bool targetPresent, float targetPrice) =>
    float trigger = side == ROLE_SUPPORT ? barHigh : barLow
    float buffer = math.max(2.0 * MINIMUM_TICK, STOP_BUFFER_ATR * atrValue)
    float invalidation = side == ROLE_SUPPORT ? episodeLow - buffer : episodeHigh + buffer
    float risk = side == ROLE_SUPPORT ? trigger - invalidation : invalidation - trigger
    bool targetConsumed = targetPresent and (side == ROLE_SUPPORT ? episodeHigh >= targetPrice : episodeLow <= targetPrice)
    float reward = targetPresent ? (side == ROLE_SUPPORT ? targetPrice - trigger : trigger - targetPrice) : na
    float spaceR = not na(reward) and risk > 0 ? reward / risk : na
    int outState = not targetPresent ? ST_FAILED : targetConsumed ? ST_FAILED : risk <= 0 or na(reward) or reward <= 0 ? ST_FAILED : spaceR < MINIMUM_SPACE_R ? ST_FAILED : ST_READY
    int outReason = not targetPresent ? RS_TARGET_MISSING : targetConsumed ? RS_TARGET_CONSUMED : risk <= 0 or na(reward) or reward <= 0 ? RS_RISK_INVALID : spaceR < MINIMUM_SPACE_R ? RS_SPACE_LT_1R : RS_READY
    [outState, outReason, trigger, invalidation, risk, reward, spaceR]

int staleMs = DEFAULT_STALE_AFTER_MS
bool symbolOk = ticker.standard(syminfo.tickerid) == EXPECTED_SYMBOL
bool timeframeOk = timeframe.period == "10"
bool standardChartOk = chart.is_standard
bool paramsOk = MAX_REACTION_BARS == 3 and MINIMUM_SPACE_R == 1.0 and STOP_BUFFER_ATR == 0.002 and REARM_ATR == 0.12 and OPPORTUNITY_LIFETIME_BARS == 12 and DEFAULT_STALE_AFTER_MS == 129600000 and MINIMUM_TICK == 0.1 and EFFECTIVE_NUMBER_SCALE == 10000000000 and IDENTITY_ENCODING_VERSION == "CID1" and IDENTITY_COMPONENT_MAX_LENGTH == 64
bool atrKindOk = f_atr_kind_allowed(atrSourceKindInput)
bool atrExpired = atrEnabled and atrValidUntilInput > 0 and time >= atrValidUntilInput
bool atrValid = f_atr_valid(atrEnabled, atrInput, atrSourceKindInput, atrSourceIdInput, atrSourceVersionInput, atrPublishedAtInput, atrKnownAtInput, atrValidUntilInput, atrSourceTimeframeInput, atrCompletedSourceOpenInput, atrCompletedSourceCloseInput, atrStabilityInput, staleMs, time)
string atrCanonicalSourceId = f_canonical_identity_component(atrSourceIdInput)
string atrCanonicalSourceVersion = f_canonical_identity_component(atrSourceVersionInput)
string atrIdentityKey = f_identity_key(atrSourceIdInput, atrSourceVersionInput)
string atrEffectiveKey = atrValid ? f_atr_effective_key(atrSourceKindInput, atrIdentityKey, atrInput, atrPublishedAtInput, atrKnownAtInput, atrValidUntilInput, atrSourceTimeframeInput, atrCompletedSourceOpenInput, atrCompletedSourceCloseInput) : ""

array<bool> bandEnabled = array.from(l1Enabled, l2Enabled, l3Enabled, l4Enabled)
array<string> bandSourceKind = array.from(l1SourceKind, l2SourceKind, l3SourceKind, l4SourceKind)
array<int> bandRole = array.from(f_role_code(l1RoleText), f_role_code(l2RoleText), f_role_code(l3RoleText), f_role_code(l4RoleText))
array<float> bandLower = array.from(l1Lower, l2Lower, l3Lower, l4Lower)
array<float> bandUpper = array.from(l1Upper, l2Upper, l3Upper, l4Upper)
array<string> bandSourceId = array.from(l1SourceId, l2SourceId, l3SourceId, l4SourceId)
array<string> bandSourceVersion = array.from(l1SourceVersion, l2SourceVersion, l3SourceVersion, l4SourceVersion)
array<int> bandPublishedAt = array.from(l1PublishedAt, l2PublishedAt, l3PublishedAt, l4PublishedAt)
array<int> bandKnownAt = array.from(l1KnownAt, l2KnownAt, l3KnownAt, l4KnownAt)
array<int> bandValidUntil = array.from(l1ValidUntil, l2ValidUntil, l3ValidUntil, l4ValidUntil)
array<string> bandStability = array.from(l1Stability, l2Stability, l3Stability, l4Stability)
array<bool> bandValid = array.new_bool(4, false)
array<string> bandCanonicalSourceId = array.new_string(4, "")
array<string> bandCanonicalSourceVersion = array.new_string(4, "")
array<string> bandIdentityKey = array.new_string(4, "")
array<string> bandEffectiveKey = array.new_string(4, "")
int enabledBandCount = 0
int validBandCount = 0
int earliestBandValidUntil = na
bool anyBandUnknownKind = false
bool anyBandExpired = false
bool anyBandInvalidExpiry = false
bool anyBandIdentityInvalid = false
bool anyBandContractInvalid = false
for i = 0 to 3
    bool itemEnabled = array.get(bandEnabled, i)
    string itemKind = array.get(bandSourceKind, i)
    int itemRole = array.get(bandRole, i)
    float itemLower = array.get(bandLower, i)
    float itemUpper = array.get(bandUpper, i)
    string itemSourceId = array.get(bandSourceId, i)
    string itemSourceVersion = array.get(bandSourceVersion, i)
    int itemPublishedAt = array.get(bandPublishedAt, i)
    int itemKnownAt = array.get(bandKnownAt, i)
    int itemValidUntil = array.get(bandValidUntil, i)
    string itemStability = array.get(bandStability, i)
    bool itemKindOk = f_band_kind_allowed(itemKind)
    bool itemIdentityOk = f_identity_ok(itemSourceId, itemSourceVersion)
    bool itemExpired = itemEnabled and itemValidUntil > 0 and time >= itemValidUntil
    bool itemInvalidExpiry = itemEnabled and (itemValidUntil <= 0 or (itemPublishedAt > 0 and itemPublishedAt >= itemValidUntil) or (itemKnownAt > 0 and itemKnownAt >= itemValidUntil))
    bool itemValid = f_band_valid(itemEnabled, itemRole, itemLower, itemUpper, itemKind, itemSourceId, itemSourceVersion, itemPublishedAt, itemKnownAt, itemValidUntil, itemStability, staleMs, time)
    string itemCanonicalSourceId = f_canonical_identity_component(itemSourceId)
    string itemCanonicalSourceVersion = f_canonical_identity_component(itemSourceVersion)
    string itemIdentityKey = f_identity_key(itemSourceId, itemSourceVersion)
    string itemEffectiveKey = itemValid ? f_band_effective_key(itemKind, itemIdentityKey, itemRole, itemLower, itemUpper, itemPublishedAt, itemKnownAt, itemValidUntil) : ""
    array.set(bandValid, i, itemValid)
    array.set(bandCanonicalSourceId, i, itemCanonicalSourceId)
    array.set(bandCanonicalSourceVersion, i, itemCanonicalSourceVersion)
    array.set(bandIdentityKey, i, itemIdentityKey)
    array.set(bandEffectiveKey, i, itemEffectiveKey)
    enabledBandCount += itemEnabled ? 1 : 0
    validBandCount += itemValid ? 1 : 0
    earliestBandValidUntil := itemValid ? (na(earliestBandValidUntil) ? itemValidUntil : math.min(earliestBandValidUntil, itemValidUntil)) : earliestBandValidUntil
    anyBandUnknownKind := anyBandUnknownKind or (itemEnabled and not itemKindOk)
    anyBandExpired := anyBandExpired or itemExpired
    anyBandInvalidExpiry := anyBandInvalidExpiry or itemInvalidExpiry
    anyBandIdentityInvalid := anyBandIdentityInvalid or (itemEnabled and not itemIdentityOk)
    anyBandContractInvalid := anyBandContractInvalid or (itemEnabled and itemKindOk and not itemExpired and not itemInvalidExpiry and not itemValid)
bool duplicateIdentityConflict = false
for i = 0 to 3
    if array.get(bandValid, i)
        for j = 0 to 3
            if j > i and array.get(bandValid, j) and array.get(bandIdentityKey, i) == array.get(bandIdentityKey, j)
                duplicateIdentityConflict := true
int sourceSurfaceReason = not symbolOk ? SURFACE_SYMBOL : not timeframeOk ? SURFACE_TIMEFRAME : not standardChartOk ? SURFACE_NON_STANDARD : not paramsOk ? SURFACE_PARAMS : not atrEnabled ? SURFACE_ATR_DISABLED : not atrKindOk ? SURFACE_ATR_UNKNOWN : atrExpired ? SURFACE_ATR_EXPIRED : not atrValid ? SURFACE_ATR_CONTRACT : enabledBandCount == 0 ? SURFACE_BAND_DISABLED : anyBandUnknownKind ? SURFACE_BAND_UNKNOWN : anyBandExpired ? SURFACE_BAND_EXPIRED : anyBandInvalidExpiry ? SURFACE_BAND_CONTRACT : anyBandIdentityInvalid ? SURFACE_BAND_CONTRACT : duplicateIdentityConflict ? SURFACE_DUPLICATE_IDENTITY : validBandCount == 0 ? SURFACE_BAND_CONTRACT : SURFACE_OK
bool sourceSurfaceOk = sourceSurfaceReason == SURFACE_OK
bool outwardSurfaceOk = sourceSurfaceOk and barstate.isconfirmed

var int st = ST_WAIT_CLEAR
var bool needsClear = false
var int side = ROLE_NONE
var string episodeId = ""
var string episodeSourceKind = ""
var string episodeSourceId = ""
var string episodeSourceVersion = ""
var string episodeSourceIdentityKey = ""
var string episodeSourceEffectiveKey = ""
var int episodeValidUntil = na
var float frozenLower = na
var float frozenUpper = na
var float frozenAtr = na
var string frozenAtrSourceKind = ""
var string frozenAtrSourceId = ""
var string frozenAtrSourceVersion = ""
var string frozenAtrIdentityKey = ""
var string frozenAtrEffectiveKey = ""
var int frozenAtrValidUntil = na
var float episodeLow = na
var float episodeHigh = na
var int reactionBarsSeen = 0
var bool watchRegistered = false
var bool terminalRegistered = false
var bool frozenTargetPresent = false
var float frozenTargetPrice = na
var string frozenTargetSourceKind = ""
var string frozenTargetSourceId = ""
var string frozenTargetSourceVersion = ""
var string frozenTargetIdentityKey = ""
var string frozenTargetEffectiveKey = ""
var int frozenTargetValidUntil = na
var int frozenTargetOrder = na
var int lastConfirmedTime = na
var int lastEvent = EV_NONE
var int lastReason = RS_IDLE
var int lastEventTime = na
var float lastMarkerPrice = na
var bool latestPlanPublished = false
var bool latestPlanSuppressed = false
var string latestOpportunityId = ""
var string latestEpisodeId = ""
var int latestDirection = ROLE_NONE
var float latestTrigger = na
var float latestInvalidation = na
var float latestTarget = na
var string latestTargetSource = ""
var int latestConfirmationTime = na
var int latestVisibleAt = na
var int latestExpiresAt = na
var float latestRisk = na
var float latestReward = na
var float latestSpaceR = na

int ev = EV_NONE
int reason = RS_IDLE
float markerPrice = na
bool sourceContextOk = true
if st == ST_APPROACH
    bool activeSourcePresent = false
    bool activeTargetPresent = not frozenTargetPresent
    for i = 0 to 3
        if array.get(bandValid, i)
            bool sameSource = array.get(bandEffectiveKey, i) == episodeSourceEffectiveKey
            bool sameTarget = frozenTargetPresent and array.get(bandEffectiveKey, i) == frozenTargetEffectiveKey
            activeSourcePresent := activeSourcePresent or sameSource
            activeTargetPresent := activeTargetPresent or sameTarget
    bool activeAtrSame = atrEffectiveKey == frozenAtrEffectiveKey
    sourceContextOk := activeSourcePresent and activeTargetPresent and activeAtrSame

if barstate.isconfirmed
    bool gapReset = not na(lastConfirmedTime) and time - lastConfirmedTime != BAR_INTERVAL_MS
    if not sourceSurfaceOk or gapReset or not sourceContextOk
        st := ST_DISABLED
        needsClear := false
        side := ROLE_NONE
        episodeId := ""
        episodeSourceKind := ""
        episodeSourceId := ""
        episodeSourceVersion := ""
        episodeSourceIdentityKey := ""
        episodeSourceEffectiveKey := ""
        episodeValidUntil := na
        frozenLower := na
        frozenUpper := na
        frozenAtr := na
        frozenAtrSourceKind := ""
        frozenAtrSourceId := ""
        frozenAtrSourceVersion := ""
        frozenAtrIdentityKey := ""
        frozenAtrEffectiveKey := ""
        frozenAtrValidUntil := na
        episodeLow := na
        episodeHigh := na
        reactionBarsSeen := 0
        watchRegistered := false
        terminalRegistered := false
        frozenTargetPresent := false
        frozenTargetPrice := na
        frozenTargetSourceKind := ""
        frozenTargetSourceId := ""
        frozenTargetSourceVersion := ""
        frozenTargetIdentityKey := ""
        frozenTargetEffectiveKey := ""
        frozenTargetValidUntil := na
        frozenTargetOrder := na
        latestPlanSuppressed := true
        ev := EV_DATA_RESET
        reason := RS_DATA_RESET
    else
        // A source/gap reset consumes only the reset bar.  On the first later
        // confirmed, contiguous, source-valid bar, restore WAIT_CLEAR and
        // evaluate that same bar instead of discarding one extra eligible K.
        if st == ST_DISABLED
            st := ST_WAIT_CLEAR
            reason := RS_IDLE
        if st == ST_READY or st == ST_FAILED or st == ST_EXPIRED
            st := ST_WAIT_CLEAR
        if needsClear
            float clearDistance = REARM_ATR * frozenAtr
            bool fullClear = side == ROLE_SUPPORT ? low > frozenUpper and close >= frozenUpper + clearDistance : side == ROLE_RESISTANCE ? high < frozenLower and close <= frozenLower - clearDistance : (low > frozenUpper and close >= frozenUpper + clearDistance) or (high < frozenLower and close <= frozenLower - clearDistance)
            if fullClear
                ev := EV_WAIT_CLEAR_COMPLETED
                reason := RS_WAIT_CLEAR_COMPLETED
                needsClear := false
                side := ROLE_NONE
                episodeId := ""
                episodeSourceKind := ""
                episodeSourceId := ""
                episodeSourceVersion := ""
                episodeSourceIdentityKey := ""
                episodeSourceEffectiveKey := ""
                episodeValidUntil := na
                frozenLower := na
                frozenUpper := na
                frozenAtr := na
                frozenAtrSourceKind := ""
                frozenAtrSourceId := ""
                frozenAtrSourceVersion := ""
                frozenAtrIdentityKey := ""
                frozenAtrEffectiveKey := ""
                frozenAtrValidUntil := na
                episodeLow := na
                episodeHigh := na
                reactionBarsSeen := 0
                watchRegistered := false
                terminalRegistered := false
                frozenTargetPresent := false
                frozenTargetPrice := na
                frozenTargetSourceKind := ""
                frozenTargetSourceId := ""
                frozenTargetSourceVersion := ""
                frozenTargetIdentityKey := ""
                frozenTargetEffectiveKey := ""
                frozenTargetValidUntil := na
                frozenTargetOrder := na
            else
                reason := RS_WAIT_CLEAR_REQUIRED
        else if st == ST_APPROACH
            reactionBarsSeen += 1
            episodeLow := math.min(episodeLow, low)
            episodeHigh := math.max(episodeHigh, high)
            bool acceptedBreak = side == ROLE_SUPPORT ? close < frozenLower : close > frozenUpper
            bool confirmedReaction = side == ROLE_SUPPORT ? close > frozenUpper : close < frozenLower
            if acceptedBreak
                st := ST_FAILED
                terminalRegistered := true
                needsClear := true
                ev := EV_ACCEPTED_BREAK
                reason := RS_ACCEPTED_BREAK
            else if confirmedReaction
                st := ST_REACTION
                [planState, planReason, trigger, invalidation, risk, reward, spaceR] = f_plan_gate(side, high, low, episodeHigh, episodeLow, frozenAtr, frozenTargetPresent, frozenTargetPrice)
                st := planState
                terminalRegistered := true
                needsClear := true
                ev := side == ROLE_SUPPORT ? EV_BOUNCE_CONFIRMED : EV_REJECTION_CONFIRMED
                reason := planReason
                markerPrice := close
                if planState == ST_READY
                    latestPlanPublished := true
                    latestPlanSuppressed := false
                    latestOpportunityId := "PR-OP-" + (side == ROLE_SUPPORT ? "L-" : "S-") + episodeSourceIdentityKey + "#" + episodeSourceEffectiveKey + "|" + frozenTargetEffectiveKey + "|" + frozenAtrEffectiveKey + "-" + str.tostring(time)
                    latestEpisodeId := episodeId
                    latestDirection := side
                    latestTrigger := trigger
                    latestInvalidation := invalidation
                    latestTarget := frozenTargetPrice
                    latestTargetSource := frozenTargetIdentityKey
                    latestConfirmationTime := time
                    latestVisibleAt := time_close
                    latestExpiresAt := time_close + OPPORTUNITY_LIFETIME_BARS * BAR_INTERVAL_MS
                    latestRisk := risk
                    latestReward := reward
                    latestSpaceR := spaceR
            else if reactionBarsSeen >= MAX_REACTION_BARS
                st := ST_EXPIRED
                terminalRegistered := true
                needsClear := true
                ev := EV_REACTION_EXPIRED
                reason := RS_REACTION_EXPIRED
            else
                reason := RS_WATCH_ONLY
        else if st == ST_WAIT_CLEAR
            int touchedCount = 0
            int touchedSupportCount = 0
            int touchedResistanceCount = 0
            int touchedIndex = na
            float touchedUnionLower = na
            float touchedUnionUpper = na
            string touchedEffectiveMaterial = ""
            for i = 0 to 3
                if array.get(bandValid, i)
                    int itemRole = array.get(bandRole, i)
                    float itemLower = array.get(bandLower, i)
                    float itemUpper = array.get(bandUpper, i)
                    bool touched = itemRole == ROLE_SUPPORT ? low <= itemUpper : high >= itemLower
                    if touched
                        touchedCount += 1
                        touchedSupportCount += itemRole == ROLE_SUPPORT ? 1 : 0
                        touchedResistanceCount += itemRole == ROLE_RESISTANCE ? 1 : 0
                        touchedIndex := i
                        touchedUnionLower := na(touchedUnionLower) ? itemLower : math.min(touchedUnionLower, itemLower)
                        touchedUnionUpper := na(touchedUnionUpper) ? itemUpper : math.max(touchedUnionUpper, itemUpper)
                        touchedEffectiveMaterial += (str.length(touchedEffectiveMaterial) > 0 ? "|" : "") + array.get(bandEffectiveKey, i)
            if touchedCount > 1
                bool multipleSameSide = touchedSupportCount == 0 or touchedResistanceCount == 0
                side := multipleSameSide ? (touchedSupportCount > 0 ? ROLE_SUPPORT : ROLE_RESISTANCE) : ROLE_NONE
                episodeId := (multipleSameSide ? "PR-MULTIPLE-SAME-SIDE-" : "PR-CONFLICT-") + str.tostring(time) + "#" + touchedEffectiveMaterial + "|" + atrEffectiveKey
                frozenLower := touchedUnionLower
                frozenUpper := touchedUnionUpper
                frozenAtr := atrInput
                frozenAtrSourceKind := atrSourceKindInput
                frozenAtrSourceId := atrCanonicalSourceId
                frozenAtrSourceVersion := atrCanonicalSourceVersion
                frozenAtrIdentityKey := atrIdentityKey
                frozenAtrEffectiveKey := atrEffectiveKey
                frozenAtrValidUntil := atrValidUntilInput
                episodeLow := low
                episodeHigh := high
                terminalRegistered := true
                watchRegistered := false
                st := ST_FAILED
                needsClear := true
                ev := multipleSameSide ? EV_MULTIPLE_SAME_SIDE : EV_POSITION_CONFLICT
                reason := multipleSameSide ? RS_MULTIPLE_SAME_SIDE : RS_POSITION_CONFLICT
            else if touchedCount == 1
                side := array.get(bandRole, touchedIndex)
                episodeSourceKind := array.get(bandSourceKind, touchedIndex)
                episodeSourceId := array.get(bandCanonicalSourceId, touchedIndex)
                episodeSourceVersion := array.get(bandCanonicalSourceVersion, touchedIndex)
                episodeSourceIdentityKey := array.get(bandIdentityKey, touchedIndex)
                episodeSourceEffectiveKey := array.get(bandEffectiveKey, touchedIndex)
                episodeValidUntil := array.get(bandValidUntil, touchedIndex)
                episodeId := "PR-EP-" + (side == ROLE_SUPPORT ? "L-" : "S-") + episodeSourceIdentityKey + "#" + episodeSourceEffectiveKey + "-" + str.tostring(time)
                frozenLower := array.get(bandLower, touchedIndex)
                frozenUpper := array.get(bandUpper, touchedIndex)
                frozenAtr := atrInput
                frozenAtrSourceKind := atrSourceKindInput
                frozenAtrSourceId := atrCanonicalSourceId
                frozenAtrSourceVersion := atrCanonicalSourceVersion
                frozenAtrIdentityKey := atrIdentityKey
                frozenAtrEffectiveKey := atrEffectiveKey
                frozenAtrValidUntil := atrValidUntilInput
                episodeLow := low
                episodeHigh := high
                reactionBarsSeen := 1
                watchRegistered := true
                terminalRegistered := false
                frozenTargetPresent := false
                frozenTargetPrice := na
                frozenTargetSourceKind := ""
                frozenTargetSourceId := ""
                frozenTargetSourceVersion := ""
                frozenTargetIdentityKey := ""
                frozenTargetEffectiveKey := ""
                frozenTargetValidUntil := na
                frozenTargetOrder := na
                for i = 0 to 3
                    if array.get(bandValid, i) and array.get(bandRole, i) == -side
                        float candidatePrice = side == ROLE_SUPPORT ? array.get(bandLower, i) : array.get(bandUpper, i)
                        bool ahead = side == ROLE_SUPPORT ? candidatePrice > high : candidatePrice < low
                        bool better = not frozenTargetPresent or (side == ROLE_SUPPORT ? candidatePrice < frozenTargetPrice : candidatePrice > frozenTargetPrice) or (candidatePrice == frozenTargetPrice and i < frozenTargetOrder)
                        if ahead and better
                            frozenTargetPresent := true
                            frozenTargetPrice := candidatePrice
                            frozenTargetSourceKind := array.get(bandSourceKind, i)
                            frozenTargetSourceId := array.get(bandCanonicalSourceId, i)
                            frozenTargetSourceVersion := array.get(bandCanonicalSourceVersion, i)
                            frozenTargetIdentityKey := array.get(bandIdentityKey, i)
                            frozenTargetEffectiveKey := array.get(bandEffectiveKey, i)
                            frozenTargetValidUntil := array.get(bandValidUntil, i)
                            frozenTargetOrder := i
                st := ST_APPROACH
                bool acceptedBreak = side == ROLE_SUPPORT ? close < frozenLower : close > frozenUpper
                bool confirmedReaction = side == ROLE_SUPPORT ? close > frozenUpper : close < frozenLower
                if acceptedBreak
                    st := ST_FAILED
                    terminalRegistered := true
                    needsClear := true
                    ev := EV_ACCEPTED_BREAK
                    reason := RS_ACCEPTED_BREAK
                else if confirmedReaction
                    st := ST_REACTION
                    [planState, planReason, trigger, invalidation, risk, reward, spaceR] = f_plan_gate(side, high, low, episodeHigh, episodeLow, frozenAtr, frozenTargetPresent, frozenTargetPrice)
                    st := planState
                    terminalRegistered := true
                    needsClear := true
                    ev := side == ROLE_SUPPORT ? EV_BOUNCE_CONFIRMED : EV_REJECTION_CONFIRMED
                    reason := planReason
                    markerPrice := close
                    if planState == ST_READY
                        latestPlanPublished := true
                        latestPlanSuppressed := false
                        latestOpportunityId := "PR-OP-" + (side == ROLE_SUPPORT ? "L-" : "S-") + episodeSourceIdentityKey + "#" + episodeSourceEffectiveKey + "|" + frozenTargetEffectiveKey + "|" + frozenAtrEffectiveKey + "-" + str.tostring(time)
                        latestEpisodeId := episodeId
                        latestDirection := side
                        latestTrigger := trigger
                        latestInvalidation := invalidation
                        latestTarget := frozenTargetPrice
                        latestTargetSource := frozenTargetIdentityKey
                        latestConfirmationTime := time
                        latestVisibleAt := time_close
                        latestExpiresAt := time_close + OPPORTUNITY_LIFETIME_BARS * BAR_INTERVAL_MS
                        latestRisk := risk
                        latestReward := reward
                        latestSpaceR := spaceR
                else
                    ev := side == ROLE_SUPPORT ? EV_SUPPORT_WATCH : EV_RESISTANCE_WATCH
                    reason := RS_WATCH_ONLY
                    markerPrice := side == ROLE_SUPPORT ? low : high
    if ev != EV_NONE
        lastEvent := ev
        lastReason := reason
        lastEventTime := time
        lastMarkerPrice := markerPrice
    lastConfirmedTime := time

bool latestPlanFresh = latestPlanPublished and not latestPlanSuppressed and not na(latestExpiresAt) and time < latestExpiresAt
bool supportWatchPulse = ev == EV_SUPPORT_WATCH
bool bouncePulse = ev == EV_BOUNCE_CONFIRMED
bool resistanceWatchPulse = ev == EV_RESISTANCE_WATCH
bool rejectionPulse = ev == EV_REJECTION_CONFIRMED
plotshape(outwardSurfaceOk and showMarkers and supportWatchPulse ? markerPrice : na, title="位置反转 支撑观察", text="支撑观察", style=shape.triangleup, location=location.absolute, color=color.rgb(255, 193, 7), textcolor=color.black, size=size.tiny)
plotshape(outwardSurfaceOk and showMarkers and bouncePulse ? markerPrice : na, title="位置反转 反弹确认", text="反弹确认", style=shape.labelup, location=location.absolute, color=color.rgb(0, 145, 95), textcolor=color.white, size=size.small)
plotshape(outwardSurfaceOk and showMarkers and resistanceWatchPulse ? markerPrice : na, title="位置反转 阻力观察", text="阻力观察", style=shape.triangledown, location=location.absolute, color=color.rgb(255, 152, 0), textcolor=color.black, size=size.tiny)
plotshape(outwardSurfaceOk and showMarkers and rejectionPulse ? markerPrice : na, title="位置反转 压回确认", text="压回确认", style=shape.labeldown, location=location.absolute, color=color.rgb(171, 71, 188), textcolor=color.white, size=size.small)

string conclusionText = not sourceSurfaceOk ? f_surface_reason_text(sourceSurfaceReason) : ev == EV_BOUNCE_CONFIRMED ? (reason == RS_READY ? "反弹确认｜READY" : "反弹确认｜不授权") : ev == EV_REJECTION_CONFIRMED ? (reason == RS_READY ? "压回确认｜READY" : "压回确认｜不授权") : ev == EV_SUPPORT_WATCH ? "支撑观察" : ev == EV_RESISTANCE_WATCH ? "阻力观察" : f_state_text(st)
string positionText = str.length(episodeSourceIdentityKey) > 0 ? episodeSourceIdentityKey + "｜" + f_price(frozenLower) + "–" + f_price(frozenUpper) : "等待 prior-published SATy/ATR band"
string validityText = "SATy至 " + f_time(earliestBandValidUntil) + "｜ATR至 " + f_time(atrValidUntilInput)
string protectionText = latestPlanFresh ? f_price(latestInvalidation) + "｜trigger " + f_price(latestTrigger) : st == ST_APPROACH ? (side == ROLE_SUPPORT ? "accepted break < " + f_price(frozenLower) : "accepted break > " + f_price(frozenUpper)) : "—"
string targetText = latestPlanFresh ? f_price(latestTarget) + "｜" + latestTargetSource + "｜" + str.tostring(latestSpaceR, "#.###") + "R" : f_reason_text(lastReason)
var table card = table.new(position.bottom_right, 2, 5, bgcolor=color.new(color.rgb(13, 19, 29), 3), frame_color=color.new(color.silver, 45), frame_width=1)
if barstate.islast and showCard
    table.cell(card, 0, 0, "结论", text_color=color.silver)
    table.cell(card, 1, 0, conclusionText, text_color=color.white)
    table.cell(card, 0, 1, "位置", text_color=color.silver)
    table.cell(card, 1, 1, positionText, text_color=color.white)
    table.cell(card, 0, 2, "有效期", text_color=color.silver)
    table.cell(card, 1, 2, validityText, text_color=color.yellow)
    table.cell(card, 0, 3, "保护", text_color=color.silver)
    table.cell(card, 1, 3, protectionText, text_color=color.white)
    table.cell(card, 0, 4, "目标/原因", text_color=color.silver)
    table.cell(card, 1, 4, targetText, text_color=color.white)
if barstate.islast and not showCard
    table.clear(card, 0, 0, 1, 4)
// POSITION_REVERSAL_10M_CANONICAL_END phase1-10m-position-reversal-1.3
