//@version=6
// ═══════════════════════════════════════════════════════════════════════════
// IDM v15 — 位置优先（location-first）
//
// v14 死于两件事，v15 直接针对它们：
//
//   1. 入场价 = 信号 K 的收盘价。那根 K 越大，进得越远、离止损越远、位置越差。
//      → 用户原话：「要么在剧烈下跌时去卖，要么在剧烈上涨时去买，肯定不是好位置」
//      → v15 加【位置闸门】：离参考线太远、信号K太大、近端冲量太强、Phase 极端
//         —— 四者任一触发，**不入场**。这是 v15 与 v14 唯一的机制性区别。
//
//   2. 入场后 1-2 根内因收盘穿回 13 而离场的交易有 143 笔（31.0%），贡献 -41.6R
//      —— 而整本账是 -41.7R。**这一类交易一个人包办了全部亏损**，且这个比例在四个
//      数据集上是 31.9/31.0/31.8/32.6%，稳到不像市场，是规则的几何性质。
//      → v15 要求最小持仓，并把出场换到另一条线。
//      ⚠ 诚实标注：换出场线本身在实测里几乎没改善每笔期望（8/21/34 的均R 依次
//        -0.067/-0.071/-0.068，非单调）。真正起作用的可能只是"最小持仓"。
//
//   3. Recovery 亏得比 Vomy 多十倍，主犯是【保护位太贴脸】：Recovery 的保护位
//      中位仅 0.065 ATR，33% 的交易死在保护位；Vomy 的 fin 保护位 0.151 ATR，
//      只有 5% 被扫。且 0.6 点点差占 6.25 点风险的 9.6%，止损太近被噪音和点差两头吃。
//      → v15 的最小风险距离默认 0.12 ATR，并给保护位加缓冲。**这一条是实测定的。**
//
// 三个 setup 直接对应用户自己描述的三步：
//   S1 趋势翻转  「袋子变红了就往下走」
//   S2 位被拒绝  「反反复复下不去」          ← v14 完全没有
//   S3 背离      「Saty Oscillator 底背离」   ← v14 完全没有
//
// 高周期偏向是【软参考】不是闸门 —— 用户明确否掉了硬闸门：
//   「日内交易不可能一直都是单边下跌的……位置下不去以后最终不还是反抽上来了吗」
//   所以 bias 只在面板显示、并在账本里分组，**从不阻止任何一笔入场**。
//
// ⚠⚠ 必须先读的一条：v14 诊断的最硬结论是【入场时点不带方向信息】——
//     纯括号单（保护位 vs T1 谁先到，与出场规则无关）实测 53.4%，
//     几何零假设 S/(S+T) = 56.8%，z_geom = -1.68；60 个格子的 z_geom
//     中位 -1.33，没有一个越过 +1.96。而且【收紧任何门槛都只减少笔数，
//     不改善每笔期望】：8 个变体把频率压掉 83%，均 R 始终在 -0.184~-0.045。
//
//     所以 v15 的位置闸门是一个【尚未验证的新假设】，不是已知有效的修复。
//     它与之前测过的所有门槛有一处本质不同：那些门槛筛的是"要不要下注"，
//     位置闸门筛的是"这一注下在什么位置"——前者改不到赔率结构，后者直接改
//     风险距离与入场偏离度。
//     ⚠ 后续更新：V15_ENTRY_LOCATION.md 已经给出答案，而且是【否定】的——
//        「入场偏离度」这一半没有价值，有价值的只有「风险距离」那一半。
//        见本文件顶部 2026-07-28 补记 C。
//
// 证据纪律：面板上每个数字都带标签。凡标【未验证】的，界面不得暗示它有效。
// ═══════════════════════════════════════════════════════════════════════════
indicator("IDM v15", "IDM v15", overlay=true,
     max_lines_count=200, max_labels_count=300)

const string VERSION_ID = "15.3.0-vix1d-implied"

// ═══ 2026-07-28 补记：与 Saty 当日实盘的逐条对账（这是 v15.1 的全部理由）═══
//
// 他今天（ET）一共只有两个动作，全部发生在 ATR trigger box 的两条边上：
//   08:56 盘前  "In the trigger box with Hourly(ETH) + 10m compression …
//               Big events → smaller range. I am probably going to
//               sit on hands / be more picky today."   ← 先定性，再交易
//   09:32      "10m looking Vomy, about to test PM support"（从盒顶往下）
//   09:42      "10m Vomy indeed" → 09:46 "scale puts, leave runners"
//   09:48      "Nice move top of range to bottom of range"（到盒底了结）
//   10:01–10:49 "The range be ranging" / "What a box"  ← 中间【不做】
//   11:19      "SPX/SPY testing top of range"
//   11:27      "At 7440, almost 742. Scale longs"       ← 7440 = call trigger
//
// 当日实际梯子（我们图上已经画着的）：锚 7418.00｜ATR 88.21｜
//   call trigger 7438.82｜put trigger 7397.18。他嘴里的 "range" 就是这个盒子。
//
// 同一天 v14 在图上做了什么：在盒【底】那一带连续做空——
//   空Recovery→平空 −1R→空Recovery→平空 −0.6R→空Recovery→平空 −1R
//   而面板自己写着「无排列」。也就是说，在他平掉 put、准备转多的位置，
//   我们在反复开空，且 Vomy 要求的五线排列前提根本不成立。
//
// 由此得到两条 v15.1 的机制性修改：
//
//   A【状态层】区间里 EMA 交叉必然在最差位置发火——跌到盒底才叉下、
//     涨到盒顶才叉上。这是几何必然，不是概率问题。所以区间态禁用交叉类
//     setup，只留边缘拒绝与背离，且方向必须朝盒内。
//     ⚠ 与我此前否掉的 REGIME_MONTHLY_BOX 结论不冲突：那条否掉的是
//       「箱内就少做」（对同一套规则开关）；这里是【换规则】，不同命题。
//
//   B【具名位闸门】入场价必须贴着一个具名位（ATR 梯 / 夜盘·盘前·前日高低）。
//     依据不是我的直觉，是他的行为：每一篇 #ideas 都是
//     「IF 守住/破 <具名位> THEN 目标 <具名位>」；07-27 的赢单是
//     「D21 盘前阻力不破 → 破区间 → Vomy → 10m200 + 夜盘缺口」；
//     07-26 #notes 开篇是「10m divergence **at support**」。
//     位是【位置】，EMA/背离只是【判据】。没有位 = 不下注。
//
//   C【位置闸门重新标定】V15_ENTRY_LOCATION.md 实际跑成了（我一度误以为它
//     和其余 4 份一起死于 session limit）。它把 v15.0 的 ①②③ 三条闸门【否定】了：
//     「离13近」「K小」「不追」全都比基线更差；唯一有效的是【止损放远】。
//     → ①②③ 默认关闭，最小风险距离扶正为主闸门。详见该处注释。
//     这条是本次改动里唯一有统计支撑的，A 和 B 都没有。
//
// ⚠ A 与 B 都是【新假设】，与本文件下方所有「已验证」标注不同等级。
//   它们此刻的证据是：一天的逐条对账 + 与全部语料一致。这不叫统计验证。
//   另外 4 份 V15 研究（PHASE_VETO / LEVEL_RETEST / BIAS / ADVERSARIAL）
//   确实死于 session limit，必须补跑。在此之前不推送。
// ═══════════════════════════════════════════════════════════════════════

// ── 01 ATR 位（对齐官方 Saty ATR Levels，已逐位验证）────────────────────
string G_ATR = "01 · ATR 位"
int atrLen = input.int(14, "ATR 长度", minval=2, group=G_ATR)
float trigPct = input.float(0.236, "Trigger 比例", step=0.001, group=G_ATR)
bool showFib = input.bool(true, "显示全部斐波那契位", group=G_ATR)

// ── 02 时段位 ─────────────────────────────────────────────────────────────
string G_SESS = "02 · 时段位"
bool showON = input.bool(true, "夜盘高低 (18:00→09:30 ET)", group=G_SESS)
bool showPM = input.bool(true, "盘前高低 (04:00→09:30 ET)", group=G_SESS)
bool showPD = input.bool(true, "前日高低 PDH/PDL", group=G_SESS)

// ── 03 Ribbon / Setup 周期 ────────────────────────────────────────────────
string G_RIB = "03 · Pivot Ribbon（8/13/21/34/48）"
bool showRibbon = input.bool(true, "显示 Ribbon", group=G_RIB)
string setupTF = input.timeframe("10", "Setup 计算周期", group=G_RIB,
     tooltip="趋势与入场按此周期的【已完成】K 计算。作者原话全部是 10 分钟。" +
         "图表周期 ≥ 此周期时自动退回按图表周期算。")

// ── 04 位置闸门（v15 的核心，防追高追空）─────────────────────────────────
string G_LOC = "04 · 位置闸门（防追高追空）"
bool useLocGate = input.bool(true, "启用位置闸门", group=G_LOC,
     tooltip="⚠ 2026-07-28 已按 V15_ENTRY_LOCATION.md 重新标定：" +
         "①②③ 被实测【否定】，默认关闭；只有 ④⑤ 与最小风险距离默认生效。")

// ⚠⚠ ①②③ 的标定结果（research/reports/V15_ENTRY_LOCATION.md，
//     ES=F 10m，517 个信号，路径判定落到 5m 子 K，基线均净R = −0.142）：
//
//     D1≤中位（离13近）      均净R −0.250  Δ−0.108  t=−4.82   ← 反而更差
//     D3≤中位（不追）        均净R −0.212  Δ−0.070  t=−3.97   ← 反而更差
//     D1>中位且D3>中位(又远又追) 均净R −0.052  Δ+0.091  z_sel=+1.92 ← 反而更好
//     D2r 最小档（K最小）     命中 37.5% vs 几何零假设 46.5%, z=−2.06 ← 反而更差
//     D4≥中位（止损远）      均净R +0.005  Δ+0.147  z_sel=+4.37  ← 唯一有效
//
//     全文 257 个格子，Bonferroni 门槛 |z|>3.73。**只有最后一行越过。**
//     机制：D4 与「逆行/风险」秩相关 ρ=−0.505 (z=−11.47)，全报告最强关系。
//
//     怎么理解「追反而更好」：追确实带来更深的【绝对】逆行
//     （D2r 前3根 |MAE| ρ=+0.317, z=+7.20，用户的直觉在这一半是对的），
//     但追的时候结构止损【也更远】，按 R 计反而更安全。
//     真正杀人的不是追，是【止损太近】。
//     所以 v15.1 把 ①②③ 默认关掉，把最小风险距离扶正为主闸门。
//     ⚠ 保留开关是为了可复验，不是留后路——打开它们等于逆着实测走。
bool useD1 = input.bool(false, "① 限制离 EMA13 距离【实测否定，默认关】",
     group=G_LOC, tooltip="打开会让均净R 从 −0.142 恶化到 −0.250（t=−4.82）。")
float maxDistATR = input.float(0.10, "① 入场价离 EMA13 最远（ATR）", step=0.01,
     minval=0.01, group=G_LOC)
bool useD2 = input.bool(false, "② 限制信号 K 振幅【实测否定，默认关】",
     group=G_LOC, tooltip="最小 K 那一档是全样本最差之一：命中 37.5% vs 零假设 46.5%。")
float maxBarATR = input.float(0.20, "② 信号 K 最大振幅（ATR）", step=0.01,
     minval=0.02, group=G_LOC)
bool useD3 = input.bool(false, "③ 限制近端冲量【实测否定，默认关】",
     group=G_LOC, tooltip="「不追」那一半均净R −0.212，比基线更差（t=−3.97）。")
float maxThrustATR = input.float(0.35, "③ 入场前 3 根顺向净位移上限（ATR）",
     step=0.01, minval=0.05, group=G_LOC)
bool usePhaseVeto = input.bool(true, "④ Phase 顺向极端时否决", group=G_LOC,
     tooltip="Saty 原话「3m extreme here, 10m has room」。顺方向已极端时不追。")
float phaseExtreme = input.float(61.8, "Phase 极端阈值", step=0.1, group=G_LOC)
bool useLvlGate = input.bool(true, "⑤ 入场必须贴着一个具名位", group=G_LOC,
     tooltip="【2026-07-28 Saty 实盘对照后新增，也是本闸门里最硬的一条】" +
         "他每一篇 #ideas 都是「IF 守住/破 <具名位> THEN 目标 <具名位>」；" +
         "07-27 的赢单是「D21 盘前阻力不破 → 破区间 → Vomy → 10m200 + 夜盘缺口」；" +
         "07-28 全天只有两个动作，都发生在 trigger box 的两条边上" +
         "（09:48「top of range to bottom of range」、11:27「At 7440」= call trigger 7438.82）。" +
         "结论：位是【位置】，EMA/背离只是【判据】。没有位 = 不下注。")
float maxLvlDistATR = input.float(0.10, "⑤ 离最近具名位最远（ATR）", step=0.01,
     minval=0.01, group=G_LOC)
bool lvlIncludeSess = input.bool(true, "⑤ 具名位含夜盘/盘前/前日高低", group=G_LOC,
     tooltip="语料统计里他用得最多的三组非 ATR 位。今天 09:32 那句" +
         "「about to test PM support」用的就是盘前低点。")

// ── 04b 状态层：区间 vs 趋势（v15.1 新增，今天最重要的一条）──────────────
string G_REG = "04b · 状态层（区间 / 趋势）"
bool useRegime = input.bool(true, "启用状态层", group=G_REG,
     tooltip="v14 在区间里连续做空同一个价格带、每笔 −1R。这不是参数问题：" +
         "区间里 EMA 交叉【必然】在最差位置发火——跌到区间底才叉下、涨到顶才叉上。" +
         "符号是反的，不是幅度不对。这解释了为什么收紧任何门槛都只减少笔数。" +
         "Saty 07-28 盘前先定性「in the trigger box + compression → smaller range，" +
         "sit on hands / be more picky」，再只在两条边上动手。")
bool rangeNoFlip = input.bool(true, "区间态禁用 S1 翻转", group=G_REG,
     tooltip="交叉类信号在区间内是负期望的主要来源。区间态只留 S2 拒绝 + S3 背离。")
bool rangeFadeOnly = input.bool(true, "区间态只做「离开边缘」方向", group=G_REG,
     tooltip="在盒子下沿只能做多、上沿只能做空。这就是他今天的两个动作。")

// ── 05 Setup ──────────────────────────────────────────────────────────────
string G_SET = "05 · Setup"
bool enFlip = input.bool(true, "S1 趋势翻转（袋子变色 + 站到外侧）", group=G_SET)
bool enHold = input.bool(true, "S2 位被拒绝（同位反复不破后收复）", group=G_SET)
bool enDiv = input.bool(true, "S3 背离（Phase 与价格背离）", group=G_SET)
int holdTouches = input.int(2, "S2 需要的最少触及次数", minval=1, maxval=5,
     group=G_SET, tooltip="用户原话「反反复复下不去」。2 或 3 都合理；" +
         "【未验证】哪个更好——研究中，见 V15_LEVEL_RETEST_AND_DIVERGENCE.md。")
int divLookback = input.int(20, "S3 背离回看根数", minval=5, group=G_SET)
float minRiskATR = input.float(0.12, "最小风险距离（ATR）★主闸门", step=0.01,
     group=G_SET,
     tooltip="★ 这是整套系统里【唯一】通过多重比较校正的闸门，不要关掉它。" +
         "V15_ENTRY_LOCATION：D4≥中位(0.110 ATR) 均净R +0.005 vs 基线 −0.142，" +
         "Δ+0.147，z_sel=+4.37（Bonferroni 门槛 3.73，全文 257 格仅此一格越过）。" +
         "D4 最小档：命中 24.0% vs 几何零假设 35.8%（z=−2.74），均净R −0.551。" +
         "机制：D4 与「逆行/风险」秩相关 ρ=−0.505 (z=−11.47)。" +
         "v14 佐证：Recovery 保护位中位仅 0.065 ATR、33% 死在保护位；" +
         "Vomy 的 fin 保护位 0.151 ATR、只有 5% 被扫。" +
         "0.6 点点差占 6.25 点风险的 9.6%——止损太近被噪音与点差两头吃。" +
         "⚠ 但请注意：改善之后也只是【打平】（总净R +1.3），不是盈利。")
float stopBufATR = input.float(0.03, "保护位缓冲（ATR）", step=0.01, group=G_SET,
     tooltip="把保护位从结构极值再外推一点，避开贴脸止损。同上，实测驱动。")

// ── 06 出场（与入场用不同的线，修 v14 的同线缺陷）───────────────────────
string G_EXIT = "06 · 出场"
string EXIT_34 = "收盘穿 EMA34"
string EXIT_21 = "收盘穿 EMA21"
string EXIT_48 = "收盘穿 EMA48"
string exitLine = input.string(EXIT_34, "结构离场用哪条线", group=G_EXIT,
