     tooltip="**不可选 EMA13**——入场看 13，出场必须换一条线，" +
         "否则同阈值来回穿必然 churn（v14 实测：churn 占理论上界 77%）。")
int minHoldBars = input.int(3, "最小持仓（setup K 根数）", minval=0, group=G_EXIT,
     tooltip="入场后 N 根内不因结构条件离场，只认保护位。防止一进就被震出。")
int cooldownBars = input.int(6, "同向冷却（setup K 根数）", minval=0, group=G_EXIT)

// ── 06b theta 时钟（2026-07-28 用 UW 真实 0DTE 链标定，这是全新的一层）──────
//
// 项目此前最大的一条裂缝：**账本记标的 R，用户交易 0DTE 期权。**
// 2026-07-28 拿到 Unusual Whales 的 SPXW 0DTE 真实链后第一次量化（SPX 7437.8，
// 距收盘 3.57h，7440C 价 9.20 / δ0.473 / γ0.016 / θ−9.736 到期）：
//
//   持仓      赢单%    输单%   theta%   真实盈亏比   打平胜率
//   15分钟      81      -52      -7       1.55        39%
//   30分钟      73      -60     -15       1.23        45%
//    1小时      59      -74     -30       0.79        56%
//    2小时      29     -104     -59       0.28        78%
//    3小时      -1     -134     -89      -0.00       100%
//
// 标的口径盈亏比 1.31:1（打平胜率 43%）；期权口径拖两小时就变成 0.28:1（78%）。
// **v14 实测胜率 32% —— 按此表，32% 要打平，交易必须在 15 分钟内解决。**
//
// 所以时间不是"锦上添花的过滤器"，它是 0DTE 的主导变量。
// v14/v15 此前的规则里【没有任何时间维度】，这是结构性缺陷，不是参数问题。
// 复算脚本：research/satylab/options.py；链快照：research/fixtures/spxw_0dte_*.json
string G_THETA = "06b · theta 时钟（0DTE 专用）"
bool useTimeExit = input.bool(true, "启用时间离场", group=G_THETA,
     tooltip="到点就走，不管形态。Saty 自述「aim to be done by 12pm EST」，" +
         "2026-07-27 他 14:37 收工、07-28 也在午前把两笔都了结了。")
int maxHoldBars = input.int(9, "最大持仓（setup K 根数）", minval=1, group=G_THETA,
     tooltip="10m setup 下 9 根 = 90 分钟。按上表，90 分钟时真实盈亏比已跌到 ~0.5。" +
         "这个默认值是【按 theta 表定的上界】，不是搜出来的最优值。")
bool useHardStopTime = input.bool(true, "收盘前强制平仓", group=G_THETA)
int flatBeforeMin = input.int(30, "收盘前多少分钟平掉（ET）", minval=5,
     group=G_THETA, tooltip="0DTE 最后半小时 theta 与 gamma 同时失控，不持仓。")
// —— 隐含波动来源：VIX1D 自动 / 手填覆盖 ————————————————————————————
//
// 为什么不用 Unusual Whales API：它是与平台分开的付费订阅（$150/月，
// 年付 $125/月；一周免费试用会自动转付费）。用户现有的平台账号【不含】API。
// 所以这里改用 CBOE:VIX1D —— TradingView 免费就有，概念上正是 0DTE 隐含波动。
//
// ⚠⚠ 校准系数是【一天的观测】，必须当成待验证的量，不要当常数用。
//     2026-07-28 12:26 ET，SPX 7437.8，距收盘 214 分钟：
//        UW 实际隐含（=ATM 跨式 × ~0.875）  = 17.51 点
//        VIX1D = 12.56，朴素推算
//          spot × VIX1D/100 / sqrt(252) × sqrt(214/390) = 43.59 点
//        → 校准系数 = 17.51 / 43.59 = 0.402
//     可能的原因：VIX1D 按 24 小时日历日年化而非 6.5 小时交易时段
//     （sqrt(24/6.5) = 1.92），外加盘中换约。**但这是 n=1。**
//
//     本项目栽过一模一样的跟头：用两天的 ^GSPC/CFD ATR 比值当常数，
//     246 天一测 mean 1.117 / sd 0.083 / 范围 0.826–1.418，直接崩掉。
//     所以 vix1dCalib 是一个【公开的、可调的、待收集数据校准的】参数，
//     并且每根 K 都把 VIX1D 与推算值送进数据窗，方便逐日记录。
float impliedMovePts = input.float(0.0, "手填今日隐含波动（点）｜0 = 用 VIX1D",
     step=0.01, group=G_THETA,
     tooltip="填了就覆盖 VIX1D 推算。UW 的 SPXW 0DTE 到期标签直接给这个数。")
bool useVix1d = input.bool(true, "用 CBOE:VIX1D 自动推算", group=G_THETA)
float vix1dCalib = input.float(0.402, "VIX1D 校准系数【n=1，待验证】", step=0.001,
     minval=0.05, maxval=2.0, group=G_THETA,
     tooltip="2026-07-28 单日标定：UW 17.51 / VIX1D 朴素推算 43.59 = 0.402。" +
         "**一天的数据不足以确定它。** 面板会同时显示 VIX1D 与推算值，" +
         "请逐日和 UW 的数字对一次，攒够 20 天再定。在那之前把它当粗略参考。")

// （VIX1D 推算块下移到 minsToClose 定义之后 —— Pine 要求先定义后用）

// ── 07 偏向（软参考，永不阻止入场）───────────────────────────────────────
string G_BIAS = "07 · 偏向（只显示与分组，不当闸门）"
bool showBias = input.bool(true, "显示日线偏向", group=G_BIAS,
     tooltip="用户明确否掉了硬闸门：「日内交易不可能一直都是单边下跌的」。" +
         "所以偏向只用于显示与账本分组，从不阻止任何一笔入场。")

// ── 08 显示 ───────────────────────────────────────────────────────────────
string G_VIEW = "08 · 显示"
bool showPanel = input.bool(true, "显示面板", group=G_VIEW)
bool showLedger = input.bool(true, "显示账本", group=G_VIEW)
bool showVetoMarks = input.bool(true, "标出被位置闸门否决的信号", group=G_VIEW,
     tooltip="小灰点 = 有 setup 但位置太差被否决。这是 v15 最该看的东西：" +
         "它让你看见【系统忍住没追】的那些时刻。")

// ── 标签环形缓冲 ─────────────────────────────────────────────────────────
const int LABEL_CAP = 180
var array<label> keepL = array.new<label>()
f_keep(label lb) =>
    array.push(keepL, lb)
    if array.size(keepL) > LABEL_CAP
        label.delete(array.shift(keepL))
    lb

// ── ATR 位引擎（官方构造）────────────────────────────────────────────────
var string tkr = ticker.new(syminfo.prefix, syminfo.ticker,
     session=session.extended)
[anchor, atrVal, pdh, pdl] = request.security(tkr, "D",
     [close[1], ta.atr(atrLen)[1], high[1], low[1]],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
f_at(float r) => anchor + r * atrVal

var array<float> RUNGS = array.from(-1.618, -1.272, -1.0, -0.786, -0.618,
     -0.5, -0.382, -0.236, 0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0,
     1.272, 1.618)

f_next_rung(float px, int dir) =>
    float best = na
    if atrVal > 0
        for i = 0 to array.size(RUNGS) - 1
            float lv = f_at(array.get(RUNGS, i))
            if dir > 0 and lv > px + syminfo.mintick and (na(best) or lv < best)
                best := lv
            if dir < 0 and lv < px - syminfo.mintick and (na(best) or lv > best)
                best := lv
    na(best) ? px + dir * 0.236 * atrVal : best

f_nearest_rung(float px) =>
    float best = na
    float bd = na
    if atrVal > 0
        for i = 0 to array.size(RUNGS) - 1
            float lv = f_at(array.get(RUNGS, i))
            float d = math.abs(px - lv)
            if na(bd) or d < bd
                bd := d
                best := lv
    [best, bd]

// ── 时段区间 ─────────────────────────────────────────────────────────────
f_sess(string s, bool on) =>
    var float hi = na
    var float lo = na
    bool inS = on and not na(time(timeframe.period, s, "America/New_York"))
    if inS and not inS[1]
        hi := high
        lo := low
    else if inS
        hi := math.max(nz(hi, high), high)
        lo := math.min(nz(lo, low), low)
    [hi, lo]
[onHi, onLo] = f_sess("1800-0930", showON)
[pmHi, pmLo] = f_sess("0400-0930", showPM)
bool inRTH = not na(time(timeframe.period, "0930-1600", "America/New_York"))

// 距 16:00 ET 收盘还有多少分钟（非 RTH 时为 na）
f_mins_to_close() =>
    float m = na
    if inRTH
        int hh = hour(time_close, "America/New_York")
        int mm = minute(time_close, "America/New_York")
        m := (16 - hh) * 60 - mm
    m
float minsToClose = f_mins_to_close()

float vix1d = useVix1d ? request.security("CBOE:VIX1D", "D", close,
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on) : na
// 全天（自开盘起）1σ 期望幅度，再按剩余时间开方缩放
float emFull = na(vix1d) ? na :
     close * (vix1d / 100.0) / math.sqrt(252.0) * vix1dCalib
float emNow = na(emFull) ? na :
     na(minsToClose) ? emFull : emFull * math.sqrt(math.max(minsToClose, 1) / 390.0)
// 手填优先；否则用 VIX1D 推算
float impliedNow = impliedMovePts > 0 ? impliedMovePts : emNow
string impliedSrc = impliedMovePts > 0 ? "手填" :
     na(emNow) ? "无" : "VIX1D " + str.tostring(vix1d, "#.##") + "【n=1校准】"

// ── 具名位全集（ATR 梯 + 时段位）─────────────────────────────────────────
// 「具名位」= 他会在帖子里点名的那种位。ATR 梯是一组，夜盘/盘前/前日高低是另一组
// （语料统计里这三组出现频率最高，见 SATY_PLAYBOOK_CORPUS.md 第三节）。
f_nearest_named(float px) =>
    [rl, rd] = f_nearest_rung(px)
    float best = rl
    float bd = rd
    string nm = "ATR位"
    if lvlIncludeSess
        array<float> ls = array.from(onHi, onLo, pmHi, pmLo, pdh, pdl)
        array<string> ns = array.from("夜盘高", "夜盘低", "盘前高", "盘前低",
             "PDH", "PDL")
        for i = 0 to array.size(ls) - 1
            float lv = array.get(ls, i)
            if not na(lv)
                float d = math.abs(px - lv)
                if na(bd) or d < bd
                    bd := d
                    best := lv
                    nm := array.get(ns, i)
    [best, bd, nm]

// ── Setup 周期的 ribbon + Phase（非重绘：[1] + lookahead_on）────────────
f_phase(float src, float a) => a > 0 ? (src - ta.ema(src, 21)) / (3.0 * a) * 100 : na

[h8, h13, h21, h34, h48, hC, hH, hL, hPh, hT, hAtr] =
     request.security(syminfo.tickerid, setupTF,
     [ta.ema(close, 8)[1], ta.ema(close, 13)[1], ta.ema(close, 21)[1],
      ta.ema(close, 34)[1], ta.ema(close, 48)[1], close[1], high[1], low[1],
      ta.ema(f_phase(close, ta.atr(14)), 3)[1], time[1], ta.atr(14)[1]],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

bool useHTF = timeframe.in_seconds(setupTF) >
     timeframe.in_seconds(timeframe.period)
float e8 = useHTF ? h8 : ta.ema(close, 8)
float e13 = useHTF ? h13 : ta.ema(close, 13)
float e21 = useHTF ? h21 : ta.ema(close, 21)
float e34 = useHTF ? h34 : ta.ema(close, 34)
float e48 = useHTF ? h48 : ta.ema(close, 48)
float sc = useHTF ? hC : close
float sh = useHTF ? hH : high
float sl = useHTF ? hL : low
float phase = useHTF ? hPh : ta.ema(f_phase(close, ta.atr(14)), 3)
bool newBar = useHTF ? ta.change(hT) != 0 : barstate.isconfirmed

bool stackBull = e8 > e13 and e13 > e21 and e21 > e34 and e34 > e48
bool stackBear = e8 < e13 and e13 < e21 and e21 < e34 and e34 < e48
float exitRef = exitLine == EXIT_21 ? e21 : exitLine == EXIT_48 ? e48 : e34

// ── 状态层：区间 vs 趋势 ─────────────────────────────────────────────────
// 区间 = ①价格还在 trigger box 内（|ratio| <= 0.236，他嘴里的 "in the trigger box"）
//        或 ②五条 EMA 未排列（他嘴里的 compression / "no trend"）
// 趋势 = 五线排列 且 已在 box 外
// ⚠ 这【不是】我之前否掉的那种 regime 过滤器。REGIME_MONTHLY_BOX 否掉的是
//   「箱内胜率更低，所以少做」——那是对【同一套规则】开关。这里是【换规则】：
//   区间态改用边缘拒绝，趋势态才用交叉/破位。两者是不同的命题。
float pxRatio = atrVal > 0 ? (sc - anchor) / atrVal : na
bool inBox = not na(pxRatio) and math.abs(pxRatio) <= trigPct
bool stacked = stackBull or stackBear
bool isRange = useRegime and (inBox or not stacked)
string regimeTxt = not useRegime ? "（状态层关闭）" :
     isRange ? (inBox ? "区间（trigger box 内）" : "区间（未排列/压缩）") :
     (stackBull ? "趋势·多" : "趋势·空")

// 日线偏向（软参考）
[d21, dAnchorM] = request.security(tkr, "D", [ta.ema(close, 21), close],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
int biasDir = close > d21 ? 1 : close < d21 ? -1 : 0

// ── 位置闸门 ─────────────────────────────────────────────────────────────
// 四条子闸门；任一不通过 → 该 setup 被否决（记录但不入场）
f_loc_ok(int dir) =>
    float dist = math.abs(sc - e13) / math.max(atrVal, syminfo.mintick)
    float barSz = (sh - sl) / math.max(atrVal, syminfo.mintick)
    float thrust = useHTF ? na : (close - close[3]) * dir /
         math.max(atrVal, syminfo.mintick)
    [nlv, nld, nnm] = f_nearest_named(sc)
    float lvlD = na(nld) ? na : nld / math.max(atrVal, syminfo.mintick)
    bool g1 = not useD1 or dist <= maxDistATR
    bool g2 = not useD2 or barSz <= maxBarATR
    bool g3 = not useD3 or na(thrust) or thrust <= maxThrustATR
    bool g4 = not usePhaseVeto or na(phase) or
         (dir > 0 ? phase < phaseExtreme : phase > -phaseExtreme)
    bool g5 = not useLvlGate or (not na(lvlD) and lvlD <= maxLvlDistATR)
    [g1 and g2 and g3 and g4 and g5, g1, g2, g3, g4, g5, dist, barSz,
     lvlD, nnm]

// ── 位触及计数（S2「反反复复下不去」）───────────────────────────────────
// 对最近的具名位记「独立触及次数」：进入 ±0.03 ATR 带算一次，
// 必须离开 ≥0.05 ATR 才能记下一次。
var float watchLvl = na
var int touchN = 0
var bool inBand = false
if newBar and atrVal > 0
    [nr, nd] = f_nearest_rung(sc)
    float bandIn = 0.03 * atrVal
    float bandOut = 0.05 * atrVal
    if na(watchLvl) or math.abs(nr - watchLvl) > syminfo.mintick
        // 换了一个最近位 → 重新计数
        watchLvl := nr
        touchN := 0
        inBand := false
    bool nowIn = math.abs(sc - watchLvl) <= bandIn
    if nowIn and not inBand
        touchN := touchN + 1
        inBand := true
    else if inBand and math.abs(sc - watchLvl) > bandOut
        inBand := false

// ── 背离（S3）────────────────────────────────────────────────────────────
f_div_bull() =>
    bool r = false
    if newBar and not na(phase)
        float pl = ta.lowest(sl, divLookback)
        float ol = ta.lowest(phase, divLookback)
        r := sl <= pl + syminfo.mintick and phase > ol + 1.0
    r
f_div_bear() =>
    bool r = false
    if newBar and not na(phase)
        float ph = ta.highest(sh, divLookback)
        float oh = ta.highest(phase, divLookback)
        r := sh >= ph - syminfo.mintick and phase < oh - 1.0
    r
bool divBull = f_div_bull()
bool divBear = f_div_bear()

// ── 持仓状态 ─────────────────────────────────────────────────────────────
var int pDir = 0
var string pSetup = ""
var string pSess = ""
var int pBias = 0
var float pEntry = na
var float pRisk = na
var float pProt = na
var float pT1 = na
var float pT2 = na
var bool pT1d = false
var bool pT2d = false
var float pFrac = 1.0
var float pR = 0.0
var int pBars = 0
var int pEntryT = na
var int cdBars = 0

// 账本：0 全部 1 RTH 2 夜盘 3 顺偏向 4 逆偏向 5 S1 6 S2 7 S3
var array<int> agN = array.new<int>(8, 0)
var array<int> agW = array.new<int>(8, 0)
var array<float> agR = array.new<float>(8, 0.0)
f_led(bool rth, int bias, int dir, string su, float r) =>
    int si = su == "翻转" ? 5 : su == "拒绝" ? 6 : 7
    int[] ix = array.from(0, rth ? 1 : 2, bias == dir ? 3 : 4, si)
    for i = 0 to 3
        int k = array.get(ix, i)
        array.set(agN, k, array.get(agN, k) + 1)
        array.set(agR, k, array.get(agR, k) + r)
        if r > 0
            array.set(agW, k, array.get(agW, k) + 1)

string alertQ = ""
var int vetoCount = 0

// ══ 引擎（只在 setup 周期的完成 K 上推进）═══════════════════════════════
if newBar
    if cdBars > 0
        cdBars := cdBars - 1

    // ---- 管理持仓 ----
    if pDir != 0
        pBars := pBars + 1
        bool hitProt = pDir > 0 ? sl <= pProt : sh >= pProt
        bool hitT1 = not pT1d and (pDir > 0 ? sh >= pT1 : sl <= pT1)
        bool hitT2 = pT1d and not pT2d and (pDir > 0 ? sh >= pT2 : sl <= pT2)
        // 结构离场用【另一条线】，且要过最小持仓
        bool structOut = pBars > minHoldBars and
             (pDir > 0 ? sc < exitRef : sc > exitRef)
        // theta 时钟：超时 / 逼近收盘 → 强制离场（与形态无关）
        // ⚠ 注意求值顺序：保护位优先（它在时间上更早发生），时间离场放在最后，
        //   且必须 guard pDir != 0，否则同一根 K 会重复计账。
        bool timeOut = useTimeExit and pBars >= maxHoldBars
        bool closeOut = useHardStopTime and not na(minsToClose) and
             minsToClose <= flatBeforeMin
        if hitProt
            pR += pFrac * (pProt - pEntry) * pDir / pRisk
            f_led(pSess == "RTH", pBias, pDir, pSetup, pR)
            f_keep(label.new(time_close, pProt,
                 (pDir > 0 ? "平多 " : "平空 ") + (pR >= 0 ? "+" : "") +
                 str.tostring(pR, "#.##") + "R", xloc=xloc.bar_time,
                 style=pDir > 0 ? label.style_label_down : label.style_label_up,
                 color=color.new(pR >= 0 ? color.teal : color.maroon, 0),
                 textcolor=color.white, size=size.small,
                 tooltip="保护位｜" + pSetup + "｜" + pSess))
            alertQ += "【v15】" + (pDir > 0 ? "平多 " : "平空 ") +
                 str.tostring(pR, "#.##") + "R（保护位）\n"
            cdBars := cooldownBars
            pDir := 0
        else
            if hitT1
                pR += 0.50 * (pT1 - pEntry) * pDir / pRisk
                pFrac -= 0.50
                pT1d := true
                alertQ += "【v15】T1 " + str.tostring(pT1, format.mintick) +
                     " 兑现 50%\n"
            if hitT2
                pR += 0.25 * (pT2 - pEntry) * pDir / pRisk
                pFrac -= 0.25
                pT2d := true
                alertQ += "【v15】T2 " + str.tostring(pT2, format.mintick) +
                     " 兑现 25%\n"
            if structOut
                pR += pFrac * (sc - pEntry) * pDir / pRisk
                f_led(pSess == "RTH", pBias, pDir, pSetup, pR)
                f_keep(label.new(time_close, sc,
                     (pDir > 0 ? "平多 " : "平空 ") + (pR >= 0 ? "+" : "") +
                     str.tostring(pR, "#.##") + "R", xloc=xloc.bar_time,
                     style=pDir > 0 ? label.style_label_down :
                          label.style_label_up,
                     color=color.new(pR >= 0 ? color.teal : color.maroon, 0),
                     textcolor=color.white, size=size.small,
                     tooltip="结构离场（" + exitLine + "）｜" + pSetup))
                alertQ += "【v15】" + (pDir > 0 ? "平多 " : "平空 ") +
                     str.tostring(pR, "#.##") + "R（结构）\n"
                cdBars := cooldownBars
                pDir := 0
            // theta 时钟（最后判，且仅在仍持仓时）
            if pDir != 0 and (timeOut or closeOut)
                pR += pFrac * (sc - pEntry) * pDir / pRisk
                f_led(pSess == "RTH", pBias, pDir, pSetup, pR)
                f_keep(label.new(time_close, sc,
                     (pDir > 0 ? "平多 " : "平空 ") + (pR >= 0 ? "+" : "") +
                     str.tostring(pR, "#.##") + "R ⏱", xloc=xloc.bar_time,
                     style=pDir > 0 ? label.style_label_down :
                          label.style_label_up,
                     color=color.new(color.orange, 15),
                     textcolor=color.white, size=size.small,
                     tooltip=(closeOut ? "收盘前强制平仓" : "超过最大持仓") +
                          "｜持仓 " + str.tostring(pBars) + " 根｜" + pSetup +
                          "｜依据见 06b theta 时钟"))
                alertQ += "【v15】" + (pDir > 0 ? "平多 " : "平空 ") +
                     str.tostring(pR, "#.##") + "R（" +
                     (closeOut ? "收盘前" : "超时") + "）\n"
                cdBars := cooldownBars
                pDir := 0

    // ---- 找 setup（只在空仓时）----
    if pDir == 0
        int cand = 0
        string candName = ""
        float candProt = na
        // S1 趋势翻转：袋子刚变色 + 价格站到外侧
        // 区间态默认禁用——交叉类信号在区间内必然发在最差位置（v14 实证）
        if enFlip and not (isRange and rangeNoFlip)
            if stackBull and not stackBull[1] and sc > e8
                cand := 1
                candName := "翻转"
                candProt := ta.lowest(sl, 5) - stopBufATR * atrVal
            else if stackBear and not stackBear[1] and sc < e8
                cand := -1
                candName := "翻转"
                candProt := ta.highest(sh, 5) + stopBufATR * atrVal
        // S2 位被拒绝：同一个位被测试 >= N 次，然后从该位离开
        if cand == 0 and enHold and touchN >= holdTouches and not na(watchLvl)
            if sl <= watchLvl and sc > watchLvl and sc > e13
                cand := 1
                candName := "拒绝"
                candProt := math.min(sl, watchLvl - 0.03 * atrVal)
            else if sh >= watchLvl and sc < watchLvl and sc < e13
                cand := -1
                candName := "拒绝"
                candProt := math.max(sh, watchLvl + 0.03 * atrVal)
        // S3 背离
        if cand == 0 and enDiv
            if divBull and sc > sl
                cand := 1
                candName := "背离"
                candProt := ta.lowest(sl, 3) - stopBufATR * atrVal
            else if divBear and sc < sh
                cand := -1
                candName := "背离"
                candProt := ta.highest(sh, 3) + stopBufATR * atrVal
        // ---- 区间态：只做「离开边缘」的方向 ----
        // 在盒子下沿只能做多、上沿只能做空。这就是他 07-28 的两个动作：
        // 09:32 顶部转空 → 09:48「top of range to bottom of range」平；
        // 11:19 回到顶部 → 11:27「At 7440（=call trigger）… Scale longs」。
        if cand != 0 and isRange and rangeFadeOnly and not na(pxRatio)
            if cand > 0 and pxRatio > 0
                cand := 0
            else if cand < 0 and pxRatio < 0
                cand := 0

        // ---- 位置闸门 ----
        if cand != 0
            [ok, g1, g2, g3, g4, g5, dist, barSz, lvlD, lvlNm] = f_loc_ok(cand)
            if ok or not useLocGate
                float risk0 = math.abs(sc - candProt)
                if risk0 >= minRiskATR * atrVal and cdBars <= 0
                    pDir := cand
                    pSetup := candName
                    pSess := inRTH ? "RTH" : "夜盘"
                    pBias := biasDir
                    pEntry := sc
                    pRisk := risk0
                    pProt := candProt
                    pT1 := f_next_rung(sc, cand)
                    pT2 := f_next_rung(f_next_rung(sc, cand), cand)
                    pT1d := false
                    pT2d := false
                    pFrac := 1.0
                    pR := 0.0
                    pBars := 0
                    pEntryT := time_close
                if pDir != 0 and pEntryT == time_close
                    f_keep(label.new(time_close, pEntry,
                         (pDir > 0 ? "多 " : "空 ") + pSetup,
                         xloc=xloc.bar_time,
                         style=pDir > 0 ? label.style_label_up :
                              label.style_label_down,
                         color=color.new(pDir > 0 ? color.green : color.red, 0),
                         textcolor=color.white, size=size.normal,
                         tooltip="入场 " + str.tostring(pEntry, format.mintick) +
                              "｜保护 " + str.tostring(pProt, format.mintick) +
                              "｜风险 " + str.tostring(pRisk, "#.#") + " 点" +
                              "｜离13 " + str.tostring(dist, "#.###") + " ATR" +
                              "｜贴位 " + lvlNm + " " +
                              str.tostring(lvlD, "#.###") + " ATR" +
                              "｜状态 " + regimeTxt +
                              "｜T1 " + str.tostring(pT1, format.mintick) +
                              "｜T2 " + str.tostring(pT2, format.mintick) +
                              "｜偏向" + (biasDir == pDir ? "同向" : "逆向")))
                    alertQ += "【v15】" + (pDir > 0 ? "开多 " : "开空 ") +
                         pSetup + "｜" + pSess + "｜入场 " +
                         str.tostring(pEntry, format.mintick) + "｜保护 " +
                         str.tostring(pProt, format.mintick) + "｜T1 " +
                         str.tostring(pT1, format.mintick) + "｜T2 " +
                         str.tostring(pT2, format.mintick) + "\n"
            else
                vetoCount := vetoCount + 1
                if showVetoMarks
                    string why = (not g1 ? "离13太远 " +
                         str.tostring(dist, "#.##") + "ATR " : "") +
                         (not g2 ? "K太大 " + str.tostring(barSz, "#.##") +
                         "ATR " : "") + (not g3 ? "近端冲量过强 " : "") +
                         (not g4 ? "Phase顺向极端 " : "") +
                         (not g5 ? "不贴任何具名位（最近 " + lvlNm + " " +
                         str.tostring(lvlD, "#.##") + "ATR）" : "")
                    f_keep(label.new(time_close, cand > 0 ? sl : sh, "·",
                         xloc=xloc.bar_time, style=label.style_label_center,
                         color=color.new(color.gray, 80),
                         textcolor=color.new(color.gray, 30), size=size.tiny,
                         tooltip="位置闸门否决｜" + candName + "｜" + why))

if alertQ != ""
    alert(alertQ, alert.freq_once_per_bar_close)

// ── 画位 ─────────────────────────────────────────────────────────────────
plot(f_at(0.0), "PDC", color=color.new(color.white, 0), linewidth=2,
     style=plot.style_stepline)
plot(f_at(trigPct), "Call trig", color=color.new(color.aqua, 0),
     style=plot.style_stepline)
plot(f_at(-trigPct), "Put trig", color=color.new(color.yellow, 0),
     style=plot.style_stepline)
plot(showFib ? f_at(0.382) : na, "+0.382", color=color.new(color.gray, 45),
     style=plot.style_stepline)
plot(showFib ? f_at(-0.382) : na, "-0.382", color=color.new(color.gray, 45),
     style=plot.style_stepline)
plot(showFib ? f_at(0.5) : na, "+0.5", color=color.new(color.silver, 30),
     style=plot.style_stepline)
plot(showFib ? f_at(-0.5) : na, "-0.5", color=color.new(color.silver, 30),
     style=plot.style_stepline)
plot(showFib ? f_at(0.618) : na, "+0.618", color=color.new(color.silver, 30),
     style=plot.style_stepline)
plot(showFib ? f_at(-0.618) : na, "-0.618", color=color.new(color.silver, 30),
     style=plot.style_stepline)
plot(f_at(1.0), "+1 ATR", color=color.new(color.white, 25),
     style=plot.style_stepline)
plot(f_at(-1.0), "-1 ATR", color=color.new(color.white, 25),
     style=plot.style_stepline)
plot(showON ? onHi : na, "夜盘高", color=color.new(color.purple, 30),
     style=plot.style_stepline)
plot(showON ? onLo : na, "夜盘低", color=color.new(color.purple, 30),
     style=plot.style_stepline)
plot(showPM ? pmHi : na, "盘前高", color=color.new(color.orange, 35),
     style=plot.style_stepline)
plot(showPM ? pmLo : na, "盘前低", color=color.new(color.orange, 35),
     style=plot.style_stepline)
plot(showPD ? pdh : na, "PDH", color=color.new(color.blue, 45),
     style=plot.style_stepline)
plot(showPD ? pdl : na, "PDL", color=color.new(color.blue, 45),
     style=plot.style_stepline)

color ribCol = stackBull ? color.new(color.green, 60) :
     stackBear ? color.new(color.red, 60) : color.new(color.gray, 70)
plot(showRibbon ? e8 : na, "EMA8", color=ribCol)
plot(showRibbon ? e13 : na, "EMA13 入场参考",
     color=showRibbon ? color.new(color.white, 30) : na, linewidth=2)
plot(showRibbon ? e21 : na, "EMA21", color=ribCol)
plot(showRibbon ? e34 : na, "EMA34", color=ribCol)
plot(showRibbon ? e48 : na, "EMA48",
     color=showRibbon ? color.new(color.fuchsia, 40) : na, linewidth=2)
plot(showRibbon ? exitRef : na, "出场参考线",
     color=showRibbon ? color.new(color.orange, 20) : na, linewidth=2,
     style=plot.style_circles)

// ── 面板 ─────────────────────────────────────────────────────────────────
f_fmt(int k) =>
    int n = array.get(agN, k)
    n == 0 ? "—" : str.tostring(n) + "笔 " +
         str.tostring(100.0 * array.get(agW, k) / n, "#") + "% " +
         (array.get(agR, k) >= 0 ? "+" : "") +
         str.tostring(array.get(agR, k), "#.#") + "R"

var table tb = table.new(position.bottom_right, 2, 11, border_width=1,
     frame_width=1, frame_color=color.new(color.gray, 60))

if barstate.islast
    float upT = f_next_rung(close, 1)
    float dnT = f_next_rung(close, -1)
    [nrl, nrd] = f_nearest_rung(close)
    string state = pDir != 0 ?
         (pDir > 0 ? "持多 " : "持空 ") + pSetup + " 入 " +
              str.tostring(pEntry, format.mintick) + "｜保护 " +
              str.tostring(pProt, format.mintick) +
              (pT1d ? (pT2d ? "｜runner" : "｜等T2 " +
              str.tostring(pT2, format.mintick)) : "｜等T1 " +
              str.tostring(pT1, format.mintick)) :
         (cdBars > 0 ? "冷却中 " + str.tostring(cdBars) + " 根" :
          "空仓待命｜等 翻转/拒绝/背离 + 位置闸门通过")
    if showPanel
        table.cell(tb, 0, 0, "IDM v15", text_color=color.white,
             bgcolor=color.new(color.blue, 55), text_size=size.small)
        table.cell(tb, 1, 0, "Setup " + setupTF + "m｜" +
             (inRTH ? "RTH" : "夜盘"), text_color=color.white,
             bgcolor=color.new(color.blue, 55), text_size=size.small)
        table.cell(tb, 0, 1, "市场状态", text_color=color.silver, text_size=size.small)
        table.cell(tb, 1, 1, regimeTxt + (isRange ?
             "｜只做边缘拒绝，交叉类已禁用" : "｜三类 setup 全开"),
             text_color=isRange ? color.orange : color.lime,
             text_size=size.small)
        table.cell(tb, 0, 9, "结构", text_color=color.silver, text_size=size.small)
        table.cell(tb, 1, 9, (stackBull ? "多头排列" : stackBear ? "空头排列" :
             "无排列") + "｜Phase " + (na(phase) ? "—" :
             str.tostring(phase, "#")) + (na(phase) ? "" :
             (math.abs(phase) >= phaseExtreme ? " ⚠极端" : "")),
             text_color=color.white, text_size=size.small)
        table.cell(tb, 0, 2, "偏向【软】", text_color=color.silver,
             text_size=size.small)
        table.cell(tb, 1, 2, showBias ? ((biasDir > 0 ? "日线21之上 偏多" :
             biasDir < 0 ? "日线21之下 偏空" : "贴线") +
             "（仅参考，不阻止入场）") : "—",
             text_color=biasDir > 0 ? color.aqua : color.yellow,
             text_size=size.small)
        // theta 时钟：0DTE 的主导变量。数字标定见 06b 组说明。
        float t1dist = math.abs(f_next_rung(close, 1) - close)
        table.cell(tb, 0, 10, "theta 时钟", text_color=color.silver,
             text_size=size.small)
        table.cell(tb, 1, 10,
             (na(minsToClose) ? "夜盘（无 0DTE）" :
                  "距收盘 " + str.tostring(minsToClose, "#") + " 分" +
                  (pDir != 0 ? "｜已持 " + str.tostring(pBars) + "/" +
                       str.tostring(maxHoldBars) + " 根" : "")) +
             (not na(impliedNow) and impliedNow > 0 ?
                  "｜隐含 ±" + str.tostring(impliedNow, "#.#") + " (" + impliedSrc +
                       ")｜T1 距 " + str.tostring(t1dist, "#.#") + " 点 = " +
                       str.tostring(t1dist / impliedNow * 100, "#") + "%" +
                       (t1dist > impliedNow ? " ⚠超出隐含" : " ✓在隐含内") :
                  "｜隐含波动不可得（06b）"),
             text_color=(not na(minsToClose) and minsToClose <= flatBeforeMin) ?
                  color.red :
                  (not na(impliedNow) and impliedNow > 0 and t1dist > impliedNow) ?
                       color.orange : color.white,
             text_size=size.small)
        table.cell(tb, 0, 3, "最近的位", text_color=color.silver,
             text_size=size.small)
        table.cell(tb, 1, 3, str.tostring(nrl, format.mintick) + "｜距 " +
             str.tostring(atrVal > 0 ? nrd / atrVal : na, "#.##") +
             " ATR｜已测 " + str.tostring(touchN) + " 次",
             text_color=color.white, text_size=size.small)
        table.cell(tb, 0, 4, "上方分支", text_color=color.silver,
             text_size=size.small)
        table.cell(tb, 1, 4, "上破 → " + str.tostring(upT, format.mintick) +
             "，再 " + str.tostring(f_next_rung(upT, 1), format.mintick),
             text_color=color.aqua, text_size=size.small)
        table.cell(tb, 0, 5, "下方分支", text_color=color.silver,
             text_size=size.small)
        table.cell(tb, 1, 5, "下破 → " + str.tostring(dnT, format.mintick) +
             "，再 " + str.tostring(f_next_rung(dnT, -1), format.mintick),
             text_color=color.yellow, text_size=size.small)
        table.cell(tb, 0, 6, "持仓状态", text_color=color.silver, text_size=size.small)
        table.cell(tb, 1, 6, state, text_color=color.white, text_size=size.small)
    if showLedger
        table.cell(tb, 0, 7, "账本 全/RTH/夜", text_color=color.silver,
             text_size=size.small)
        table.cell(tb, 1, 7, f_fmt(0) + " ｜ " + f_fmt(1) + " ｜ " + f_fmt(2),
             text_color=color.white, text_size=size.small)
        table.cell(tb, 0, 8, "翻转/拒绝/背离", text_color=color.silver,
             text_size=size.small)
        table.cell(tb, 1, 8, f_fmt(5) + " ｜ " + f_fmt(6) + " ｜ " + f_fmt(7) +
             "　否决 " + str.tostring(vetoCount) + " 次",
             text_color=color.white, text_size=size.small)

// ── 审计 ─────────────────────────────────────────────────────────────────
plot(pDir, "audit: dir", color=na, display=display.data_window)
plot(array.get(agR, 0), "audit: total R", color=na, display=display.data_window)
plot(vetoCount, "audit: veto count", color=na, display=display.data_window)
plot(anchor, "audit: anchor", color=na, display=display.data_window)
plot(atrVal, "audit: atr", color=na, display=display.data_window)
plot(phase, "audit: phase", color=na, display=display.data_window)
plot(touchN, "audit: touch count", color=na, display=display.data_window)
plot(vix1d, "audit: VIX1D", color=na, display=display.data_window)
plot(emFull, "audit: EM full day", color=na, display=display.data_window)
plot(impliedNow, "audit: EM remaining", color=na, display=display.data_window)
plot(minsToClose, "audit: mins to close", color=na, display=display.data_window)
