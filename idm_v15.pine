float phaseExtreme = input.float(61.8, "Phase 极端阈值", step=0.1, group=G_LOC)
bool useLvlGate = input.bool(true, "⑤ 入场必须贴着一个具名位", group=G_LOC,
     tooltip="【2026-07-28 Saty 实盘对照后新增，也是本闸门里最硬的一条】" +
