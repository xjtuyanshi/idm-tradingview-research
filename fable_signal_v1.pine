//@version=6
indicator("Fable Signal v1", shorttitle="Fable Signal", overlay=true, max_labels_count=500, max_lines_count=300)

// ============================================================
// Fable Signal v3.3.2 — 与 fable-buddy（System）统一口径的图上地图。
// 【v3.3.2】陡势带标记改为"回踩多/反抽空"（用户："陡多陡空是好是坏？"——
//   直接写动作+方向，与"回踩买点/卖点"同一词系；含义：云新翻色期内回踩
//   13 均线被买起=顺势做多点，反弹到 13 均线被压回=顺势做空点）。
// 【v3.3.1】陡势带降噪（用户：图上"陡"字太多不知何意）：同一翻色期内只在
//   "拒绝位下移/上移 ≥0.1×日ATR"（趋势又走了一段、出现新的反抽）时再标，
//   同位复读不标（=buddy 同位去重口径）；标记改为"陡空/陡多"自带方向。
// 【v3.3.0】慢云翻色警报（滞回 0.008×日ATR=engine._cloud_flip 同款）+
//   陡势反抽带信号（云新翻色期反弹死在 e13 带=buddy 08-29 云色引擎；
//   周五实测云 13:20 翻红后高点距 e13 -0.6~-3 点、e21 版整下午零触发）。
//   追加式：现有 plot 通道与 16 条警报文案零改动。
// 定位：System 的"眼睛"。判断与推送来自 fable-buddy；本图负责把 System
// 引用的位、云、触及计数原样画出来。图上标记是「结构事件」，不是买卖建议。
//
// 【v3.0 统一口径表（右侧=fable-buddy 源码位置）】
//   梯位      锚=昨日完成日线收盘, 日ATR14(Wilder), 档 ±{0.236,0.382,0.5,0.618,0.786,1.0}
//             = market.RATIOS。±1.236~±2.0 扩展位已删（System 没有）。
//   慢云      EMA34/48(close) → 慢云上/内/下          = market.snapshot
//   排列      EMA 8/13/21/34/48 全序 → 多头/空头排列   = s.stack
//   触及计数  整根K高低碰位带（进带0.03×ATR记1次·出带0.05×ATR再武装）
//             = engine 08-24 插针口径（"下影线插到位又收回也要数"）
//   守住×N    pivot 种子聚类 + 同上触及计数；贴近梯位/关键位的种子不重复建
//   夜盘高低  18:00→09:30 单段（=buddy 交易日窗口；盘前不再单列）
//   日高低墙  RTH 极值 ≥30 分钟未刷新成墙，新极值换墙   = walls.py 08-24
//   日型      10:30 首小时振幅/ATR+排列+盒内外 → 趋势/区间/不明朗 = engine._daytype
//   动能衰减  相位振荡器 EMA3((c-EMA21)/(3×ATR14)×100)；价创窗口新高/新低而振荡器
//             落后≥1.0，且贴日高低(0.06ATR)或贴梯位(0.12ATR)；45分钟无新极值不重发
//             = engine._fade（用户定位：止盈/止损参考。10m 近似 buddy 的 5m 口径）
//   词汇      锚/盒顶/盒底/守住×N/拒绝×N/失效线——与推送文案同词
//
// 【验证结论摘要（诚实记录，全文见 git 历史与 FABLE_SIGNAL_V2_STATUS.md）】
//   回踩收回 n=979 t=-0.64 无机械优势；关键位反应 n=292 无优势；
//   顶背离净增量 +4.0pp p=0.88（警示价值来自已确认 pivot 高点本身）；
//   底背离/超买均未过显著性；开盘反转待验默认关。
//   夜盘风险评分=唯一样本外验证模块（收盘口径 31.7% vs 15.1%, z=+3.95, 5.4次/月）。
//   ⇒ 所有标记只报告"发生了什么结构事件"；进出场由人与 System 决定。
//
// 【适用范围】验证数字来自 SPY 10m 含盘外图。夜盘哨兵/风险评分需要盘外 bar；
//   无成交量品种 zVol 置中性（5/6 特征版）。换品种先观察一周再信任频率。
//   全部逻辑只用已确认收盘，不重绘；日线数据 [1]+lookahead=昨日完成值，无前视。
//   本脚本在 10 分钟图上工作。
//
// 【v3.0 视觉】中性灰系（=监控台 console 方案 D 色板：ink #f4f4f5/#d4d4d8/#a1a1aa，
//   涨 #3dd68c 跌 #f4626a）。信号=贴K线小标记；文字价签全部不透明、短文本；
//   黄/橙/紫已清除；信号详情（止损/风险点数）看状态卡与推送，不再糊在K线上。
//
// 【警报兼容】7 条实盘警报仍绑 v14.0 快照，本版不影响其触发。alertcondition
//   标题与文案逐字保留（到期重建时按名对上）；T_ENTRY 等占位 plot 同名保留。
//   输入项已重排——重建警报时用默认参数直接建，勿走旧 inputs 重放路径。
// ============================================================

// ---------------- 输入 ----------------
string G1 = "时段（美东时间）"
string sigSession = input.session("0930-1520", "信号时段｜15:20 后不再发（尾盘信号无法执行）", group=G1, display=display.none)
bool includePre = input.bool(false, "盘前也给信号（08:00 起）", group=G1, display=display.none)

string G2 = "模块开关"
bool useTrend = input.bool(true, "回踩-收回 结构事件", group=G2, display=display.none)
bool useOpen = input.bool(false, "开盘下杀-快速收复（多）｜出场方式待重测，默认关", group=G2, display=display.none)
bool useOpenS = input.bool(false, "开盘冲高-快速回落（空）｜未回测默认关", group=G2, display=display.none)
bool useLevel = input.bool(true, "盒顶/盒底反应（±0.236 触发位）", group=G2, display=display.none)
bool useDiv = input.bool(true, "RSI 背离警告", group=G2, display=display.none)
bool useShort = input.bool(true, "允许空头侧事件", group=G2, display=display.none)
bool useNight = input.bool(true, "夜盘异动哨兵（距昨收 ≥0.7×日ATR 时提醒）", group=G2, display=display.none)
bool useRisk = input.bool(true, "夜盘风险评分（收盘前提示今晚是否不安分）", group=G2, display=display.none)
bool useHold = input.bool(true, "守住/拒绝位自动检测", group=G2, display=display.none)
bool useWalls = input.bool(true, "当日高低重测墙（≥30分钟未刷新成墙）", group=G2, display=display.none)

string G3 = "参数（回测/System 校准，改前想清楚）"
float departMinAtr = input.float(0.12, "离带最小行程（×日ATR）", minval=0.0, step=0.01, group=G3, display=display.none)
int reclaimBars = input.int(6, "回踩后等收回的最大10m根数", minval=2, maxval=12, group=G3, display=display.none)
float openDipAtr = input.float(0.15, "开盘下杀最小深度（×日ATR）", minval=0.05, step=0.01, group=G3, display=display.none)
int openEndHHMM = input.int(1030, "开盘反转窗口截止（HHMM ET）", group=G3, display=display.none)
float trigPct = input.float(0.236, "盒边距离（×日ATR·System 同款）", step=0.001, group=G3, display=display.none)
float rearmAtr = input.float(0.12, "盒边反应重新武装距离（×日ATR）", step=0.01, group=G3, display=display.none)
float divMinRsiTop = input.float(3.0, "顶背离最小RSI差（回测校准:3）", step=0.5, group=G3, display=display.none)
float divMinRsiBot = input.float(1.0, "底背离最小RSI差（回测校准:1）", step=0.5, group=G3, display=display.none)
float nightThr = input.float(0.7, "夜盘异动阈值（×日ATR）", minval=0.3, step=0.05, group=G3, display=display.none)
float riskThr = input.float(4.0, "风险评分阈值（实测≈5.8次/月）", step=0.5, group=G3, display=display.none)
float holdTolAtr = input.float(0.06, "守住位聚类容差（×日ATR）", minval=0.01, step=0.01, group=G3, display=display.none)
float holdBreakAtr = input.float(0.10, "收破判定余量（×日ATR）", minval=0.02, step=0.01, group=G3, display=display.none)
float momoMinRsi = input.float(1.0, "机会灯最小RSI差（较上次触及）", minval=0.0, step=0.5, group=G3, display=display.none)
float touchInAtr = input.float(0.03, "触及计数进带（×日ATR·engine 同款）", minval=0.01, step=0.01, group=G3, display=display.none)
float touchOutAtr = input.float(0.05, "触及计数出带再武装（×日ATR）", minval=0.02, step=0.01, group=G3, display=display.none)
int wallMinBars = input.int(3, "极值成墙最少10m根数（3根=30分钟）", minval=1, maxval=12, group=G3, display=display.none)

string G4 = "显示"
bool showLevels = input.bool(true, "画 ATR 梯位", group=G4, display=display.none)
bool showKeyLvls = input.bool(true, "画昨日/夜盘高低", group=G4, display=display.none)
bool showTags = input.bool(true, "右侧价签", group=G4, display=display.none)
bool showMidTags = input.bool(false, "中间梯位也标价签（±0.382~±0.786）", group=G4, display=display.none)
bool showClouds = input.bool(true, "画云与均线", group=G4, display=display.none)
bool showMomoDot = input.bool(true, "显示机会灯小圆点", group=G4, display=display.none)
bool showCard = input.bool(true, "显示状态卡", group=G4, display=display.none)
bool yieldToSaty = input.bool(true, "同屏 Saty：锚/盒顶/盒底不画线（价签保留）", group=G4, display=display.none)
bool showEma21 = input.bool(false, "画 EMA21 细线", group=G4, display=display.none)

// v3.2 新增输入（追加在末尾，旧 in_0..in_36 序号不动）
bool useFade = input.bool(true, "动能衰减（价新高/新低·振荡器没跟上）", group=G2, display=display.none)
int fadeLookback = input.int(10, "衰减窗口（10m根｜10根=buddy 的 100 分钟窗）", minval=6, maxval=30, group=G3, display=display.none)
float fadeMinDrop = input.float(1.0, "衰减最小振荡器差（buddy 同款:1.0）", minval=0.5, step=0.5, group=G3, display=display.none)
float fadeNearExt = input.float(0.06, "衰减须贴日高低距离（×日ATR）", minval=0.02, step=0.01, group=G3, display=display.none)
float fadeNearRung = input.float(0.12, "衰减或贴梯位距离（×日ATR）", minval=0.05, step=0.01, group=G3, display=display.none)

// ---------------- 色板（console 方案 D 中性灰，全站禁暖色）----------------
color INK1 = color.rgb(244, 244, 245)      // 主数值/锚
color INK2 = color.rgb(212, 212, 216)      // 正文/关键位
color INK3 = color.rgb(161, 161, 170)      // 次要/刻度
color LINEC = color.rgb(85, 85, 94)        // 盒边
color HAIRC = color.rgb(63, 63, 70)        // 中间梯位/装饰线
color UPC = color.rgb(61, 214, 140)        // 涨/守住
color DNC = color.rgb(244, 98, 106)        // 跌/拒绝
color UPDIM = color.rgb(29, 92, 64)
color DNDIM = color.rgb(110, 34, 41)
color CARDBG = color.rgb(24, 24, 27)

// ---------------- 基础序列（System 口径）----------------
float e8 = ta.ema(close, 8)
float e13 = ta.ema(close, 13)
float e21 = ta.ema(close, 21)
float e34 = ta.ema(close, 34)
float e48 = ta.ema(close, 48)
// 快带 8/13：排列的前两条，回踩-收回模块的触带（旧 5/12 hl2 弃用）
float fastU = math.max(e8, e13)
float fastL = math.min(e8, e13)
// 慢云 34/48：System 每张卡引用的"慢云上/内/下"
float slowTop = math.max(e34, e48)
float slowBot = math.min(e34, e48)
bool stackBull = e8 > e13 and e13 > e21 and e21 > e34 and e34 > e48
bool stackBear = e8 < e13 and e13 < e21 and e21 < e34 and e34 < e48
// 回踩模块方向门：慢云上+云序多头（对应 System"慢云上·多头排列"的核心两条）
bool slowUp = e34 > e48 and close > slowTop
bool slowDn = e34 < e48 and close < slowBot
float rsi14 = ta.rsi(close, 14)
// Saty 相位振荡器（=buddy engine._phase：EMA3((close-EMA21)/(3*ATR14)*100)，本图 TF 口径）
float atrTf = ta.atr(14)
float phaseRaw = not na(atrTf) and atrTf > 0 and not na(e21) ? (close - e21) / (3 * atrTf) * 100 : 0.0
float phase = ta.ema(phaseRaw, 3)

// 已完成日线（[1]+lookahead=昨日完成值，因果安全）：ATR14 / 昨收锚 / 昨高低
[atrD, pcD, ydHi, ydLo] = request.security(syminfo.tickerid, "D", [ta.atr(14)[1], close[1], high[1], low[1]], lookahead=barmerge.lookahead_on)

// 盒（=System 盒顶/盒底）
float LT = pcD - trigPct * atrD
float UT = pcD + trigPct * atrD

// ---------------- 时段 ----------------
bool inUserSession = not na(time(timeframe.period, sigSession, "America/New_York"))
bool inPre = not na(time(timeframe.period, "0800-0930", "America/New_York"))
bool signalWindow = inUserSession or (includePre and inPre)
bool is10m = timeframe.isintraday and timeframe.period == "10"
bool canSignal = barstate.isconfirmed and is10m and signalWindow

int hhmmET = hour(time, "America/New_York") * 100 + minute(time, "America/New_York")
bool newDayET = ta.change(dayofmonth(time, "America/New_York")) != 0
bool inRth = hhmmET >= 930 and hhmmET < 1600

// 日界标记：用"今天第一根 RTH bar"，不用 930 判等（该 bar 缺失时全部重置都不发生）
var int rthDayStamp = na
bool newRthDay = false
if barstate.isconfirmed and is10m and inRth
    int dNow_ = dayofmonth(time, "America/New_York")
    if na(rthDayStamp) or rthDayStamp != dNow_
        newRthDay := true
        rthDayStamp := dNow_
// 交易日界（18:00 ET 换会话）：守住位/日墙的清理时点，与 buddy 日界一致
bool newTradeDay = hhmmET >= 1800 and hhmmET[1] < 1800

var string lastSignalText = "—"
var int todayCount = 0
if barstate.isconfirmed and newDayET
    todayCount := 0

// 最近一次方向性事件的存活状态（供状态卡；不追踪你是否真的进场）
var int lastSigDir = 0
var float lastSigStop = na
var int lastSigBar = na
var bool lastSigLive = false
if barstate.isconfirmed and lastSigLive
    bool sigStopped = lastSigDir == 1 ? close < lastSigStop : close > lastSigStop
    if sigStopped or bar_index - lastSigBar > 24 or newRthDay
        lastSigLive := false

// 每个模块独立通道：共享通道会让同 bar 双信号时 alert 显示别人的止损价
var float tEntryP = na
var float tStopP = na
var float tRefP = na
var float oEntryP = na
var float oStopP = na
var float lEntryP = na
var float lStopP = na

// ---------------- 位登记表（梯位13 + 昨高低/夜盘高低4 + 日墙2 = 19 槽）----------------
// 触及计数=engine 08-24 插针口径：整根K高低碰位带（K跨位=距离0）进带记 1 次，
// 出带 >touchOut 才能再计。价换=计数清零（engine 帧指纹同思想）。
var float[] RUNG_R = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0, -0.236, -0.382, -0.5, -0.618, -0.786, -1.0)
var string[] lvNm = array.from("锚", "盒顶", "+0.382", "+0.5", "+0.618", "+0.786", "+1ATR", "盒底", "-0.382", "-0.5", "-0.618", "-0.786", "-1ATR", "昨高", "昨低", "夜高", "夜低", "日高墙", "日低墙")
var float[] lvPx = array.new_float(19, na)
var int[] lvN = array.new_int(19, 0)
var bool[] lvIn = array.new_bool(19, false)
var float[] lvRsi = array.new_float(19, na)   // 每槽上次触及时的 RSI（机会灯比较用）

f_setLv(int i_, float p_) =>
    float old_ = array.get(lvPx, i_)
    if na(p_)
        if not na(old_)
            array.set(lvPx, i_, na)
            array.set(lvN, i_, 0)
            array.set(lvIn, i_, false)
            array.set(lvRsi, i_, na)
    else if na(old_) or math.abs(p_ - old_) > syminfo.mintick / 2
        array.set(lvPx, i_, p_)
        array.set(lvN, i_, 0)
        array.set(lvIn, i_, false)
        array.set(lvRsi, i_, na)

// 梯位槽：锚或ATR换值（=换交易日帧）才重算，帧内一动不动
bool frameChg = barstate.isconfirmed and not na(pcD) and not na(atrD) and (na(pcD[1]) or na(atrD[1]) or pcD != pcD[1] or atrD != atrD[1])
if frameChg
    for ri = 0 to 12
        f_setLv(ri, pcD + array.get(RUNG_R, ri) * atrD)

// ---------------- 1) 回踩-收回（结构事件·n=979 无机械优势）----------------
var int tState = 0
var int tDir = 0
var float tExcRef = na
var float tExc = na
var float tTouchLo = na
var int tAge = 0
bool trendLongSig = false
bool trendShortSig = false
float trendStop = na

if barstate.isconfirmed and is10m and inRth
    if newRthDay
        tState := 0
        tDir := 0
    if tDir == 1 and not slowUp
        tState := 0
        tDir := 0
    if tDir == -1 and not slowDn
        tState := 0
        tDir := 0
    if tState == 0
        if slowUp and low > fastU
            tState := 1
            tDir := 1
            tExcRef := fastU
            tExc := high
        else if slowDn and high < fastL and useShort
            tState := 1
            tDir := -1
            tExcRef := fastL
            tExc := low
    else if tState == 1
        tExc := tDir == 1 ? math.max(tExc, high) : math.min(tExc, low)
        bool farEnough = tDir == 1 ? tExc - tExcRef >= departMinAtr * atrD : tExcRef - tExc >= departMinAtr * atrD
        bool touched = tDir == 1 ? low <= fastU : high >= fastL
        if touched
            if farEnough
                tState := 2
                tTouchLo := tDir == 1 ? low : high
                tAge := 0
            else
                tState := 0
                tDir := 0
    else if tState == 2
        tAge += 1
        tTouchLo := tDir == 1 ? math.min(tTouchLo, low) : math.max(tTouchLo, high)
        bool reclaim = tDir == 1 ? close > fastU and close > open : close < fastL and close < open
        if reclaim
            float stopBuf = math.max(syminfo.mintick * 2, 0.002 * atrD)
            trendStop := tDir == 1 ? tTouchLo - stopBuf : tTouchLo + stopBuf
            if canSignal and useTrend
                trendLongSig := tDir == 1
                trendShortSig := tDir == -1
            tState := 0
            tDir := 0
        else if tAge >= reclaimBars
            tState := 0
            tDir := 0

// ---------------- 2) 开盘下杀-快速收复（默认关）----------------
var float o930 = na
var float openHi = na
var float openLo = na
var bool openDipped = false
var bool openPopped = false
var bool openFired = false
bool openRevSig = false
bool openRevShortSig = false
float openStop = na

if barstate.isconfirmed and is10m
    if newRthDay
        o930 := na
        openHi := na
        openLo := na
        openDipped := false
        openPopped := false
        openFired := false
    if hhmmET >= 920 and hhmmET <= openEndHHMM
        openHi := na(openHi) ? high : math.max(openHi, high)
        openLo := na(openLo) ? low : math.min(openLo, low)
        if hhmmET == 930
            o930 := open
        if not na(o930) and low < o930
            openDipped := true
        if not na(o930) and high > o930
            openPopped := true
        bool dipDeep = not na(openLo) and not na(o930) and o930 - openLo >= openDipAtr * atrD
        bool popDeep = not na(openHi) and not na(o930) and openHi - o930 >= openDipAtr * atrD
        if not openFired and hhmmET >= 930 and not na(o930)
            if useOpen and dipDeep and openDipped and close > o930 and close > open
                openStop := openLo - math.max(syminfo.mintick * 2, 0.002 * atrD)
                if canSignal
                    openRevSig := true
                openFired := true
            else if useOpenS and useShort and popDeep and openPopped and close < o930 and close < open
                openStop := openHi + math.max(syminfo.mintick * 2, 0.002 * atrD)
                if canSignal
                    openRevShortSig := true
                openFired := true

// ---------------- 3) 盒边反应（±0.236·n=292 无机械优势）----------------
var bool lvlArmedL = true
var bool lvlArmedU = true
var int lvlCountL = 0
var int lvlCountU = 0
var int lvlPend = 0
var int lvlAge = 0
var float lvlEpLo = na
var float lvlEpHi = na
bool lvlBounceSig = false
bool lvlRejectSig = false
float lvlStop = na

if barstate.isconfirmed and is10m and inRth
    if newRthDay
        lvlArmedL := true
        lvlArmedU := true
        lvlCountL := 0
        lvlCountU := 0
        lvlPend := 0
    if not lvlArmedL and lvlPend == 0 and low > LT + rearmAtr * atrD and lvlCountL < 2
        lvlArmedL := true
    if not lvlArmedU and lvlPend == 0 and high < UT - rearmAtr * atrD and lvlCountU < 2
        lvlArmedU := true
    if lvlPend == 0
        if lvlArmedL and low <= LT
            lvlPend := 1
            lvlAge := 0
            lvlEpLo := low
            lvlEpHi := high
            lvlArmedL := false
            lvlCountL += 1
        else if lvlArmedU and high >= UT and useShort
            lvlPend := -1
            lvlAge := 0
            lvlEpLo := low
            lvlEpHi := high
            lvlArmedU := false
            lvlCountU += 1
    if lvlPend != 0
        lvlAge += 1
        lvlEpLo := math.min(lvlEpLo, low)
        lvlEpHi := math.max(lvlEpHi, high)
        bool react = lvlPend == 1 ? close > LT : close < UT
        bool broken = lvlPend == 1 ? close < LT - 0.10 * atrD : close > UT + 0.10 * atrD
        if react and lvlAge <= 3
            lvlStop := lvlPend == 1 ? lvlEpLo - math.max(syminfo.mintick * 2, 0.002 * atrD) : lvlEpHi + math.max(syminfo.mintick * 2, 0.002 * atrD)
            if canSignal and useLevel
                lvlBounceSig := lvlPend == 1
                lvlRejectSig := lvlPend == -1
            lvlPend := 0
        else if broken or lvlAge > 3
            lvlPend := 0

// ---------------- 4) RSI 背离（参数=2年回测胜出变体；与 buddy 动能衰减是
//                    不同检测器，刻意不同名，免得与推送对不上）----------------
float ph = ta.pivothigh(high, 2, 2)
float pl = ta.pivotlow(low, 3, 3)
var float lastPhPrice = na
var float lastPhRsi = na
var int lastPhBar = na
var float lastPlPrice = na
var float lastPlRsi = na
var int lastPlBar = na
bool bearDivSig = false
bool bullDivSig = false

if barstate.isconfirmed and is10m and not na(ph)
    float phRsi = rsi14[2]
    if not na(lastPhPrice) and ph > lastPhPrice and phRsi < lastPhRsi - divMinRsiTop and bar_index - lastPhBar <= 30
        if canSignal and useDiv
            bearDivSig := true
    lastPhPrice := ph
    lastPhRsi := phRsi
    lastPhBar := bar_index

if barstate.isconfirmed and is10m and not na(pl)
    float plRsi = rsi14[3]
    if not na(lastPlPrice) and pl < lastPlPrice and plRsi > lastPlRsi + divMinRsiBot and bar_index - lastPlBar <= 30 and fastL - pl > 0.15 * atrD
        if canSignal and useDiv
            bullDivSig := true
    lastPlPrice := pl
    lastPlRsi := plRsi
    lastPlBar := bar_index

// 警示状态（状态卡常驻——图上标记会滚走，"别追高"得留住）
var int cautionBar = na
var int cautionKind = 0     // 1=顶背离 2=底背离 3=极端超买
var string cautionTime = ""
if barstate.isconfirmed and is10m
    if bearDivSig
        cautionBar := bar_index
        cautionKind := 1
        cautionTime := str.format_time(time, "HH:mm", "America/New_York")
    else if bullDivSig
        cautionBar := bar_index
        cautionKind := 2
        cautionTime := str.format_time(time, "HH:mm", "America/New_York")
    else if inRth and rsi14 >= 85 and (na(cautionBar) or bar_index - cautionBar > 6)
        cautionBar := bar_index
        cautionKind := 3
        cautionTime := str.format_time(time, "HH:mm", "America/New_York")

// ---------------- 5) 夜盘风险评分（唯一样本外验证模块）----------------
var float dayHi = na
var float dayLo = na
var float dayOpen = na
var float dayVol = na
var float riskScore = na
var int riskSettledDay = na
bool riskWarnSig = false

if barstate.isconfirmed and is10m and inRth
    if newRthDay or na(dayOpen)
        dayOpen := open
        dayHi := high
        dayLo := low
        dayVol := nz(volume)
    else
        dayHi := math.max(nz(dayHi, high), high)
        dayLo := math.min(nz(dayLo, low), low)
        dayVol := nz(dayVol) + nz(volume)

var float volBaseLive = na
var array<float> volHist = array.new_float(0)
var array<float> atrHist = array.new_float(0)

// 结算=15:50 那根 RTH bar，每天一次。半日市没有 15:50 bar → 当晚不结算不发警报
// （刻意的失败方式：漏一次提醒好过给一个错的）。
int etDay = dayofmonth(time, "America/New_York")
bool isLastRthBar = inRth and hhmmET >= 1550 and (na(riskSettledDay) or riskSettledDay != etDay)
if barstate.isconfirmed and is10m and useRisk and isLastRthBar and not na(atrD) and not na(dayHi) and not na(dayOpen)
    float rng = dayHi - dayLo
    float volBase = array.size(volHist) >= 20 ? array.avg(volHist) : na
    float atrBase = array.size(atrHist) >= 5 ? array.avg(array.slice(atrHist, math.max(0, array.size(atrHist) - 5), array.size(atrHist))) : na
    if rng > 0 and atrD > 0 and not na(atrBase)
        float zRange = (rng / atrD - 0.90) / 0.35
        float zClosePos = ((close - dayLo) / rng - 0.56) / 0.26
        float zNet = ((close - dayOpen) / atrD - 0.00) / 0.55
        float zLastHr = (math.abs(close - open[6]) / atrD - 0.16) / 0.16
        bool volUsable = not na(volBase) and volBase > 0 and nz(dayVol) > 0
        volBaseLive := volUsable ? volBase : na
        float zVol = volUsable ? (nz(dayVol) / math.max(volBase, 1) - 1.10) / 0.40 : 0.0
        float zAtrTrend = (atrD / math.max(atrBase, 0.01) - 1.00) / 0.06
        riskScore := 3.61 * zRange - 2.58 * zClosePos - 2.71 * zNet + 2.40 * zLastHr + 2.33 * zVol + 2.11 * zAtrTrend
        if riskScore >= riskThr
            riskWarnSig := true
    riskSettledDay := etDay
    array.push(volHist, nz(dayVol))
    array.push(atrHist, atrD)
    if array.size(volHist) > 90
        array.shift(volHist)
    if array.size(atrHist) > 90
        array.shift(atrHist)
    dayOpen := na
    dayHi := na
    dayLo := na
    dayVol := na

// ---------------- 6) 夜盘异动哨兵（16:00→09:30 距 RTH 末收盘）----------------
var float nightRef = na
var bool nightFiredUp = false
var bool nightFiredDn = false
var bool wasNight = false
bool nightDownSig = false
bool nightUpSig = false
bool inNight = hhmmET >= 1600 or hhmmET < 930

if barstate.isconfirmed and is10m
    if not inNight
        nightRef := close
    bool nightGapResume = inNight and wasNight and not na(time[1]) and time - time[1] > 3 * 3600000
    if (inNight and not wasNight) or nightGapResume
        nightFiredUp := false
        nightFiredDn := false
    wasNight := inNight
    if useNight and inNight and not na(nightRef) and not na(atrD)
        float nightDiff = close - nightRef
        if not nightFiredDn and nightDiff <= -nightThr * atrD
            nightDownSig := true
            nightFiredDn := true
        if not nightFiredUp and nightDiff >= nightThr * atrD
            nightUpSig := true
            nightFiredUp := true

// ---------------- 7) 夜盘高低（System 交易日窗口 18:00→09:30）----------------
// 累积期实时跟随（夜里就能看到正在生长的极值线），09:30 定格为当日常量。
var float nightAccHi = na
var float nightAccLo = na
var bool wasNightAcc = false
var float dNightHi = na
var float dNightLo = na

if barstate.isconfirmed and is10m
    bool inNightAcc = hhmmET >= 1800 or hhmmET < 930
    if inNightAcc
        if not wasNightAcc
            nightAccHi := high
            nightAccLo := low
        else
            nightAccHi := math.max(nz(nightAccHi, high), high)
            nightAccLo := math.min(nz(nightAccLo, low), low)
    wasNightAcc := inNightAcc
    if inNightAcc and not na(nightAccHi)
        dNightHi := nightAccHi
        dNightLo := nightAccLo
    if newRthDay
        // 定格并清空累计器：某天缺盘外 bar 时不把前一天的值当今天的
        dNightHi := nightAccHi
        dNightLo := nightAccLo
        nightAccHi := na
        nightAccLo := na
    // 登记表：昨高低=日线[1]完成值实时可知；夜盘高低跟随/定格（价换=计数清零）
    f_setLv(13, ydHi)
    f_setLv(14, ydLo)
    f_setLv(15, dNightHi)
    f_setLv(16, dNightLo)

// ---------------- 8) 当日累计 + 日高低重测墙（walls.py 08-24 口径）----------------
var float dayRunHi = na
var float dayRunLo = na
bool hiRefreshed = false
bool loRefreshed = false
if barstate.isconfirmed and is10m and inRth
    if newRthDay or na(dayRunHi)
        dayRunHi := high
        dayRunLo := low
        hiRefreshed := true
        loRefreshed := true
    else
        if high > dayRunHi
            dayRunHi := high
            hiRefreshed := true
        if low < dayRunLo
            dayRunLo := low
            loRefreshed := true

// 极值 ≥wallMinBars 根未刷新 → 成墙画线；新极值=旧墙作废重新计时（换位可再报）
var line wallHiLn = na
var line wallLoLn = na
var int hiAge = 0
var int loAge = 0
if barstate.isconfirmed and is10m and useWalls
    if newTradeDay or newRthDay
        hiAge := 0
        loAge := 0
        if not na(wallHiLn)
            line.delete(wallHiLn)
            wallHiLn := na
        if not na(wallLoLn)
            line.delete(wallLoLn)
            wallLoLn := na
        f_setLv(17, na)
        f_setLv(18, na)
    if inRth and not na(dayRunHi)
        if hiRefreshed
            hiAge := 0
            if not na(wallHiLn)
                line.delete(wallHiLn)
                wallHiLn := na
            f_setLv(17, na)
        else
            hiAge += 1
            if hiAge >= wallMinBars and na(wallHiLn)
                wallHiLn := line.new(bar_index - hiAge, dayRunHi, bar_index, dayRunHi, extend=extend.right, color=color.new(INK3, 25), width=1)
                f_setLv(17, dayRunHi)
        if loRefreshed
            loAge := 0
            if not na(wallLoLn)
                line.delete(wallLoLn)
                wallLoLn := na
            f_setLv(18, na)
        else
            loAge += 1
            if loAge >= wallMinBars and na(wallLoLn)
                wallLoLn := line.new(bar_index - loAge, dayRunLo, bar_index, dayRunLo, extend=extend.right, color=color.new(INK3, 25), width=1)
                f_setLv(18, dayRunLo)

// 机会灯旗标（登记表计数循环与守住簇共用，先声明）
bool holdMomoLongSig = false
bool holdMomoShortSig = false
bool momoDotL = false
bool momoDotR = false
var float hSupLvlP = na
var float hResLvlP = na

// ---------------- 9) 触及计数（全时段，engine 插针口径）----------------
if barstate.isconfirmed and is10m and not na(atrD) and atrD > 0
    for ci = 0 to 18
        float lp2 = array.get(lvPx, ci)
        if not na(lp2)
            float d2 = (low - lp2) * (high - lp2) <= 0 ? 0.0 : math.min(math.abs(low - lp2), math.abs(high - lp2))
            if not array.get(lvIn, ci) and d2 <= touchInAtr * atrD
                int nN_ = array.get(lvN, ci) + 1
                array.set(lvN, ci, nN_)
                array.set(lvIn, ci, true)
                // 梯位机会灯（=engine 位守住/位压住语义）：同一位第 ≥2 次触及，
                // 插针守住（低点刺穿、收盘收回其上）且 RSI 比上次触及更高 → 蓄力；压力侧镜像
                float pRsi_ = array.get(lvRsi, ci)
                if nN_ >= 2 and not na(pRsi_)
                    if low <= lp2 and close > lp2 and rsi14 >= pRsi_ + momoMinRsi
                        momoDotL := true
                        if canSignal
                            holdMomoLongSig := true
                            hSupLvlP := lp2
                    else if high >= lp2 and close < lp2 and rsi14 <= pRsi_ - momoMinRsi
                        momoDotR := true
                        if canSignal
                            holdMomoShortSig := true
                            hResLvlP := lp2
                array.set(lvRsi, ci, rsi14)
            else if array.get(lvIn, ci) and d2 > touchOutAtr * atrD
                array.set(lvIn, ci, false)

// ---------------- 10) 日型（engine._daytype 10:30 一次）----------------
var string dayTypeTxt = na
var int dayTypeDay = na
if barstate.isconfirmed and is10m and inRth and hhmmET >= 1020 and (na(dayTypeDay) or dayTypeDay != rthDayStamp) and not na(atrD) and atrD > 0 and not na(dayRunHi)
    float fhRng = (dayRunHi - dayRunLo) / atrD
    bool inBox_ = math.abs(close - pcD) <= 0.236 * atrD
    bool stacked_ = stackBull or stackBear
    dayTypeTxt := fhRng >= 0.5 and stacked_ and not inBox_ ? "趋势日（首小时 " + str.tostring(fhRng, "0.00") + "ATR·" + (stackBull ? "多头排列" : "空头排列") + "·已出盒）" : fhRng <= 0.35 or inBox_ ? "区间日（首小时 " + str.tostring(fhRng, "0.00") + "ATR" + (inBox_ ? "·盒内" : "") + "）" : "不明朗（首小时 " + str.tostring(fhRng, "0.00") + "ATR）"
    dayTypeDay := rthDayStamp

// ---------------- 11) 动能衰减（=engine._fade，用户定位：止盈/止损参考）----------------
// 价创窗口新高而相位振荡器没跟上（差≥fadeMinDrop），且贴近日高/夜高（0.06×ATR）
// 或贴近梯位（0.12×ATR）才算数；45 分钟（5 根）内没有更高高点不重发。底部镜像。
// 历史结算（buddy 8-21/8-24）：顶部 RTH 4/5 命中此后不再创新高·平均续跌 11 点（小样本）；
// 底部版命中最弱，按"有多少发多少、用户自己过滤"的既定红线照发。
float winHiP = ta.highest(high, fadeLookback)
float winLoP = ta.lowest(low, fadeLookback)
float winHiPh = ta.highest(phase, fadeLookback)
float winLoPh = ta.lowest(phase, fadeLookback)
var int fadeTopBar = na
var float fadeTopHi = na
var int fadeBotBar = na
var float fadeBotLo = na
bool fadeTopSig = false
bool fadeBotSig = false
if useFade and barstate.isconfirmed and is10m and not na(atrD) and atrD > 0 and bar_index > fadeLookback + 30
    float minRungD = na
    for fi = 0 to 12
        float flp = array.get(lvPx, fi)
        if not na(flp)
            float fd = math.abs(close - flp)
            if na(minRungD) or fd < minRungD
                minRungD := fd
    bool nearRungF = not na(minRungD) and minRungD <= fadeNearRung * atrD
    // 顶：位置门=日内用当日高、盘外用夜盘累计高（=buddy rth_hi/on_hi 同构）
    float extHi = inRth ? dayRunHi : nightAccHi
    if high >= winHiP - 0.01 and phase < winHiPh - fadeMinDrop
        bool nearTopF = not na(extHi) and extHi - high <= fadeNearExt * atrD
        if (nearTopF or nearRungF) and (na(fadeTopBar) or bar_index - fadeTopBar >= 5 or high > fadeTopHi + syminfo.mintick)
            fadeTopSig := true
            fadeTopBar := bar_index
            fadeTopHi := high
    // 底：镜像
    float extLo = inRth ? dayRunLo : nightAccLo
    if low <= winLoP + 0.01 and phase > winLoPh + fadeMinDrop
        bool nearBotF = not na(extLo) and low - extLo <= fadeNearExt * atrD
        if (nearBotF or nearRungF) and (na(fadeBotBar) or bar_index - fadeBotBar >= 5 or low < fadeBotLo - syminfo.mintick)
            fadeBotSig := true
            fadeBotBar := bar_index
            fadeBotLo := low
if fadeTopSig
    cautionBar := bar_index
    cautionKind := 4
    cautionTime := str.format_time(time, "HH:mm", "America/New_York")
    lastSignalText := "动能衰减顶 " + str.format_time(time, "HH:mm", "America/New_York")
    todayCount += 1
if fadeBotSig
    cautionBar := bar_index
    cautionKind := 5
    cautionTime := str.format_time(time, "HH:mm", "America/New_York")
    lastSignalText := "动能衰减底 " + str.format_time(time, "HH:mm", "America/New_York")
    todayCount += 1

// ---------------- 信号收尾（通道值/卡片状态；图上只留小标记+夜盘小标签）----------------
if trendLongSig
    lastSignalText := "回踩收回▲ " + str.format_time(time, "HH:mm", "America/New_York")
    todayCount += 1
    tEntryP := close
    tStopP := trendStop
    tRefP := tExc
    lastSigDir := 1
    lastSigStop := trendStop
    lastSigBar := bar_index
    lastSigLive := true
if trendShortSig
    lastSignalText := "回踩收回▼ " + str.format_time(time, "HH:mm", "America/New_York")
    todayCount += 1
    tEntryP := close
    tStopP := trendStop
    tRefP := tExc
    lastSigDir := -1
    lastSigStop := trendStop
    lastSigBar := bar_index
    lastSigLive := true
if openRevSig
    lastSignalText := "开盘反转▲ " + str.format_time(time, "HH:mm", "America/New_York")
    todayCount += 1
    oEntryP := close
    oStopP := openStop
    lastSigDir := 1
    lastSigStop := openStop
    lastSigBar := bar_index
    lastSigLive := true
if openRevShortSig
    lastSignalText := "开盘回落▼ " + str.format_time(time, "HH:mm", "America/New_York")
    todayCount += 1
    oEntryP := close
    oStopP := openStop
    lastSigDir := -1
    lastSigStop := openStop
    lastSigBar := bar_index
    lastSigLive := true
if lvlBounceSig
    lastSignalText := "盒底反弹▲ " + str.format_time(time, "HH:mm", "America/New_York")
    todayCount += 1
    lEntryP := close
    lStopP := lvlStop
    lastSigDir := 1
    lastSigStop := lvlStop
    lastSigBar := bar_index
    lastSigLive := true
if lvlRejectSig
    lastSignalText := "盒顶受阻▼ " + str.format_time(time, "HH:mm", "America/New_York")
    todayCount += 1
    lEntryP := close
    lStopP := lvlStop
    lastSigDir := -1
    lastSigStop := lvlStop
    lastSigBar := bar_index
    lastSigLive := true
if bearDivSig
    lastSignalText := "顶背离 " + str.format_time(time, "HH:mm", "America/New_York")
    todayCount += 1
if bullDivSig
    lastSignalText := "底背离 " + str.format_time(time, "HH:mm", "America/New_York")
    todayCount += 1
// 夜盘/隔夜风险：罕见（合计 ≤10 次/月）且发生在无人盯盘时段，保留小标签
if riskWarnSig
    label.new(bar_index, high, "隔夜风险 " + str.tostring(riskScore, "#.#") + "｜考虑减仓", style=label.style_label_down, color=color.new(CARDBG, 15), textcolor=INK1, size=size.small)
    lastSignalText := "夜盘风险高 " + str.format_time(time, "HH:mm", "America/New_York")
if nightDownSig
    label.new(bar_index, low, "夜盘下杀 " + str.tostring(close - nightRef, "#.#") + " 点", style=label.style_label_up, color=color.new(CARDBG, 15), textcolor=DNC, size=size.small)
    lastSignalText := "夜盘下杀 " + str.format_time(time, "HH:mm", "America/New_York")
if nightUpSig
    label.new(bar_index, high, "夜盘上冲 +" + str.tostring(close - nightRef, "#.#") + " 点", style=label.style_label_down, color=color.new(CARDBG, 15), textcolor=UPC, size=size.small)
    lastSignalText := "夜盘上冲 " + str.format_time(time, "HH:mm", "America/New_York")

// ---------------- 绘制：云与均线 ----------------
pF1 = plot(showClouds ? fastU : na, "快带上沿(8/13)", display=display.none)
pF2 = plot(showClouds ? fastL : na, "快带下沿(8/13)", display=display.none)
fill(pF1, pF2, color=e8 > e13 ? color.new(UPDIM, 88) : color.new(DNDIM, 88), title="快带 8/13")
plot(showClouds and showEma21 ? e21 : na, "EMA21", color=color.new(INK3, 55), linewidth=1, display=display.pane)
pS1 = plot(showClouds ? slowTop : na, "慢云上沿(34/48)", display=display.none)
pS2 = plot(showClouds ? slowBot : na, "慢云下沿(34/48)", display=display.none)
fill(pS1, pS2, color=stackBull ? color.new(UPDIM, 78) : stackBear ? color.new(DNDIM, 78) : color.new(HAIRC, 80), title="慢云 34/48")

// ---------------- 绘制：结构事件小标记（详情看状态卡与推送）----------------
plotshape(trendLongSig, "回踩收回·多", style=shape.triangleup, location=location.belowbar, color=UPC, size=size.small, display=display.pane)
plotshape(trendShortSig, "回踩收回·空", style=shape.triangledown, location=location.abovebar, color=DNC, size=size.small, display=display.pane)
plotshape(openRevSig, "开盘反转·多", style=shape.triangleup, location=location.belowbar, color=color.new(UPC, 30), size=size.small, display=display.pane)
plotshape(openRevShortSig, "开盘回落·空", style=shape.triangledown, location=location.abovebar, color=color.new(DNC, 30), size=size.small, display=display.pane)
plotshape(lvlBounceSig, "盒底反弹", style=shape.square, location=location.belowbar, color=UPC, size=size.tiny, display=display.pane)
plotshape(lvlRejectSig, "盒顶受阻", style=shape.square, location=location.abovebar, color=DNC, size=size.tiny, display=display.pane)
plotshape(bearDivSig, "顶背离（勿追多·非做空信号）", style=shape.diamond, location=location.abovebar, color=INK3, size=size.tiny, display=display.pane)
plotshape(bullDivSig, "底背离（结构事件·非买点）", style=shape.diamond, location=location.belowbar, color=INK3, size=size.tiny, display=display.pane)

// ---------------- 隐藏通道（alert 占位，名称不可改）----------------
plot(math.round_to_mintick(tEntryP), "T_ENTRY", display=display.none)
plot(math.round_to_mintick(tStopP), "T_STOP", display=display.none)
plot(math.round_to_mintick(tRefP), "T_REF", display=display.none)
plot(math.round_to_mintick(oEntryP), "O_ENTRY", display=display.none)
plot(math.round_to_mintick(oStopP), "O_STOP", display=display.none)
plot(math.round_to_mintick(lEntryP), "L_ENTRY", display=display.none)
plot(math.round_to_mintick(lStopP), "L_STOP", display=display.none)

// ---------------- 绘制：梯位（当日一套 line.new，不参与纵轴缩放）----------------
var line[] ladderLn = array.new_line(0)
if frameChg and showLevels
    if array.size(ladderLn) > 0
        for li = 0 to array.size(ladderLn) - 1
            line.delete(array.get(ladderLn, li))
        array.clear(ladderLn)
    for ri2 = 0 to 12
        float lp3 = array.get(lvPx, ri2)
        // 同屏 Saty 让位：锚/盒顶/盒底与 Saty ATR Levels 同价，可只留价签不画线（评审建议4）
        if not na(lp3) and not (yieldToSaty and (ri2 == 0 or ri2 == 1 or ri2 == 7))
            color lc_ = ri2 == 0 ? color.new(INK2, 25) : ri2 == 1 or ri2 == 7 ? color.new(LINEC, 0) : ri2 == 6 or ri2 == 12 ? color.new(INK3, 40) : color.new(HAIRC, 0)
            int lw_ = ri2 == 0 or ri2 == 1 or ri2 == 7 ? 2 : 1
            array.push(ladderLn, line.new(bar_index, lp3, bar_index + 1, lp3, extend=extend.right, color=lc_, width=lw_))

// ---------------- 绘制：昨日/夜盘高低（值变了就全删重建，天然不重绘）----------------
var line[] keyLn = array.new_line(0)
var float keySigPrev = na
float keySigNow = nz(ydHi) * 1 + nz(ydLo) * 2 + nz(dNightHi) * 3 + nz(dNightLo) * 5
if barstate.isconfirmed and is10m and showKeyLvls and (na(keySigPrev) or keySigPrev != keySigNow)
    keySigPrev := keySigNow
    if array.size(keyLn) > 0
        for ki = 0 to array.size(keyLn) - 1
            line.delete(array.get(keyLn, ki))
        array.clear(keyLn)
    if not na(ydHi)
        array.push(keyLn, line.new(bar_index, ydHi, bar_index + 1, ydHi, extend=extend.right, color=color.new(INK2, 35), width=1, style=line.style_dashed))
    if not na(ydLo)
        array.push(keyLn, line.new(bar_index, ydLo, bar_index + 1, ydLo, extend=extend.right, color=color.new(INK2, 35), width=1, style=line.style_dashed))
    if not na(dNightHi)
        array.push(keyLn, line.new(bar_index, dNightHi, bar_index + 1, dNightHi, extend=extend.right, color=color.new(INK3, 45), width=1, style=line.style_dotted))
    if not na(dNightLo)
        array.push(keyLn, line.new(bar_index, dNightLo, bar_index + 1, dNightLo, extend=extend.right, color=color.new(INK3, 45), width=1, style=line.style_dotted))

// ---------------- 绘制：右侧价签（不透明·短文本·带触及计数）----------------
// 常驻：锚/盒顶/盒底/±1ATR/昨高低/夜高低/日墙；中间梯位默认无签，
// 但触及 ≥2 次时强制上签（证据位必须让人看见——System"今日已 N 次攻不破"同款）。
var label[] tagLs = array.new_label(0)
f_tag(float p_, string txt_, color c_, string sz_) =>
    if not na(p_)
        array.push(tagLs, label.new(bar_index + 6, p_, txt_, style=label.style_label_right, color=color.new(color.black, 100), textcolor=c_, size=sz_))

if barstate.islast and showTags
    if array.size(tagLs) > 0
        for ti = 0 to array.size(tagLs) - 1
            label.delete(array.get(tagLs, ti))
        array.clear(tagLs)
    // 梯位签
    if showLevels
        for ri3 = 0 to 12
            float tp_ = array.get(lvPx, ri3)
            if not na(tp_)
                int tn_ = array.get(lvN, ri3)
                bool core_ = ri3 == 0 or ri3 == 1 or ri3 == 7 or ri3 == 6 or ri3 == 12
                if core_ or showMidTags or tn_ >= 2
                    bool sup_ = tp_ <= close
                    string cnt_ = tn_ >= 2 ? (sup_ ? " 守住×" : " 拒绝×") + str.tostring(tn_) : ""
                    color tc_ = tn_ >= 2 ? (sup_ ? UPC : DNC) : ri3 == 0 ? INK1 : core_ ? INK2 : INK3
                    f_tag(tp_, array.get(lvNm, ri3) + " " + str.tostring(tp_, format.mintick) + cnt_, tc_, tn_ >= 2 or core_ ? size.small : size.tiny)
    // 昨日/夜盘高低签（价差 ≤0.03×ATR 合并成一条）
    if showKeyLvls and not na(atrD)
        array<float> kPx = array.from(array.get(lvPx, 13), array.get(lvPx, 14), array.get(lvPx, 15), array.get(lvPx, 16))
        array<string> kNm = array.from("昨高", "昨低", "夜高", "夜低")
        array<int> kIdx = array.from(13, 14, 15, 16)
        array<float> mPx = array.new_float(0)
        array<string> mNm = array.new_string(0)
        array<int> mN = array.new_int(0)
        for ki2 = 0 to 3
            float kp_ = array.get(kPx, ki2)
            if not na(kp_)
                bool merged_ = false
                if array.size(mPx) > 0
                    for kj = 0 to array.size(mPx) - 1
                        if not merged_ and math.abs(kp_ - array.get(mPx, kj)) <= 0.03 * atrD
                            array.set(mNm, kj, array.get(mNm, kj) + "≈" + array.get(kNm, ki2))
                            array.set(mN, kj, math.max(array.get(mN, kj), array.get(lvN, array.get(kIdx, ki2))))
                            merged_ := true
                if not merged_
                    array.push(mPx, kp_)
                    array.push(mNm, array.get(kNm, ki2))
                    array.push(mN, array.get(lvN, array.get(kIdx, ki2)))
        if array.size(mPx) > 0
            for kj2 = 0 to array.size(mPx) - 1
                int kn_ = array.get(mN, kj2)
                bool ksup_ = array.get(mPx, kj2) <= close
                string kc_ = kn_ >= 2 ? (ksup_ ? " 守住×" : " 拒绝×") + str.tostring(kn_) : ""
                f_tag(array.get(mPx, kj2), array.get(mNm, kj2) + " " + str.tostring(array.get(mPx, kj2), format.mintick) + kc_, kn_ >= 2 ? (ksup_ ? UPC : DNC) : INK2, size.small)
    // 日墙签
    if useWalls
        float wh_ = array.get(lvPx, 17)
        float wl_ = array.get(lvPx, 18)
        int whN_ = array.get(lvN, 17)
        int wlN_ = array.get(lvN, 18)
        if not na(wh_)
            f_tag(wh_, "日高墙 " + str.tostring(wh_, format.mintick) + (whN_ >= 2 ? (wh_ <= close ? " 守住×" : " 拒绝×") + str.tostring(whN_) : ""), whN_ >= 2 ? (wh_ <= close ? UPC : DNC) : INK3, size.small)
        if not na(wl_)
            f_tag(wl_, "日低墙 " + str.tostring(wl_, format.mintick) + (wlN_ >= 2 ? (wl_ <= close ? " 守住×" : " 拒绝×") + str.tostring(wlN_) : ""), wlN_ >= 2 ? (wl_ <= close ? UPC : DNC) : INK3, size.small)

// ---------------- 守住/拒绝位（pivot 种子 + 插针触及计数）+ 机会灯 ----------------
// 种子=已确认 pivot（无重绘）；贴近登记表位（0.03×ATR）的种子不建簇——那条位
// 已在计数，重复建线只添乱。触及计数与登记表同口径（进带记 1 次·出带再武装），
// 每次进带记录当根 RSI，供机会灯比较"这次触及动能是否更强"。
int holdMaxClusters = 6
var float[] sPrice = array.new_float(0)
var int[] sCount = array.new_int(0)
var float[] sLastRsi = array.new_float(0)
var int[] sFirstBar = array.new_int(0)
var bool[] sBroken = array.new_bool(0)
var bool[] sInBand = array.new_bool(0)
var line[] sLine = array.new_line(0)
var label[] sLabel = array.new_label(0)
var float[] rPrice = array.new_float(0)
var int[] rCount = array.new_int(0)
var float[] rLastRsi = array.new_float(0)
var int[] rFirstBar = array.new_int(0)
var bool[] rBroken = array.new_bool(0)
var bool[] rInBand = array.new_bool(0)
var line[] rLine = array.new_line(0)
var label[] rLabel = array.new_label(0)

// 日界=18:00 ET 新交易会话（与 buddy 一致）：夜盘攒的守住位开盘要带着，勿在 09:30 清
if barstate.isconfirmed and is10m and newTradeDay
    if array.size(sLine) > 0
        for j = 0 to array.size(sLine) - 1
            line lnD = array.get(sLine, j)
            if not na(lnD)
                line.delete(lnD)
            label lbD = array.get(sLabel, j)
            if not na(lbD)
                label.delete(lbD)
    if array.size(rLine) > 0
        for j = 0 to array.size(rLine) - 1
            line lnD2 = array.get(rLine, j)
            if not na(lnD2)
                line.delete(lnD2)
            label lbD2 = array.get(rLabel, j)
            if not na(lbD2)
                label.delete(lbD2)
    array.clear(sPrice)
    array.clear(sCount)
    array.clear(sLastRsi)
    array.clear(sFirstBar)
    array.clear(sBroken)
    array.clear(sInBand)
    array.clear(sLine)
    array.clear(sLabel)
    array.clear(rPrice)
    array.clear(rCount)
    array.clear(rLastRsi)
    array.clear(rFirstBar)
    array.clear(rBroken)
    array.clear(rInBand)
    array.clear(rLine)
    array.clear(rLabel)

// 种子是否贴近登记表位
f_nearRegistry(float p_) =>
    bool near_ = false
    if not na(atrD)
        for gi = 0 to 18
            float gp_ = array.get(lvPx, gi)
            if not na(gp_) and math.abs(p_ - gp_) <= 0.03 * atrD
                near_ := true
    near_

// 支撑侧种子：已确认 pivot 低点
if useHold and barstate.isconfirmed and is10m and not na(pl) and not na(atrD)
    bool dupS = false
    if array.size(sPrice) > 0
        for j = 0 to array.size(sPrice) - 1
            if not array.get(sBroken, j) and math.abs(pl - array.get(sPrice, j)) <= holdTolAtr * atrD
                dupS := true
    if not dupS and not f_nearRegistry(pl) and array.size(sPrice) < holdMaxClusters
        array.push(sPrice, pl)
        array.push(sCount, 1)
        array.push(sLastRsi, rsi14[3])
        array.push(sFirstBar, bar_index - 3)
        array.push(sBroken, false)
        array.push(sInBand, true)
        array.push(sLine, line(na))
        array.push(sLabel, label(na))

// 压力侧种子：已确认 pivot 高点
if useHold and barstate.isconfirmed and is10m and not na(ph) and not na(atrD)
    bool dupR = false
    if array.size(rPrice) > 0
        for j = 0 to array.size(rPrice) - 1
            if not array.get(rBroken, j) and math.abs(ph - array.get(rPrice, j)) <= holdTolAtr * atrD
                dupR := true
    if not dupR and not f_nearRegistry(ph) and array.size(rPrice) < holdMaxClusters
        array.push(rPrice, ph)
        array.push(rCount, 1)
        array.push(rLastRsi, rsi14[2])
        array.push(rFirstBar, bar_index - 2)
        array.push(rBroken, false)
        array.push(rInBand, true)
        array.push(rLine, line(na))
        array.push(rLabel, label(na))

// 簇触及计数（插针口径）+ 上线/升级 + 机会灯 + 收破冻结
if useHold and barstate.isconfirmed and is10m and not na(atrD) and atrD > 0
    if array.size(sPrice) > 0
        for j = 0 to array.size(sPrice) - 1
            if not array.get(sBroken, j)
                float sp_ = array.get(sPrice, j)
                float sd_ = (low - sp_) * (high - sp_) <= 0 ? 0.0 : math.min(math.abs(low - sp_), math.abs(high - sp_))
                if not array.get(sInBand, j) and sd_ <= touchInAtr * atrD
                    array.set(sInBand, j, true)
                    int sN = array.get(sCount, j) + 1
                    array.set(sCount, j, sN)
                    float sPrevRsi = array.get(sLastRsi, j)
                    array.set(sLastRsi, j, rsi14)
                    if sN == 2
                        array.set(sLine, j, line.new(array.get(sFirstBar, j), sp_, bar_index, sp_, extend=extend.right, color=color.new(UPC, 35), width=2))
                        array.set(sLabel, j, label.new(bar_index + 6, sp_, "守住×2", style=label.style_label_right, color=color.new(color.black, 100), textcolor=UPC, size=size.small))
                    else if sN >= 3 and not na(array.get(sLabel, j))
                        label.set_text(array.get(sLabel, j), "守住×" + str.tostring(sN))
                    if sN >= 2 and rsi14 >= sPrevRsi + momoMinRsi
                        momoDotL := true
                        if canSignal
                            holdMomoLongSig := true
                            hSupLvlP := sp_
                else if array.get(sInBand, j) and sd_ > touchOutAtr * atrD
                    array.set(sInBand, j, false)
                if close < sp_ - holdBreakAtr * atrD
                    array.set(sBroken, j, true)
                    line sLn = array.get(sLine, j)
                    if not na(sLn)
                        line.set_style(sLn, line.style_dashed)
                        line.set_color(sLn, color.new(UPC, 80))
                        line.set_extend(sLn, extend.none)
                        line.set_x2(sLn, bar_index)
                    label sLb = array.get(sLabel, j)
                    if not na(sLb)
                        label.set_text(sLb, "已破·守过×" + str.tostring(array.get(sCount, j)))
                        label.set_textcolor(sLb, INK3)
    if array.size(rPrice) > 0
        for j = 0 to array.size(rPrice) - 1
            if not array.get(rBroken, j)
                float rp_ = array.get(rPrice, j)
                float rd_ = (low - rp_) * (high - rp_) <= 0 ? 0.0 : math.min(math.abs(low - rp_), math.abs(high - rp_))
                if not array.get(rInBand, j) and rd_ <= touchInAtr * atrD
                    array.set(rInBand, j, true)
                    int rN = array.get(rCount, j) + 1
                    array.set(rCount, j, rN)
                    float rPrevRsi = array.get(rLastRsi, j)
                    array.set(rLastRsi, j, rsi14)
                    if rN == 2
                        array.set(rLine, j, line.new(array.get(rFirstBar, j), rp_, bar_index, rp_, extend=extend.right, color=color.new(DNC, 35), width=2))
                        array.set(rLabel, j, label.new(bar_index + 6, rp_, "拒绝×2", style=label.style_label_right, color=color.new(color.black, 100), textcolor=DNC, size=size.small))
                    else if rN >= 3 and not na(array.get(rLabel, j))
                        label.set_text(array.get(rLabel, j), "拒绝×" + str.tostring(rN))
                    if rN >= 2 and rsi14 <= rPrevRsi - momoMinRsi
                        momoDotR := true
                        if canSignal
                            holdMomoShortSig := true
                            hResLvlP := rp_
                else if array.get(rInBand, j) and rd_ > touchOutAtr * atrD
                    array.set(rInBand, j, false)
                if close > rp_ + holdBreakAtr * atrD
                    array.set(rBroken, j, true)
                    line rLn = array.get(rLine, j)
                    if not na(rLn)
                        line.set_style(rLn, line.style_dashed)
                        line.set_color(rLn, color.new(DNC, 80))
                        line.set_extend(rLn, extend.none)
                        line.set_x2(rLn, bar_index)
                    label rLb = array.get(rLabel, j)
                    if not na(rLb)
                        label.set_text(rLb, "已破·拒过×" + str.tostring(array.get(rCount, j)))
                        label.set_textcolor(rLb, INK3)

// 守住位标签跟随最右端
if barstate.islast and useHold
    if array.size(sLabel) > 0
        for j = 0 to array.size(sLabel) - 1
            label sLb2 = array.get(sLabel, j)
            if not na(sLb2)
                label.set_x(sLb2, bar_index + 6)
    if array.size(rLabel) > 0
        for j = 0 to array.size(rLabel) - 1
            label rLb2 = array.get(rLabel, j)
            if not na(rLb2)
                label.set_x(rLb2, bar_index + 6)

// ---------------- 状态卡（7 行，System 词汇）----------------
var table card = table.new(position.bottom_right, 2, 8, bgcolor=color.new(CARDBG, 0), frame_color=HAIRC, frame_width=1)
if barstate.islast
    if showCard
        // 结构行：慢云位置 + 排列（=System 每张卡的 ctx 行）
        string cloudPosTxt = close > slowTop ? "慢云上" : close < slowBot ? "慢云下" : "慢云内"
        string stackTxt = stackBull ? "多头排列" : stackBear ? "空头排列" : "交错"
        // 位置行：对锚比率 + ATR 已用
        float ratio_ = not na(atrD) and atrD > 0 ? (close - pcD) / atrD : na
        string ratioTxt = na(ratio_) ? "—" : (ratio_ >= 0 ? "锚上 +" : "锚下 ") + str.tostring(ratio_, "0.00") + "ATR"
        float dayUsed = na(dayRunHi) or na(dayRunLo) ? na : dayRunHi - dayRunLo
        string atrUsedTxt = na(dayUsed) or na(atrD) or atrD <= 0 ? "" : "｜已用 " + str.tostring(dayUsed / atrD, "0.00") + "ATR" + (dayUsed >= atrD ? "·走满日幅" : dayUsed >= 0.7 * atrD ? "·已走七成" : "")
        // 下一位（从登记表挑最近的上/下一条，带触及计数）
        float nxtUp = na
        string nxtUpTxt = ""
        float nxtDn = na
        string nxtDnTxt = ""
        for ni = 0 to 18
            float np_ = array.get(lvPx, ni)
            if not na(np_)
                if np_ > close and (na(nxtUp) or np_ < nxtUp)
                    nxtUp := np_
                    nxtUpTxt := array.get(lvNm, ni) + " " + str.tostring(np_, format.mintick) + (array.get(lvN, ni) >= 2 ? "(×" + str.tostring(array.get(lvN, ni)) + ")" : "")
                if np_ < close and (na(nxtDn) or np_ > nxtDn)
                    nxtDn := np_
                    nxtDnTxt := array.get(lvNm, ni) + " " + str.tostring(np_, format.mintick) + (array.get(lvN, ni) >= 2 ? "(×" + str.tostring(array.get(lvN, ni)) + ")" : "")
        string nxtTxt = "↓" + (nxtDnTxt == "" ? "—" : nxtDnTxt) + "｜↑" + (nxtUpTxt == "" ? "—" : nxtUpTxt)
        // 接下来看（状态机下一个转移条件讲成人话）
        string bearNeed = not na(lastPhPrice) and bar_index - lastPhBar <= 30 ? "顶背离需:高过 " + str.tostring(lastPhPrice, format.mintick) + " 且RSI<" + str.tostring(lastPhRsi - divMinRsiTop, "#.#") : "等新的确认高点"
        string bullNeed = not na(lastPlPrice) and bar_index - lastPlBar <= 30 ? "底背离需:跌破 " + str.tostring(lastPlPrice, format.mintick) + " 且RSI>" + str.tostring(lastPlRsi + divMinRsiBot, "#.#") : "等新的确认低点"
        string watchTxt = not is10m ? "请切到 10 分钟图" : tState == 1 and tDir == 1 ? "已离快带｜回落触 8/13 带后等阳线收回带上" : tState == 1 and tDir == -1 ? "已离快带｜反抽触 8/13 带后等阴线收回带下" : tState == 2 and tDir == 1 ? "回踩中｜" + str.tostring(reclaimBars - tAge, "#0") + " 根内收回带上才算数" : tState == 2 and tDir == -1 ? "反抽中｜" + str.tostring(reclaimBars - tAge, "#0") + " 根内收回带下才算数" : lvlPend == 1 ? "触盒底｜3 根内收回其上=反弹，否则作废" : lvlPend == -1 ? "触盒顶｜3 根内收回其下=受阻，否则作废" : close > UT ? "盒上运行｜" + bearNeed : close < LT ? "盒下运行｜" + bullNeed : "盒内｜方向未定，等站上盒顶/跌破盒底"
        // 警示行
        int cautionAge = na(cautionBar) ? 9999 : bar_index - cautionBar
        string cautionTxt = cautionKind == 1 and cautionAge <= 12 ? "顶背离 " + cautionTime + "｜勿追多·勿加仓（非做空信号）" : cautionKind == 2 and cautionAge <= 12 ? "底背离 " + cautionTime + "｜结构事件·非买点" : cautionKind == 3 and cautionAge <= 6 ? "极端超买 " + cautionTime + "｜勿追·也勿做空" : cautionKind == 4 and cautionAge <= 12 ? "动能衰减(顶) " + cautionTime + "｜价新高动能没跟上·考虑部分止盈" : cautionKind == 5 and cautionAge <= 12 ? "动能衰减(底) " + cautionTime + "｜价新低动能没跟上·杀跌性价比降" : "—"
        bool cautionOn = cautionTxt != "—"
        // 持仓行
        string posTxt2 = lastSigLive ? (lastSigDir == 1 ? "多" : "空") + "·守 " + str.tostring(lastSigStop, format.mintick) + "（现距 " + str.tostring(math.abs(close - lastSigStop), "#.#") + " 点）" : "—"
        // 日型行：只有本 RTH 日判定过才算"今天的"；次日 10:30 前显示待判定，
        // 盘外显示"昨日："前缀——别把昨天的日型当今天的（面板≠TG 教训同款）
        bool dtIsToday = not na(dayTypeDay) and not na(rthDayStamp) and dayTypeDay == rthDayStamp
        string dtDisp = na(dayTypeTxt) ? "—（10:30 判定）" : inRth ? (dtIsToday ? dayTypeTxt : "—（10:30 判定）") : "昨日：" + dayTypeTxt
        // 隔夜风险行
        string featTxt = na(volBaseLive) or volBaseLive <= 0 ? "（5/6特征）" : ""
        string riskTxt = na(riskScore) ? "—（15:50 结算）" : (na(riskSettledDay) or riskSettledDay != etDay) ? "今日未结算（上次 " + str.tostring(riskScore, "#.#") + "）" : riskScore >= riskThr ? "偏高 " + str.tostring(riskScore, "#.#") + featTxt + "｜考虑减隔夜仓" : "正常 " + str.tostring(riskScore, "#.#") + featTxt
        bool riskHot = not na(riskScore) and riskSettledDay == etDay and riskScore >= riskThr

        table.cell(card, 0, 0, "Fable Signal", text_color=INK1, text_halign=text.align_left, text_size=size.small)
        table.cell(card, 1, 0, cloudPosTxt + "·" + stackTxt + "｜今日 " + str.tostring(todayCount) + " 事件", text_color=cloudPosTxt == "慢云上" and stackBull ? UPC : cloudPosTxt == "慢云下" and stackBear ? DNC : INK2, text_size=size.small)
        table.cell(card, 0, 1, "位置", text_color=INK3, text_halign=text.align_left, text_size=size.small)
        table.cell(card, 1, 1, ratioTxt + atrUsedTxt, text_color=not na(dayUsed) and not na(atrD) and dayUsed >= atrD ? INK1 : INK2, text_size=size.small)
        table.cell(card, 0, 2, "下一位", text_color=INK3, text_halign=text.align_left, text_size=size.small)
        table.cell(card, 1, 2, nxtTxt, text_color=INK2, text_size=size.small)
        table.cell(card, 0, 3, "接下来看", text_color=INK3, text_halign=text.align_left, text_size=size.small)
        table.cell(card, 1, 3, watchTxt, text_color=INK2, text_size=size.small)
        table.cell(card, 0, 4, "日型", text_color=INK3, text_halign=text.align_left, text_size=size.small)
        table.cell(card, 1, 4, dtDisp, text_color=INK2, text_size=size.small)
        table.cell(card, 0, 5, "警示", text_color=INK3, text_halign=text.align_left, text_size=size.small)
        table.cell(card, 1, 5, cautionOn ? cautionTxt : "—｜最近 " + lastSignalText, text_color=cautionOn ? INK1 : INK3, text_size=size.small)
        table.cell(card, 0, 6, lastSigLive ? "若已进场" : "隔夜风险", text_color=INK3, text_halign=text.align_left, text_size=size.small)
        table.cell(card, 1, 6, lastSigLive ? posTxt2 : riskTxt, text_color=lastSigLive ? (lastSigDir == 1 ? UPC : DNC) : riskHot ? INK1 : INK3, text_size=size.small)
        // 垫行：TV 右下角 ⚡ 快捷按钮会盖住卡片最底部（评审必修1），空一行让它落在垫行上
        table.cell(card, 0, 7, " ", text_size=size.small)
        table.cell(card, 1, 7, " \n ", text_size=size.small)
    else
        table.clear(card, 0, 0, 1, 7)

