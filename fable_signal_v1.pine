// ---------------- v3.3.0 慢云翻色 + 陡势反抽带（= buddy 08-29 云色引擎）----------------
// cloudState 滞回带 0.008×日ATR（缠绕期保持旧色不判翻转）；翻色后 15 根
// 10m K（150min ≈ buddy 2.5h 门的 10m 近似）内为"新翻色期"；期内反弹/
// 回踩死在 e13 带（±0.03×日ATR）= 陡势受阻/踩住（陡势里价格够不到 e21）。
var int cloudState = 0          // 1=绿(34>48)  -1=红(34<48)  0=未建档
float cloudEps = 0.008 * atrD
int cloudNow = e34 < e48 - cloudEps ? -1 : e34 > e48 + cloudEps ? 1 : cloudState
bool cloudFlipRed = barstate.isconfirmed and cloudNow == -1 and cloudState == 1
bool cloudFlipGreen = barstate.isconfirmed and cloudNow == 1 and cloudState == -1
if barstate.isconfirmed
    cloudState := cloudNow
var int flipBarRed = na
var int flipBarGreen = na
if cloudFlipRed
    flipBarRed := bar_index
if cloudFlipGreen
    flipBarGreen := bar_index
bool freshRed = cloudState == -1 and not na(flipBarRed) and bar_index - flipBarRed <= 15
bool freshGreen = cloudState == 1 and not na(flipBarGreen) and bar_index - flipBarGreen <= 15
float steepZone = 0.03 * atrD
bool steepShortRaw = freshRed and close < slowBot and high >= e13 - steepZone and close < e13 and not cloudFlipRed
bool steepLongRaw = freshGreen and close > slowTop and low <= e13 + steepZone and close > e13 and not cloudFlipGreen
// 3 根冷却 + 同位去重（v3.3.1）：同一翻色期内拒绝位须比上次下移/上移
// ≥0.1×日ATR 才再标（趋势延伸后的新反抽才有信息，同位复读只制造噪声）
var int lastSteepShortBar = na
var int lastSteepLongBar = na
var float lastSteepShortHi = na
var float lastSteepLongLo = na
if cloudFlipRed
    lastSteepShortHi := na
if cloudFlipGreen
    lastSteepLongLo := na
bool steepShortSig = steepShortRaw and (na(lastSteepShortBar) or bar_index - lastSteepShortBar >= 3) and (na(lastSteepShortHi) or high <= lastSteepShortHi - 0.1 * atrD)
bool steepLongSig = steepLongRaw and (na(lastSteepLongBar) or bar_index - lastSteepLongBar >= 3) and (na(lastSteepLongLo) or low >= lastSteepLongLo + 0.1 * atrD)
if steepShortSig and barstate.isconfirmed
    lastSteepShortBar := bar_index
    lastSteepShortHi := high
if steepLongSig and barstate.isconfirmed
    lastSteepLongBar := bar_index
    lastSteepLongLo := low

plotshape(steepShortSig, "SB_SHORT", style=shape.triangledown, location=location.abovebar, color=DNC, size=size.tiny, text="反抽空", textcolor=DNC)
plotshape(steepLongSig, "SB_LONG", style=shape.triangleup, location=location.belowbar, color=UPC, size=size.tiny, text="回踩多", textcolor=UPC)
plotshape(cloudFlipRed, "CLOUD_RED", style=shape.diamond, location=location.abovebar, color=DNC, size=size.small)
plotshape(cloudFlipGreen, "CLOUD_GREEN", style=shape.diamond, location=location.belowbar, color=UPC, size=size.small)

alertcondition(cloudFlipRed, "Fable｜慢云翻红", '慢云翻红（EMA34 下穿 48·滞回确认）｜{{ticker}}｜趋势背景转空：从现在起反抽不过 13/21 均线带就是标准开空点｜= System 云色引擎同口径｜背景转换通报·提示不是订单')
alertcondition(cloudFlipGreen, "Fable｜慢云翻绿", '慢云翻绿（EMA34 上穿 48·滞回确认）｜{{ticker}}｜趋势背景转多：回踩 13/21 均线带不破就是标准开多点｜= System 云色引擎同口径｜背景转换通报·提示不是订单')
alertcondition(steepShortSig, "Fable｜陡势反抽受阻（云新翻红期）", '陡势反抽受阻｜{{ticker}}｜云新翻红期反弹死在 13 均线带——陡势里价格够不到 21 均线｜= System 反抽空卡陡势口径（08-28 复盘新增·样本极小自行取舍）｜提示不是订单')
alertcondition(steepLongSig, "Fable｜陡势回踩踩住（云新翻绿期）", '陡势回踩踩住｜{{ticker}}｜云新翻绿期回踩在 13 均线带获承接｜= System 回踩多卡陡势口径（08-28 复盘新增·样本极小自行取舍）｜提示不是订单')
