//@version=6
indicator("IDM Phase 1｜3m 入场管理 v3.2", shorttitle="IDM 3m 管理 R3.2", overlay=true, explicit_plot_zorder=true)

// Narrow confirmed-only 3m consumer.  It cannot create direction or a 10m
// opportunity.  WATCH events are observation-only and never become a plan.
// No orders, alerts, broker integration, or profitability claim.

string EXPECTED_SYMBOL = "CAPITALCOM:SPX500"
string GROUP_VIEW = "显示"
bool showFastCloud = input.bool(true, "显示 3m Ripster EMA5/12", group=GROUP_VIEW)
bool showPrimaryCloud = input.bool(false, "显示 previous-completed 10m EMA5/12", group=GROUP_VIEW)
bool showPlanLevels = input.bool(true, "显示当前 10m 保护 / 目标", group=GROUP_VIEW)
bool showCard = input.bool(true, "显示 3m 择时卡", group=GROUP_VIEW)

bool e_hostContractOk = ticker.standard(syminfo.tickerid) == EXPECTED_SYMBOL and timeframe.isintraday and timeframe.period == "3" and chart.is_standard

f_strict_pivot_high_2_2() =>
    not na(high[4]) and high[2] > high[4] and high[2] > high[3] and high[2] > high[1] and high[2] > high ? high[2] : na

f_strict_pivot_low_2_2() =>
    not na(low[4]) and low[2] < low[4] and low[2] < low[3] and low[2] < low[1] and low[2] < low ? low[2] : na

f_strict_pivot_high_time_2_2() =>
    not na(high[4]) and high[2] > high[4] and high[2] > high[3] and high[2] > high[1] and high[2] > high ? time[2] : na

f_strict_pivot_low_time_2_2() =>
    not na(low[4]) and low[2] < low[4] and low[2] < low[3] and low[2] < low[1] and low[2] < low ? time[2] : na

bool e_transportRepeatAllowed = true
int e_requestOffset = barstate.isrealtime ? 1 : 0
int e_chartOffset = barstate.isrealtime ? 0 : 1
[e_timeRaw, e_timeCloseRaw, e_dayKeyRaw, e_openRaw, e_highRaw, e_lowRaw, e_closeRaw, e_ema5Raw, e_ema12Raw, e_ema21Raw, e_ema48Raw, e_newPivotHighRaw, e_newPivotHighTimeRaw, e_newPivotLowRaw, e_newPivotLowTimeRaw] = request.security(syminfo.tickerid, "10", [time[e_requestOffset], time_close[e_requestOffset], time("D", "0000-2359", "America/New_York")[e_requestOffset], open[e_requestOffset], high[e_requestOffset], low[e_requestOffset], close[e_requestOffset], ta.ema(hl2, 5)[e_requestOffset], ta.ema(hl2, 12)[e_requestOffset], ta.ema(close, 21)[e_requestOffset], ta.ema(close, 48)[e_requestOffset], f_strict_pivot_high_2_2()[e_requestOffset], f_strict_pivot_high_time_2_2()[e_requestOffset], f_strict_pivot_low_2_2()[e_requestOffset], f_strict_pivot_low_time_2_2()[e_requestOffset]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
int e_time = e_timeRaw[e_chartOffset]
int e_timeClose = e_timeCloseRaw[e_chartOffset]
int e_dayKey = e_dayKeyRaw[e_chartOffset]
float e_open = e_openRaw[e_chartOffset]
float e_high = e_highRaw[e_chartOffset]
float e_low = e_lowRaw[e_chartOffset]
float e_close = e_closeRaw[e_chartOffset]
float e_ema5 = e_ema5Raw[e_chartOffset]
float e_ema12 = e_ema12Raw[e_chartOffset]
float e_ema21 = e_ema21Raw[e_chartOffset]
float e_ema48 = e_ema48Raw[e_chartOffset]
float e_newPivotHigh = e_newPivotHighRaw[e_chartOffset]
int e_newPivotHighTime = e_newPivotHighTimeRaw[e_chartOffset]
float e_newPivotLow = e_newPivotLowRaw[e_chartOffset]
int e_newPivotLowTime = e_newPivotLowTimeRaw[e_chartOffset]
float e_minimumTick = syminfo.mintick
bool e_sourceAvailable = barstate.isconfirmed and not na(e_timeClose) and time >= e_timeClose
bool e_modeOk = e_hostContractOk

// PRIMARY10M_CANONICAL_R3_BEGIN phase1-10m-primary-opportunity-3.0
string PRIMARY_PROTOCOL_VERSION = "phase1-10m-primary-opportunity-3.0"
string TIMING_PROTOCOL_VERSION = "phase1-3m-opportunity-timing-3.0"
bool POSITION_REVERSAL_ENABLED = false
int PRIMARY_INTERVAL_MS = 600000
int TIMING_INTERVAL_MS = 180000
int PIVOT_LEFT_BARS = 2
int PIVOT_RIGHT_BARS = 2
int MAX_PIVOT_LEVELS = 64
int MAX_REACTION_BARS = 6
int MAX_ACTIVE_BARS = 12
int MAX_TIMING_TRIGGER_BARS = 8
float MINIMUM_SPACE_R = 1.0

int DIRECTION_SHORT = -1
int DIRECTION_NONE = 0
int DIRECTION_LONG = 1

int STATE_DISABLED = -1
int STATE_WAIT_TREND = 0
int STATE_WAIT_CLEAR = 1
int STATE_ARMED = 2
int STATE_WAIT_REACTION = 3
int STATE_ACTIVE = 4

int OUTCOME_MAIN_SHORT = -2
int OUTCOME_WATCH_SHORT = -1
int OUTCOME_NO_OPPORTUNITY = 0
int OUTCOME_WATCH_LONG = 1
int OUTCOME_MAIN_LONG = 2
int OUTCOME_DONT_CHASE = 3

int EVENT_NONE = 0
int EVENT_WATCH_LONG = 1
int EVENT_WATCH_SHORT = -1
int EVENT_MAIN_LONG = 2
int EVENT_MAIN_SHORT = -2
int EVENT_DONT_CHASE = 3
int EVENT_SPACE_UNKNOWN = 4
int EVENT_INVALIDATED = 5
int EVENT_TARGET_REACHED = 6
int EVENT_EXPIRED = 7
int EVENT_CONTEXT_RESET = 8
int EVENT_DATA_RESET = 9

int REASON_DISABLED = 10
int REASON_DATA_INVALID = 11
int REASON_DATA_DUPLICATE_IGNORED = 12
int REASON_DATA_NON_MONOTONIC = 13
int REASON_DATA_GAP_RESET = 14
int REASON_WAIT_SLOW_TREND = 20
int REASON_EPOCH_STARTED = 21
int REASON_WAIT_FULL_CLEAR = 22
int REASON_EPISODE_ARMED = 23
int REASON_WAIT_FIRST_PULLBACK = 24
int REASON_FIRST_PULLBACK_WATCH = 25
int REASON_WAIT_LATER_RECLAIM = 26
int REASON_REACTION_EXPIRED = 27
int REASON_SLOW_CONTEXT_LOST = 28
int REASON_FROZEN_INVALIDATION_BROKEN = 29
int REASON_SPACE_UNKNOWN = 30
int REASON_SPACE_LT_1R = 31
int REASON_MAIN_OPPORTUNITY_ACTIVE = 32
int REASON_TARGET_REACHED = 33
int REASON_ACTIVE_EXPIRED = 34

int LEVEL_UNKNOWN = 0
int LEVEL_PRIOR_EXCURSION_10M = 1
int LEVEL_CONFIRMED_PIVOT_10M = 2
int LEVEL_PREVIOUS_COMPLETED_DAY_HIGH = 3
int LEVEL_PREVIOUS_COMPLETED_DAY_LOW = 4

f_source_priority(int source) =>
    source == LEVEL_PRIOR_EXCURSION_10M ? 1 : source == LEVEL_CONFIRMED_PIVOT_10M ? 2 : source == LEVEL_PREVIOUS_COMPLETED_DAY_HIGH or source == LEVEL_PREVIOUS_COMPLETED_DAY_LOW ? 3 : 99

f_provenance_rank(int value) =>
    nz(value, -1)

f_candidate_before(int direction, float leftPrice, int leftSource, int leftTime, float rightPrice, int rightSource, int rightTime) =>
    bool priceBefore = direction == DIRECTION_LONG ? leftPrice < rightPrice : leftPrice > rightPrice
    bool samePrice = leftPrice == rightPrice
    int leftPriority = f_source_priority(leftSource)
    int rightPriority = f_source_priority(rightSource)
    priceBefore or samePrice and (leftPriority < rightPriority or leftPriority == rightPriority and f_provenance_rank(leftTime) < f_provenance_rank(rightTime))

f_source_text(int source) =>
    source == LEVEL_PRIOR_EXCURSION_10M ? "PRIOR_EXCURSION_10M" : source == LEVEL_CONFIRMED_PIVOT_10M ? "CONFIRMED_PIVOT_10M" : source == LEVEL_PREVIOUS_COMPLETED_DAY_HIGH ? "PREVIOUS_COMPLETED_DAY_HIGH" : source == LEVEL_PREVIOUS_COMPLETED_DAY_LOW ? "PREVIOUS_COMPLETED_DAY_LOW" : "UNKNOWN"

f_source_card_text(int source) =>
    source == LEVEL_PRIOR_EXCURSION_10M ? "前段离云位" : source == LEVEL_CONFIRMED_PIVOT_10M ? "确认枢轴" : source == LEVEL_PREVIOUS_COMPLETED_DAY_HIGH ? "前完整日高" : source == LEVEL_PREVIOUS_COMPLETED_DAY_LOW ? "前完整日低" : "未知"

float e_cloudUpper = math.max(e_ema5, e_ema12)
float e_cloudLower = math.min(e_ema5, e_ema12)
int e_slowDirection = na(e_ema21) or na(e_ema48) ? DIRECTION_NONE : e_ema21 > e_ema48 and e_close >= e_ema48 ? DIRECTION_LONG : e_ema21 < e_ema48 and e_close <= e_ema48 ? DIRECTION_SHORT : DIRECTION_NONE
int e_fastDirection = na(e_ema5) or na(e_ema12) ? DIRECTION_NONE : e_ema5 > e_ema12 ? DIRECTION_LONG : e_ema5 < e_ema12 ? DIRECTION_SHORT : DIRECTION_NONE
bool e_dataReady = not na(e_time) and not na(e_timeClose) and not na(e_dayKey) and not na(e_open) and not na(e_high) and not na(e_low) and not na(e_close) and e_high >= e_low and e_high >= math.max(e_open, e_close) and e_low <= math.min(e_open, e_close) and not na(e_ema5) and not na(e_ema12) and not na(e_ema21) and not na(e_ema48) and not na(e_minimumTick) and e_minimumTick > 0

var int e_lastProcessedTime = na
var int e_contiguousBars = 0
var int e_state = STATE_WAIT_TREND
var int e_epochDirection = DIRECTION_NONE
var int e_epochStartTime = na
var int e_episodeStartTime = na
var float e_priorExcursion = na
var int e_priorExcursionTime = na
var int e_pullbackTime = na
var float e_reactionHigh = na
var float e_reactionLow = na
var float e_frozenInvalidation = na
var int e_reactionAge = 0
var int e_activeAge = 0
var bool e_opportunityActive = false
var int e_opportunityDirection = DIRECTION_NONE
var int e_opportunityTime = na
var float e_entryReference = na
var float e_invalidation = na
var float e_nextNamedLevel = na
var int e_nextNamedLevelSource = LEVEL_UNKNOWN
var int e_nextNamedLevelProvenanceTime = na
var float e_risk = na
var float e_space = na
var float e_spaceR = na
var int e_outcome = OUTCOME_NO_OPPORTUNITY
var int e_outcomeDirection = DIRECTION_NONE
var int e_reason = REASON_DISABLED
var int e_eventPulse = EVENT_NONE
var float e_markerPrice = na

var int e_currentDayKey = na
var float e_currentDayHigh = na
var float e_currentDayLow = na
var int e_currentDayFirstTime = na
var int e_currentDayLastTime = na
var int e_currentDayBarCount = 0
var bool e_currentDayContiguous = false
var float e_previousDayHigh = na
var float e_previousDayLow = na
var int e_previousDayAvailableTime = na
var bool e_previousDayHighConsumed = false
var bool e_previousDayLowConsumed = false

var array<float> e_pivotHighPrices = array.new_float(0)
var array<int> e_pivotHighTimes = array.new_int(0)
var array<bool> e_pivotHighConsumed = array.new_bool(0)
var array<float> e_pivotLowPrices = array.new_float(0)
var array<int> e_pivotLowTimes = array.new_int(0)
var array<bool> e_pivotLowConsumed = array.new_bool(0)

var array<float> e_frozenCandidatePrices = array.new_float(0)
var array<int> e_frozenCandidateSources = array.new_int(0)
var array<int> e_frozenCandidateTimes = array.new_int(0)
var array<bool> e_frozenCandidateConsumed = array.new_bool(0)

e_eventPulse := EVENT_NONE
e_markerPrice := na

bool e_exactDuplicate = e_modeOk and e_sourceAvailable and e_dataReady and not na(e_lastProcessedTime) and e_time == e_lastProcessedTime
bool e_backward = e_modeOk and e_sourceAvailable and e_dataReady and not na(e_lastProcessedTime) and e_time < e_lastProcessedTime
bool e_newSourceBar = e_modeOk and e_sourceAvailable and e_dataReady and (na(e_lastProcessedTime) or e_time > e_lastProcessedTime)

if not e_modeOk
    e_lastProcessedTime := na
    e_contiguousBars := 0
    e_state := STATE_DISABLED
    e_epochDirection := DIRECTION_NONE
    e_epochStartTime := na
    e_episodeStartTime := na
    e_priorExcursion := na
    e_priorExcursionTime := na
    e_pullbackTime := na
    e_reactionHigh := na
    e_reactionLow := na
    e_frozenInvalidation := na
    e_reactionAge := 0
    e_activeAge := 0
    e_opportunityActive := false
    e_opportunityDirection := DIRECTION_NONE
    e_opportunityTime := na
    e_entryReference := na
    e_invalidation := na
    e_nextNamedLevel := na
    e_nextNamedLevelSource := LEVEL_UNKNOWN
    e_nextNamedLevelProvenanceTime := na
    e_risk := na
    e_space := na
    e_spaceR := na
    e_outcome := OUTCOME_NO_OPPORTUNITY
    e_outcomeDirection := DIRECTION_NONE
    e_reason := REASON_DISABLED
    e_currentDayKey := na
    e_currentDayHigh := na
    e_currentDayLow := na
    e_currentDayFirstTime := na
    e_currentDayLastTime := na
    e_currentDayBarCount := 0
    e_currentDayContiguous := false
    e_previousDayHigh := na
    e_previousDayLow := na
    e_previousDayAvailableTime := na
    e_previousDayHighConsumed := false
    e_previousDayLowConsumed := false
    array.clear(e_pivotHighPrices)
    array.clear(e_pivotHighTimes)
    array.clear(e_pivotHighConsumed)
    array.clear(e_pivotLowPrices)
    array.clear(e_pivotLowTimes)
    array.clear(e_pivotLowConsumed)
    array.clear(e_frozenCandidatePrices)
    array.clear(e_frozenCandidateSources)
    array.clear(e_frozenCandidateTimes)
    array.clear(e_frozenCandidateConsumed)
else if e_sourceAvailable and not e_dataReady
    e_lastProcessedTime := na
    e_contiguousBars := 0
    e_state := STATE_DISABLED
    e_epochDirection := DIRECTION_NONE
    e_epochStartTime := na
    e_episodeStartTime := na
    e_priorExcursion := na
    e_priorExcursionTime := na
    e_pullbackTime := na
    e_reactionHigh := na
    e_reactionLow := na
    e_frozenInvalidation := na
    e_reactionAge := 0
    e_activeAge := 0
    e_opportunityActive := false
    e_opportunityDirection := DIRECTION_NONE
    e_opportunityTime := na
    e_entryReference := na
    e_invalidation := na
    e_nextNamedLevel := na
    e_nextNamedLevelSource := LEVEL_UNKNOWN
    e_nextNamedLevelProvenanceTime := na
    e_risk := na
    e_space := na
    e_spaceR := na
    e_outcome := OUTCOME_NO_OPPORTUNITY
    e_outcomeDirection := DIRECTION_NONE
    e_reason := REASON_DATA_INVALID
    e_eventPulse := EVENT_DATA_RESET
    e_currentDayKey := na
    e_currentDayHigh := na
    e_currentDayLow := na
    e_currentDayFirstTime := na
    e_currentDayLastTime := na
    e_currentDayBarCount := 0
    e_currentDayContiguous := false
    e_previousDayHigh := na
    e_previousDayLow := na
    e_previousDayAvailableTime := na
    e_previousDayHighConsumed := false
    e_previousDayLowConsumed := false
    array.clear(e_pivotHighPrices)
    array.clear(e_pivotHighTimes)
    array.clear(e_pivotHighConsumed)
    array.clear(e_pivotLowPrices)
    array.clear(e_pivotLowTimes)
    array.clear(e_pivotLowConsumed)
    array.clear(e_frozenCandidatePrices)
    array.clear(e_frozenCandidateSources)
    array.clear(e_frozenCandidateTimes)
    array.clear(e_frozenCandidateConsumed)
else if e_backward
    e_lastProcessedTime := na
    e_contiguousBars := 0
    e_state := STATE_DISABLED
    e_epochDirection := DIRECTION_NONE
    e_epochStartTime := na
    e_episodeStartTime := na
    e_priorExcursion := na
    e_priorExcursionTime := na
    e_pullbackTime := na
    e_reactionHigh := na
    e_reactionLow := na
    e_frozenInvalidation := na
    e_reactionAge := 0
    e_activeAge := 0
    e_opportunityActive := false
    e_opportunityDirection := DIRECTION_NONE
    e_opportunityTime := na
    e_entryReference := na
    e_invalidation := na
    e_nextNamedLevel := na
    e_nextNamedLevelSource := LEVEL_UNKNOWN
    e_nextNamedLevelProvenanceTime := na
    e_risk := na
    e_space := na
    e_spaceR := na
    e_outcome := OUTCOME_NO_OPPORTUNITY
    e_outcomeDirection := DIRECTION_NONE
    e_reason := REASON_DATA_NON_MONOTONIC
    e_eventPulse := EVENT_DATA_RESET
    e_currentDayKey := na
    e_currentDayHigh := na
    e_currentDayLow := na
    e_currentDayFirstTime := na
    e_currentDayLastTime := na
    e_currentDayBarCount := 0
    e_currentDayContiguous := false
    e_previousDayHigh := na
    e_previousDayLow := na
    e_previousDayAvailableTime := na
    e_previousDayHighConsumed := false
    e_previousDayLowConsumed := false
    array.clear(e_pivotHighPrices)
    array.clear(e_pivotHighTimes)
    array.clear(e_pivotHighConsumed)
    array.clear(e_pivotLowPrices)
    array.clear(e_pivotLowTimes)
    array.clear(e_pivotLowConsumed)
    array.clear(e_frozenCandidatePrices)
    array.clear(e_frozenCandidateSources)
    array.clear(e_frozenCandidateTimes)
    array.clear(e_frozenCandidateConsumed)
else if e_exactDuplicate and not e_transportRepeatAllowed
    e_reason := REASON_DATA_DUPLICATE_IGNORED
else if e_newSourceBar
    bool e_gapReset = not na(e_lastProcessedTime) and e_time - e_lastProcessedTime != PRIMARY_INTERVAL_MS
    e_lastProcessedTime := e_time

    if e_gapReset
        e_contiguousBars := 1
        e_state := STATE_WAIT_TREND
        e_epochDirection := DIRECTION_NONE
        e_epochStartTime := na
        e_episodeStartTime := na
        e_priorExcursion := na
        e_priorExcursionTime := na
        e_pullbackTime := na
        e_reactionHigh := na
        e_reactionLow := na
        e_frozenInvalidation := na
        e_reactionAge := 0
        e_activeAge := 0
        e_opportunityActive := false
        e_opportunityDirection := DIRECTION_NONE
        e_opportunityTime := na
        e_entryReference := na
        e_invalidation := na
        e_nextNamedLevel := na
        e_nextNamedLevelSource := LEVEL_UNKNOWN
        e_nextNamedLevelProvenanceTime := na
        e_risk := na
        e_space := na
        e_spaceR := na
        e_outcome := OUTCOME_NO_OPPORTUNITY
        e_outcomeDirection := DIRECTION_NONE
        e_reason := REASON_DATA_GAP_RESET
        e_eventPulse := EVENT_DATA_RESET
        array.clear(e_pivotHighPrices)
        array.clear(e_pivotHighTimes)
        array.clear(e_pivotHighConsumed)
        array.clear(e_pivotLowPrices)
        array.clear(e_pivotLowTimes)
        array.clear(e_pivotLowConsumed)
        array.clear(e_frozenCandidatePrices)
        array.clear(e_frozenCandidateSources)
        array.clear(e_frozenCandidateTimes)
        array.clear(e_frozenCandidateConsumed)
        e_currentDayKey := e_dayKey
        e_currentDayHigh := e_high
        e_currentDayLow := e_low
        e_currentDayFirstTime := e_time
        e_currentDayLastTime := e_time
        e_currentDayBarCount := 1
        e_currentDayContiguous := hour(e_time, "America/New_York") == 0 and minute(e_time, "America/New_York") == 0 and second(e_time, "America/New_York") == 0
        e_previousDayHigh := na
        e_previousDayLow := na
        e_previousDayAvailableTime := na
        e_previousDayHighConsumed := false
        e_previousDayLowConsumed := false
    else
        e_contiguousBars += 1

        // Publish a previous ET day only after a complete 144-bar wall-clock
        // sequence from 00:00 through 23:50.  Midday startup, any gap/reset,
        // and DST-transition days fail closed rather than creating a target.
        if na(e_currentDayKey)
            e_currentDayKey := e_dayKey
            e_currentDayHigh := na
            e_currentDayLow := na
            e_currentDayFirstTime := na
            e_currentDayLastTime := na
            e_currentDayBarCount := 0
            e_currentDayContiguous := true
        else if e_dayKey != e_currentDayKey
            int e_dayRolloverMs = e_dayKey - e_currentDayKey
            bool e_rollsToImmediateNextEtDay = e_dayRolloverMs >= 23 * 60 * 60 * 1000 and e_dayRolloverMs <= 25 * 60 * 60 * 1000
            bool e_previousDayComplete = e_rollsToImmediateNextEtDay and e_currentDayContiguous and e_currentDayBarCount == 144 and not na(e_currentDayFirstTime) and not na(e_currentDayLastTime) and hour(e_currentDayFirstTime, "America/New_York") == 0 and minute(e_currentDayFirstTime, "America/New_York") == 0 and second(e_currentDayFirstTime, "America/New_York") == 0 and hour(e_currentDayLastTime, "America/New_York") == 23 and minute(e_currentDayLastTime, "America/New_York") == 50 and second(e_currentDayLastTime, "America/New_York") == 0
            e_previousDayHigh := e_previousDayComplete ? e_currentDayHigh : na
            e_previousDayLow := e_previousDayComplete ? e_currentDayLow : na
            e_previousDayAvailableTime := e_previousDayComplete ? e_time : na
            e_previousDayHighConsumed := false
            e_previousDayLowConsumed := false
            e_currentDayKey := e_dayKey
            e_currentDayHigh := na
            e_currentDayLow := na
            e_currentDayFirstTime := na
            e_currentDayLastTime := na
            e_currentDayBarCount := 0
            e_currentDayContiguous := true

        // Consume only levels that were already registered before this bar.
        if array.size(e_pivotHighPrices) > 0
            for e_i = 0 to array.size(e_pivotHighPrices) - 1
                if e_high >= array.get(e_pivotHighPrices, e_i)
                    array.set(e_pivotHighConsumed, e_i, true)
        if array.size(e_pivotLowPrices) > 0
            for e_i = 0 to array.size(e_pivotLowPrices) - 1
                if e_low <= array.get(e_pivotLowPrices, e_i)
                    array.set(e_pivotLowConsumed, e_i, true)
        if not na(e_previousDayHigh) and e_high >= e_previousDayHigh
            e_previousDayHighConsumed := true
        if not na(e_previousDayLow) and e_low <= e_previousDayLow
            e_previousDayLowConsumed := true

        // WAIT_REACTION has frozen-invalidation priority over slow-context
        // loss on the same confirmed bar.
        if e_state == STATE_WAIT_REACTION
            bool e_reactionInvalidated = e_epochDirection == DIRECTION_LONG ? e_close < e_frozenInvalidation : e_close > e_frozenInvalidation
            if e_reactionInvalidated
                bool e_reactionAlsoLostSlow = e_slowDirection != e_epochDirection
                e_opportunityActive := false
                e_outcome := OUTCOME_NO_OPPORTUNITY
                e_outcomeDirection := DIRECTION_NONE
                e_eventPulse := EVENT_INVALIDATED
                e_markerPrice := e_frozenInvalidation
                e_reason := REASON_FROZEN_INVALIDATION_BROKEN
                if e_reactionAlsoLostSlow
                    e_state := STATE_WAIT_TREND
                    e_epochDirection := DIRECTION_NONE
                    e_epochStartTime := na
                else
                    e_state := STATE_WAIT_CLEAR
            else if e_slowDirection != e_epochDirection
                e_state := STATE_WAIT_TREND
                e_epochDirection := DIRECTION_NONE
                e_epochStartTime := na
                e_opportunityActive := false
                e_outcome := OUTCOME_NO_OPPORTUNITY
                e_outcomeDirection := DIRECTION_NONE
                e_reason := REASON_SLOW_CONTEXT_LOST
                e_eventPulse := EVENT_CONTEXT_RESET
            else
                if array.size(e_frozenCandidatePrices) > 0
                    for e_i = 0 to array.size(e_frozenCandidatePrices) - 1
                        float e_candidatePrice = array.get(e_frozenCandidatePrices, e_i)
                        bool e_consumedNow = e_epochDirection == DIRECTION_LONG ? e_high >= e_candidatePrice : e_low <= e_candidatePrice
                        if e_consumedNow
                            array.set(e_frozenCandidateConsumed, e_i, true)
                e_reactionAge += 1
                if e_reactionAge > MAX_REACTION_BARS
                    e_state := STATE_WAIT_CLEAR
                    e_opportunityActive := false
                    e_outcome := OUTCOME_NO_OPPORTUNITY
                    e_outcomeDirection := DIRECTION_NONE
                    e_reason := REASON_REACTION_EXPIRED
                    e_eventPulse := EVENT_EXPIRED
                else
                    bool e_laterReclaim = e_epochDirection == DIRECTION_LONG ? e_fastDirection == DIRECTION_LONG and e_close > e_reactionHigh and e_close > e_cloudUpper : e_fastDirection == DIRECTION_SHORT and e_close < e_reactionLow and e_close < e_cloudLower
                    if not e_laterReclaim
                        e_reason := REASON_WAIT_LATER_RECLAIM
                    else
                        float e_selectedPrice = na
                        int e_selectedSource = LEVEL_UNKNOWN
                        int e_selectedTime = na
                        if array.size(e_frozenCandidatePrices) > 0
                            for e_i = 0 to array.size(e_frozenCandidatePrices) - 1
                                float e_candidatePrice = array.get(e_frozenCandidatePrices, e_i)
                                int e_candidateSource = array.get(e_frozenCandidateSources, e_i)
                                int e_candidateTime = array.get(e_frozenCandidateTimes, e_i)
                                bool e_candidateConsumed = array.get(e_frozenCandidateConsumed, e_i)
                                bool e_candidateForward = e_epochDirection == DIRECTION_LONG ? e_candidatePrice > e_high : e_candidatePrice < e_low
                                if not e_candidateConsumed and e_candidateForward
                                    bool e_candidateBetter = na(e_selectedPrice) or f_candidate_before(e_epochDirection, e_candidatePrice, e_candidateSource, e_candidateTime, e_selectedPrice, e_selectedSource, e_selectedTime)
                                    if e_candidateBetter
                                        e_selectedPrice := e_candidatePrice
                                        e_selectedSource := e_candidateSource
                                        e_selectedTime := e_candidateTime

                        e_opportunityDirection := e_epochDirection
                        e_opportunityTime := e_time
                        e_entryReference := e_close
                        e_invalidation := e_frozenInvalidation
                        e_risk := e_opportunityDirection == DIRECTION_LONG ? e_entryReference - e_invalidation : e_invalidation - e_entryReference
                        e_nextNamedLevel := e_selectedPrice
                        e_nextNamedLevelSource := e_selectedSource
                        e_nextNamedLevelProvenanceTime := e_selectedTime
                        e_space := na(e_selectedPrice) ? na : e_opportunityDirection == DIRECTION_LONG ? e_selectedPrice - e_entryReference : e_entryReference - e_selectedPrice
                        e_spaceR := not na(e_space) and e_risk > 0 ? e_space / e_risk : na

                        if e_risk <= 2.0 * e_minimumTick or na(e_selectedPrice)
                            e_nextNamedLevel := na
                            e_nextNamedLevelSource := LEVEL_UNKNOWN
                            e_nextNamedLevelProvenanceTime := na
                            e_space := na
                            e_spaceR := na
                            e_state := STATE_WAIT_CLEAR
                            e_opportunityActive := false
                            e_outcome := OUTCOME_NO_OPPORTUNITY
                            e_outcomeDirection := DIRECTION_NONE
                            e_reason := REASON_SPACE_UNKNOWN
                            e_eventPulse := EVENT_SPACE_UNKNOWN
                        else if e_spaceR < MINIMUM_SPACE_R
                            e_state := STATE_WAIT_CLEAR
                            e_opportunityActive := false
                            e_outcome := OUTCOME_DONT_CHASE
                            e_outcomeDirection := e_opportunityDirection
                            e_reason := REASON_SPACE_LT_1R
                            e_eventPulse := EVENT_DONT_CHASE
                        else
                            e_state := STATE_ACTIVE
                            e_opportunityActive := true
                            e_activeAge := 0
                            e_outcomeDirection := e_opportunityDirection
                            e_markerPrice := e_entryReference
                            if e_opportunityDirection == DIRECTION_LONG
                                e_outcome := OUTCOME_MAIN_LONG
                                e_eventPulse := EVENT_MAIN_LONG
                            else
                                e_outcome := OUTCOME_MAIN_SHORT
                                e_eventPulse := EVENT_MAIN_SHORT
                            e_reason := REASON_MAIN_OPPORTUNITY_ACTIVE

        else if e_state == STATE_ACTIVE
            bool e_activeInvalidated = e_opportunityDirection == DIRECTION_LONG ? e_close < e_invalidation : e_close > e_invalidation
            bool e_activeTargetReached = not na(e_nextNamedLevel) and (e_opportunityDirection == DIRECTION_LONG ? e_high >= e_nextNamedLevel : e_low <= e_nextNamedLevel)
            if e_activeInvalidated
                bool e_activeAlsoLostSlow = e_slowDirection != e_epochDirection
                e_opportunityActive := false
                e_outcome := OUTCOME_NO_OPPORTUNITY
                e_outcomeDirection := DIRECTION_NONE
                e_reason := REASON_FROZEN_INVALIDATION_BROKEN
                e_eventPulse := EVENT_INVALIDATED
                e_markerPrice := e_invalidation
                if e_activeAlsoLostSlow
                    e_state := STATE_WAIT_TREND
                    e_epochDirection := DIRECTION_NONE
                    e_epochStartTime := na
                else
                    e_state := STATE_WAIT_CLEAR
            else if e_activeTargetReached
                bool e_targetAlsoLostSlow = e_slowDirection != e_epochDirection
                e_opportunityActive := false
                e_outcome := OUTCOME_NO_OPPORTUNITY
                e_outcomeDirection := DIRECTION_NONE
                e_reason := REASON_TARGET_REACHED
                e_eventPulse := EVENT_TARGET_REACHED
                if e_targetAlsoLostSlow
                    e_state := STATE_WAIT_TREND
                    e_epochDirection := DIRECTION_NONE
                    e_epochStartTime := na
                else
                    e_state := STATE_WAIT_CLEAR
            else if e_slowDirection != e_epochDirection
                e_state := STATE_WAIT_TREND
                e_epochDirection := DIRECTION_NONE
                e_epochStartTime := na
                e_opportunityActive := false
                e_outcome := OUTCOME_NO_OPPORTUNITY
                e_outcomeDirection := DIRECTION_NONE
                e_reason := REASON_SLOW_CONTEXT_LOST
                e_eventPulse := EVENT_INVALIDATED
            else
                e_activeAge += 1
                if e_activeAge > MAX_ACTIVE_BARS
                    e_state := STATE_WAIT_CLEAR
                    e_opportunityActive := false
                    e_outcome := OUTCOME_NO_OPPORTUNITY
                    e_outcomeDirection := DIRECTION_NONE
                    e_reason := REASON_ACTIVE_EXPIRED
                    e_eventPulse := EVENT_EXPIRED
                else
                    e_reason := REASON_MAIN_OPPORTUNITY_ACTIVE

        else if e_epochDirection != DIRECTION_NONE and e_slowDirection != e_epochDirection
            e_state := STATE_WAIT_TREND
            e_epochDirection := DIRECTION_NONE
            e_epochStartTime := na
            e_opportunityActive := false
            e_outcome := OUTCOME_NO_OPPORTUNITY
            e_outcomeDirection := DIRECTION_NONE
            e_reason := REASON_SLOW_CONTEXT_LOST
            e_eventPulse := EVENT_CONTEXT_RESET

        else if e_epochDirection == DIRECTION_NONE
            if e_slowDirection == DIRECTION_NONE
                e_state := STATE_WAIT_TREND
                e_outcome := OUTCOME_NO_OPPORTUNITY
                e_outcomeDirection := DIRECTION_NONE
                e_reason := REASON_WAIT_SLOW_TREND
            else
                e_state := STATE_WAIT_CLEAR
                e_epochDirection := e_slowDirection
                e_epochStartTime := e_time
                e_episodeStartTime := na
                e_priorExcursion := na
                e_priorExcursionTime := na
                e_pullbackTime := na
                e_reactionHigh := na
                e_reactionLow := na
                e_frozenInvalidation := na
                e_reactionAge := 0
                e_activeAge := 0
                e_opportunityActive := false
                e_opportunityDirection := DIRECTION_NONE
                e_opportunityTime := na
                e_entryReference := na
                e_invalidation := na
                e_nextNamedLevel := na
                e_nextNamedLevelSource := LEVEL_UNKNOWN
                e_nextNamedLevelProvenanceTime := na
                e_risk := na
                e_space := na
                e_spaceR := na
                e_outcome := OUTCOME_NO_OPPORTUNITY
                e_outcomeDirection := DIRECTION_NONE
                e_reason := REASON_EPOCH_STARTED
                array.clear(e_frozenCandidatePrices)
                array.clear(e_frozenCandidateSources)
                array.clear(e_frozenCandidateTimes)
                array.clear(e_frozenCandidateConsumed)

        else if e_state == STATE_WAIT_CLEAR
            bool e_fullDeparture = e_epochDirection == DIRECTION_LONG ? e_fastDirection == DIRECTION_LONG and e_low > e_cloudUpper and e_close > e_cloudUpper : e_fastDirection == DIRECTION_SHORT and e_high < e_cloudLower and e_close < e_cloudLower
            if e_fullDeparture
                e_state := STATE_ARMED
                e_episodeStartTime := e_time
                e_priorExcursion := e_epochDirection == DIRECTION_LONG ? e_high : e_low
                e_priorExcursionTime := e_time
                e_pullbackTime := na
                e_reactionHigh := na
                e_reactionLow := na
                e_frozenInvalidation := na
                e_reactionAge := 0
                e_activeAge := 0
                e_opportunityActive := false
                e_opportunityDirection := DIRECTION_NONE
                e_opportunityTime := na
                e_entryReference := na
                e_invalidation := na
                e_nextNamedLevel := na
                e_nextNamedLevelSource := LEVEL_UNKNOWN
                e_nextNamedLevelProvenanceTime := na
                e_risk := na
                e_space := na
                e_spaceR := na
                e_outcome := OUTCOME_NO_OPPORTUNITY
                e_outcomeDirection := DIRECTION_NONE
                e_reason := REASON_EPISODE_ARMED
                array.clear(e_frozenCandidatePrices)
                array.clear(e_frozenCandidateSources)
                array.clear(e_frozenCandidateTimes)
                array.clear(e_frozenCandidateConsumed)
            else
                e_reason := REASON_WAIT_FULL_CLEAR

        else if e_state == STATE_ARMED
            bool e_firstTouch = e_epochDirection == DIRECTION_LONG ? e_low <= e_cloudUpper : e_high >= e_cloudLower
            if e_firstTouch
                e_pullbackTime := e_time
                e_reactionHigh := e_high
                e_reactionLow := e_low
                e_frozenInvalidation := e_epochDirection == DIRECTION_LONG ? math.min(e_low, e_ema48) - 2.0 * e_minimumTick : math.max(e_high, e_ema48) + 2.0 * e_minimumTick
                e_reactionAge := 0
                e_state := STATE_WAIT_REACTION
                e_outcomeDirection := e_epochDirection
                array.clear(e_frozenCandidatePrices)
                array.clear(e_frozenCandidateSources)
                array.clear(e_frozenCandidateTimes)
                array.clear(e_frozenCandidateConsumed)

                bool e_priorForwardAtTouch = not na(e_priorExcursion) and (e_epochDirection == DIRECTION_LONG ? e_priorExcursion > e_high : e_priorExcursion < e_low)
                if e_priorForwardAtTouch
                    array.push(e_frozenCandidatePrices, e_priorExcursion)
                    array.push(e_frozenCandidateSources, LEVEL_PRIOR_EXCURSION_10M)
                    array.push(e_frozenCandidateTimes, e_priorExcursionTime)
                    array.push(e_frozenCandidateConsumed, false)

                if e_epochDirection == DIRECTION_LONG and array.size(e_pivotHighPrices) > 0
                    for e_i = 0 to array.size(e_pivotHighPrices) - 1
                        float e_candidatePrice = array.get(e_pivotHighPrices, e_i)
                        bool e_candidateConsumed = array.get(e_pivotHighConsumed, e_i)
                        if not e_candidateConsumed and e_candidatePrice > e_high
                            array.push(e_frozenCandidatePrices, e_candidatePrice)
                            array.push(e_frozenCandidateSources, LEVEL_CONFIRMED_PIVOT_10M)
                            array.push(e_frozenCandidateTimes, array.get(e_pivotHighTimes, e_i))
                            array.push(e_frozenCandidateConsumed, false)
                if e_epochDirection == DIRECTION_SHORT and array.size(e_pivotLowPrices) > 0
                    for e_i = 0 to array.size(e_pivotLowPrices) - 1
                        float e_candidatePrice = array.get(e_pivotLowPrices, e_i)
                        bool e_candidateConsumed = array.get(e_pivotLowConsumed, e_i)
                        if not e_candidateConsumed and e_candidatePrice < e_low
                            array.push(e_frozenCandidatePrices, e_candidatePrice)
                            array.push(e_frozenCandidateSources, LEVEL_CONFIRMED_PIVOT_10M)
                            array.push(e_frozenCandidateTimes, array.get(e_pivotLowTimes, e_i))
                            array.push(e_frozenCandidateConsumed, false)
                if e_epochDirection == DIRECTION_LONG and not na(e_previousDayHigh) and not e_previousDayHighConsumed and e_previousDayHigh > e_high
                    array.push(e_frozenCandidatePrices, e_previousDayHigh)
                    array.push(e_frozenCandidateSources, LEVEL_PREVIOUS_COMPLETED_DAY_HIGH)
                    array.push(e_frozenCandidateTimes, e_previousDayAvailableTime)
                    array.push(e_frozenCandidateConsumed, false)
                if e_epochDirection == DIRECTION_SHORT and not na(e_previousDayLow) and not e_previousDayLowConsumed and e_previousDayLow < e_low
                    array.push(e_frozenCandidatePrices, e_previousDayLow)
                    array.push(e_frozenCandidateSources, LEVEL_PREVIOUS_COMPLETED_DAY_LOW)
                    array.push(e_frozenCandidateTimes, e_previousDayAvailableTime)
                    array.push(e_frozenCandidateConsumed, false)

                // Freeze an ordered candidate set at touch: nearest price,
                // then source priority, then earliest causal provenance.
                int e_frozenCount = array.size(e_frozenCandidatePrices)
                if e_frozenCount > 1
                    for e_sortIndex = 1 to e_frozenCount - 1
                        float e_sortPrice = array.get(e_frozenCandidatePrices, e_sortIndex)
                        int e_sortSource = array.get(e_frozenCandidateSources, e_sortIndex)
                        int e_sortTime = array.get(e_frozenCandidateTimes, e_sortIndex)
                        bool e_sortConsumed = array.get(e_frozenCandidateConsumed, e_sortIndex)
                        int e_insertIndex = e_sortIndex - 1
                        while e_insertIndex >= 0
                            bool e_sortBefore = f_candidate_before(e_epochDirection, e_sortPrice, e_sortSource, e_sortTime, array.get(e_frozenCandidatePrices, e_insertIndex), array.get(e_frozenCandidateSources, e_insertIndex), array.get(e_frozenCandidateTimes, e_insertIndex))
                            if not e_sortBefore
                                break
                            array.set(e_frozenCandidatePrices, e_insertIndex + 1, array.get(e_frozenCandidatePrices, e_insertIndex))
                            array.set(e_frozenCandidateSources, e_insertIndex + 1, array.get(e_frozenCandidateSources, e_insertIndex))
                            array.set(e_frozenCandidateTimes, e_insertIndex + 1, array.get(e_frozenCandidateTimes, e_insertIndex))
                            array.set(e_frozenCandidateConsumed, e_insertIndex + 1, array.get(e_frozenCandidateConsumed, e_insertIndex))
                            e_insertIndex -= 1
                        array.set(e_frozenCandidatePrices, e_insertIndex + 1, e_sortPrice)
                        array.set(e_frozenCandidateSources, e_insertIndex + 1, e_sortSource)
                        array.set(e_frozenCandidateTimes, e_insertIndex + 1, e_sortTime)
                        array.set(e_frozenCandidateConsumed, e_insertIndex + 1, e_sortConsumed)

                if e_epochDirection == DIRECTION_LONG
                    e_outcome := OUTCOME_WATCH_LONG
                    e_eventPulse := EVENT_WATCH_LONG
                    e_markerPrice := e_low
                else
                    e_outcome := OUTCOME_WATCH_SHORT
                    e_eventPulse := EVENT_WATCH_SHORT
                    e_markerPrice := e_high
                e_reason := REASON_FIRST_PULLBACK_WATCH
            else
                if e_epochDirection == DIRECTION_LONG
                    if na(e_priorExcursion) or e_high > e_priorExcursion
                        e_priorExcursion := e_high
                        e_priorExcursionTime := e_time
                else
                    if na(e_priorExcursion) or e_low < e_priorExcursion
                        e_priorExcursion := e_low
                        e_priorExcursionTime := e_time
                e_reason := REASON_WAIT_FIRST_PULLBACK

        // Finalize the current ET day only after state logic has consumed
        // the previous-completed snapshot.
        if e_currentDayBarCount == 0
            e_currentDayFirstTime := e_time
            e_currentDayLastTime := e_time
            e_currentDayBarCount := 1
            e_currentDayContiguous := hour(e_time, "America/New_York") == 0 and minute(e_time, "America/New_York") == 0 and second(e_time, "America/New_York") == 0
        else
            e_currentDayContiguous := e_currentDayContiguous and e_time - e_currentDayLastTime == PRIMARY_INTERVAL_MS
            e_currentDayLastTime := e_time
            e_currentDayBarCount += 1
        e_currentDayHigh := na(e_currentDayHigh) ? e_high : math.max(e_currentDayHigh, e_high)
        e_currentDayLow := na(e_currentDayLow) ? e_low : math.min(e_currentDayLow, e_low)

        // Register 2/2 pivots after state advancement.  A pivot becoming
        // known on the touch bar therefore cannot backfill that episode.
        if e_contiguousBars >= PIVOT_LEFT_BARS + PIVOT_RIGHT_BARS + 1 and not na(e_newPivotHigh)
            array.push(e_pivotHighPrices, e_newPivotHigh)
            array.push(e_pivotHighTimes, e_newPivotHighTime)
            array.push(e_pivotHighConsumed, false)
            if array.size(e_pivotHighPrices) > MAX_PIVOT_LEVELS
                array.shift(e_pivotHighPrices)
                array.shift(e_pivotHighTimes)
                array.shift(e_pivotHighConsumed)
        if e_contiguousBars >= PIVOT_LEFT_BARS + PIVOT_RIGHT_BARS + 1 and not na(e_newPivotLow)
            array.push(e_pivotLowPrices, e_newPivotLow)
            array.push(e_pivotLowTimes, e_newPivotLowTime)
            array.push(e_pivotLowConsumed, false)
            if array.size(e_pivotLowPrices) > MAX_PIVOT_LEVELS
                array.shift(e_pivotLowPrices)
                array.shift(e_pivotLowTimes)
                array.shift(e_pivotLowConsumed)
// PRIMARY10M_CANONICAL_R3_END phase1-10m-primary-opportunity-3.0

int TIMING_DISABLED = -1
int TIMING_WAIT_10M = 0
int TIMING_WAIT_PULLBACK = 1
int TIMING_WAIT_TRIGGER = 2
int TIMING_ENTERED = 3
int TIMING_LOCKED = 4

int TIMING_EVENT_NONE = 0
int TIMING_EVENT_LONG_ENTRY = 1
int TIMING_EVENT_SHORT_ENTRY = -1
int TIMING_EVENT_LONG_INVALIDATED = 2
int TIMING_EVENT_SHORT_INVALIDATED = -2
int TIMING_EVENT_LONG_TARGET_REACHED = 3
int TIMING_EVENT_SHORT_TARGET_REACHED = -3

int TIMING_REASON_DISABLED = 100
int TIMING_REASON_DATA_INVALID = 101
int TIMING_REASON_DATA_DUPLICATE_IGNORED = 102
int TIMING_REASON_DATA_NON_MONOTONIC = 103
int TIMING_REASON_DATA_GAP_RESET = 104
int TIMING_REASON_WAIT_10M = 110
int TIMING_REASON_NEW_OPPORTUNITY = 111
int TIMING_REASON_REPLACED = 112
int TIMING_REASON_SUPPRESSED = 113
int TIMING_REASON_WAIT_PULLBACK = 114
int TIMING_REASON_PULLBACK_FROZEN = 115
int TIMING_REASON_WAIT_LATER_TRIGGER = 116
int TIMING_REASON_TRIGGER_EXPIRED = 117
int TIMING_REASON_ENTRY_CONFIRMED = 118
int TIMING_REASON_INVALIDATED = 119
int TIMING_REASON_TARGET_REACHED = 120
int TIMING_REASON_OPPORTUNITY_ENDED = 121
int TIMING_REASON_SPACE_LT_1R = 122
int TIMING_REASON_ENTERED_PLAN_MANAGEMENT = 123

float fast3Ema5 = ta.ema(hl2, 5)
float fast3Ema12 = ta.ema(hl2, 12)
float fast3Upper = math.max(fast3Ema5, fast3Ema12)
float fast3Lower = math.min(fast3Ema5, fast3Ema12)
int fast3Direction = na(fast3Ema5) or na(fast3Ema12) ? DIRECTION_NONE : fast3Ema5 > fast3Ema12 ? DIRECTION_LONG : fast3Ema5 < fast3Ema12 ? DIRECTION_SHORT : DIRECTION_NONE
bool timingDataReady = not na(fast3Ema5) and not na(fast3Ema12) and high >= low and high >= math.max(open, close) and low <= math.min(open, close)

var int timingLastTime = na
var int timingState = TIMING_WAIT_10M
var int timingPlanDirection = DIRECTION_NONE
var int timingPlanTime = na
var float timingPlanEntry = na
var float timingPlanInvalidation = na
var float timingPlanTarget = na
var int timingPlanTargetSource = LEVEL_UNKNOWN
var float timingFrozenTrigger = na
var int timingTriggerAge = 0
var int timingEventPulse = TIMING_EVENT_NONE
var float timingMarkerPrice = na
var int timingEventDirection = DIRECTION_NONE
var int timingEventOpportunityTime = na
var int timingReason = TIMING_REASON_WAIT_10M
var int timingLockedReason = TIMING_REASON_WAIT_10M
var int timingSuppressedDirection = DIRECTION_NONE
var int timingSuppressedTime = na

timingEventPulse := TIMING_EVENT_NONE
timingMarkerPrice := na
timingEventDirection := DIRECTION_NONE
timingEventOpportunityTime := na

bool timingDuplicate = e_modeOk and barstate.isconfirmed and timingDataReady and not na(timingLastTime) and time == timingLastTime
bool timingBackward = e_modeOk and barstate.isconfirmed and timingDataReady and not na(timingLastTime) and time < timingLastTime
bool timingNewBar = e_modeOk and barstate.isconfirmed and timingDataReady and (na(timingLastTime) or time > timingLastTime)

if not e_modeOk
    if not na(timingPlanTime)
        timingSuppressedDirection := timingPlanDirection
        timingSuppressedTime := timingPlanTime
    timingLastTime := na
    timingState := TIMING_DISABLED
    timingPlanDirection := DIRECTION_NONE
    timingPlanTime := na
    timingPlanEntry := na
    timingPlanInvalidation := na
    timingPlanTarget := na
    timingPlanTargetSource := LEVEL_UNKNOWN
    timingFrozenTrigger := na
    timingTriggerAge := 0
    timingReason := TIMING_REASON_DISABLED
    timingLockedReason := TIMING_REASON_WAIT_10M
else if barstate.isconfirmed and not timingDataReady
    if not na(timingPlanTime)
        timingSuppressedDirection := timingPlanDirection
        timingSuppressedTime := timingPlanTime
    timingLastTime := na
    timingState := TIMING_DISABLED
    timingPlanDirection := DIRECTION_NONE
    timingPlanTime := na
    timingPlanEntry := na
    timingPlanInvalidation := na
    timingPlanTarget := na
    timingPlanTargetSource := LEVEL_UNKNOWN
    timingFrozenTrigger := na
    timingTriggerAge := 0
    timingReason := TIMING_REASON_DATA_INVALID
    timingLockedReason := TIMING_REASON_WAIT_10M
else if timingBackward
    if not na(timingPlanTime)
        timingSuppressedDirection := timingPlanDirection
        timingSuppressedTime := timingPlanTime
    timingLastTime := na
    timingState := TIMING_DISABLED
    timingPlanDirection := DIRECTION_NONE
    timingPlanTime := na
    timingPlanEntry := na
    timingPlanInvalidation := na
    timingPlanTarget := na
    timingPlanTargetSource := LEVEL_UNKNOWN
    timingFrozenTrigger := na
    timingTriggerAge := 0
    timingReason := TIMING_REASON_DATA_NON_MONOTONIC
    timingLockedReason := TIMING_REASON_WAIT_10M
else if timingDuplicate
    timingReason := TIMING_REASON_DATA_DUPLICATE_IGNORED
else if timingNewBar
    bool timingGapReset = not na(timingLastTime) and time - timingLastTime != TIMING_INTERVAL_MS
    timingLastTime := time
    if timingGapReset
        if not na(timingPlanTime)
            timingSuppressedDirection := timingPlanDirection
            timingSuppressedTime := timingPlanTime
        timingState := TIMING_WAIT_10M
        timingPlanDirection := DIRECTION_NONE
        timingPlanTime := na
        timingPlanEntry := na
        timingPlanInvalidation := na
        timingPlanTarget := na
        timingPlanTargetSource := LEVEL_UNKNOWN
        timingFrozenTrigger := na
        timingTriggerAge := 0
        timingReason := TIMING_REASON_DATA_GAP_RESET
        timingLockedReason := TIMING_REASON_WAIT_10M
    else
        bool hasOldPlan = not na(timingPlanTime) and timingPlanDirection != DIRECTION_NONE
        bool newPlanAvailable = e_opportunityActive and not na(e_opportunityTime) and e_opportunityDirection != DIRECTION_NONE
        bool terminalAlreadyEmitted = timingState == TIMING_LOCKED
        bool primaryEventMatchesOld = hasOldPlan and e_opportunityDirection == timingPlanDirection and e_opportunityTime == timingPlanTime
        bool oldInvalidated = hasOldPlan and not terminalAlreadyEmitted and ((timingPlanDirection == DIRECTION_LONG ? close < timingPlanInvalidation : close > timingPlanInvalidation) or (primaryEventMatchesOld and e_eventPulse == EVENT_INVALIDATED))
        bool oldTargetReached = hasOldPlan and not terminalAlreadyEmitted and not na(timingPlanTarget) and ((timingPlanDirection == DIRECTION_LONG ? high >= timingPlanTarget : low <= timingPlanTarget) or (primaryEventMatchesOld and e_eventPulse == EVENT_TARGET_REACHED))

        // The frozen old plan always owns terminal arbitration on this 3m bar.
        // Invalidation precedes target and neither may be bypassed by a new ID.
        if oldInvalidated
            timingSuppressedDirection := timingPlanDirection
            timingSuppressedTime := timingPlanTime
            timingEventPulse := timingPlanDirection == DIRECTION_LONG ? TIMING_EVENT_LONG_INVALIDATED : TIMING_EVENT_SHORT_INVALIDATED
            timingMarkerPrice := timingPlanInvalidation
            timingEventDirection := timingPlanDirection
            timingEventOpportunityTime := timingPlanTime
            timingState := TIMING_LOCKED
            timingFrozenTrigger := na
            timingTriggerAge := 0
            timingReason := TIMING_REASON_INVALIDATED
            timingLockedReason := TIMING_REASON_INVALIDATED
        else if oldTargetReached
            timingSuppressedDirection := timingPlanDirection
            timingSuppressedTime := timingPlanTime
            timingEventPulse := timingPlanDirection == DIRECTION_LONG ? TIMING_EVENT_LONG_TARGET_REACHED : TIMING_EVENT_SHORT_TARGET_REACHED
            timingMarkerPrice := timingPlanTarget
            timingEventDirection := timingPlanDirection
            timingEventOpportunityTime := timingPlanTime
            timingState := TIMING_LOCKED
            timingFrozenTrigger := na
            timingTriggerAge := 0
            timingReason := TIMING_REASON_TARGET_REACHED
            timingLockedReason := TIMING_REASON_TARGET_REACHED

        // R3 separates entry-permission expiry from entered-plan management.
        // ACTIVE_EXPIRED, active_plan=None, or a different plan cannot evict ENTERED.
        else if timingState == TIMING_ENTERED and hasOldPlan
            timingReason := TIMING_REASON_ENTERED_PLAN_MANAGEMENT

        else if not newPlanAvailable
            if hasOldPlan
                timingSuppressedDirection := timingPlanDirection
                timingSuppressedTime := timingPlanTime
                timingState := TIMING_WAIT_10M
                timingReason := TIMING_REASON_OPPORTUNITY_ENDED
            else
                timingState := TIMING_WAIT_10M
                timingReason := TIMING_REASON_WAIT_10M
            timingPlanDirection := DIRECTION_NONE
            timingPlanTime := na
            timingPlanEntry := na
            timingPlanInvalidation := na
            timingPlanTarget := na
            timingPlanTargetSource := LEVEL_UNKNOWN
            timingFrozenTrigger := na
            timingTriggerAge := 0
            timingLockedReason := TIMING_REASON_WAIT_10M

        else
            bool sameAsSuppressed = not hasOldPlan and e_opportunityDirection == timingSuppressedDirection and e_opportunityTime == timingSuppressedTime
            bool isNewPlan = not hasOldPlan or e_opportunityDirection != timingPlanDirection or e_opportunityTime != timingPlanTime
            if sameAsSuppressed
                timingState := TIMING_WAIT_10M
                timingReason := TIMING_REASON_SUPPRESSED
            else if isNewPlan
                bool replacingOldPlan = hasOldPlan
                timingSuppressedDirection := DIRECTION_NONE
                timingSuppressedTime := na
                timingPlanDirection := e_opportunityDirection
                timingPlanTime := e_opportunityTime
                timingPlanEntry := e_entryReference
                timingPlanInvalidation := e_invalidation
                timingPlanTarget := e_nextNamedLevel
                timingPlanTargetSource := e_nextNamedLevelSource
                timingFrozenTrigger := na
                timingTriggerAge := 0
                timingState := TIMING_WAIT_PULLBACK
                timingLockedReason := TIMING_REASON_WAIT_10M
                bool handoffOverlap = not na(time[1]) and time[1] < e_timeClose and time_close[1] > e_timeClose
                bool handoffCloseInvalid = handoffOverlap and (timingPlanDirection == DIRECTION_LONG ? close[1] < timingPlanInvalidation : close[1] > timingPlanInvalidation)
                bool handoffTargetTouched = handoffOverlap and not na(timingPlanTarget) and (timingPlanDirection == DIRECTION_LONG ? high[1] >= timingPlanTarget : low[1] <= timingPlanTarget)
                bool newAlreadyInvalid = (timingPlanDirection == DIRECTION_LONG ? close < timingPlanInvalidation : close > timingPlanInvalidation) or handoffCloseInvalid
                bool newAlreadyAtTarget = not na(timingPlanTarget) and ((timingPlanDirection == DIRECTION_LONG ? high >= timingPlanTarget : low <= timingPlanTarget) or handoffTargetTouched)
                if newAlreadyInvalid
                    timingSuppressedDirection := timingPlanDirection
                    timingSuppressedTime := timingPlanTime
                    timingEventPulse := timingPlanDirection == DIRECTION_LONG ? TIMING_EVENT_LONG_INVALIDATED : TIMING_EVENT_SHORT_INVALIDATED
                    timingMarkerPrice := timingPlanInvalidation
                    timingEventDirection := timingPlanDirection
                    timingEventOpportunityTime := timingPlanTime
                    timingState := TIMING_LOCKED
                    timingReason := TIMING_REASON_INVALIDATED
                    timingLockedReason := TIMING_REASON_INVALIDATED
                else if newAlreadyAtTarget
                    timingSuppressedDirection := timingPlanDirection
                    timingSuppressedTime := timingPlanTime
                    timingEventPulse := timingPlanDirection == DIRECTION_LONG ? TIMING_EVENT_LONG_TARGET_REACHED : TIMING_EVENT_SHORT_TARGET_REACHED
                    timingMarkerPrice := timingPlanTarget
                    timingEventDirection := timingPlanDirection
                    timingEventOpportunityTime := timingPlanTime
                    timingState := TIMING_LOCKED
                    timingReason := TIMING_REASON_TARGET_REACHED
                    timingLockedReason := TIMING_REASON_TARGET_REACHED
                else
                    // Adoption is terminal for this 3m K; same-bar entry is forbidden.
                    timingReason := replacingOldPlan ? TIMING_REASON_REPLACED : TIMING_REASON_NEW_OPPORTUNITY
            else
                bool currentPrimaryMatches = e_opportunityDirection == timingPlanDirection and e_opportunityTime == timingPlanTime
                bool currentInvalidated = timingState != TIMING_LOCKED and ((timingPlanDirection == DIRECTION_LONG ? close < timingPlanInvalidation : close > timingPlanInvalidation) or (currentPrimaryMatches and e_eventPulse == EVENT_INVALIDATED))
                bool currentTargetReached = timingState != TIMING_LOCKED and not na(timingPlanTarget) and ((timingPlanDirection == DIRECTION_LONG ? high >= timingPlanTarget : low <= timingPlanTarget) or (currentPrimaryMatches and e_eventPulse == EVENT_TARGET_REACHED))
                if currentInvalidated
                    timingSuppressedDirection := timingPlanDirection
                    timingSuppressedTime := timingPlanTime
                    timingEventPulse := timingPlanDirection == DIRECTION_LONG ? TIMING_EVENT_LONG_INVALIDATED : TIMING_EVENT_SHORT_INVALIDATED
                    timingMarkerPrice := timingPlanInvalidation
                    timingEventDirection := timingPlanDirection
                    timingEventOpportunityTime := timingPlanTime
                    timingState := TIMING_LOCKED
                    timingFrozenTrigger := na
                    timingTriggerAge := 0
                    timingReason := TIMING_REASON_INVALIDATED
                    timingLockedReason := TIMING_REASON_INVALIDATED
                else if currentTargetReached
                    timingSuppressedDirection := timingPlanDirection
                    timingSuppressedTime := timingPlanTime
                    timingEventPulse := timingPlanDirection == DIRECTION_LONG ? TIMING_EVENT_LONG_TARGET_REACHED : TIMING_EVENT_SHORT_TARGET_REACHED
                    timingMarkerPrice := timingPlanTarget
                    timingEventDirection := timingPlanDirection
                    timingEventOpportunityTime := timingPlanTime
                    timingState := TIMING_LOCKED
                    timingFrozenTrigger := na
                    timingTriggerAge := 0
                    timingReason := TIMING_REASON_TARGET_REACHED
                    timingLockedReason := TIMING_REASON_TARGET_REACHED
                else if timingState == TIMING_LOCKED
                    timingReason := timingLockedReason
                else if timingState == TIMING_WAIT_PULLBACK
                    bool timingTouch = timingPlanDirection == DIRECTION_LONG ? low <= fast3Upper : high >= fast3Lower
                    if timingTouch
                        timingFrozenTrigger := timingPlanDirection == DIRECTION_LONG ? high : low
                        timingTriggerAge := 0
                        timingState := TIMING_WAIT_TRIGGER
                        timingReason := TIMING_REASON_PULLBACK_FROZEN
                    else
                        timingReason := TIMING_REASON_WAIT_PULLBACK
                else if timingState == TIMING_WAIT_TRIGGER
                    timingTriggerAge += 1
                    if timingTriggerAge > MAX_TIMING_TRIGGER_BARS
                        timingSuppressedDirection := timingPlanDirection
                        timingSuppressedTime := timingPlanTime
                        timingState := TIMING_LOCKED
                        timingFrozenTrigger := na
                        timingTriggerAge := 0
                        timingReason := TIMING_REASON_TRIGGER_EXPIRED
                        timingLockedReason := TIMING_REASON_TRIGGER_EXPIRED
                    else
                        bool timingLongEntry = timingPlanDirection == DIRECTION_LONG and fast3Direction == DIRECTION_LONG and close > timingFrozenTrigger and close > fast3Upper
                        bool timingShortEntry = timingPlanDirection == DIRECTION_SHORT and fast3Direction == DIRECTION_SHORT and close < timingFrozenTrigger and close < fast3Lower
                        if timingLongEntry or timingShortEntry
                            float timingRiskNow = timingPlanDirection == DIRECTION_LONG ? close - timingPlanInvalidation : timingPlanInvalidation - close
                            float timingSpaceNow = timingPlanDirection == DIRECTION_LONG ? timingPlanTarget - close : close - timingPlanTarget
                            float timingSpaceRNow = timingRiskNow > 0 and timingSpaceNow > 0 ? timingSpaceNow / timingRiskNow : na
                            if na(timingSpaceRNow) or timingSpaceRNow < MINIMUM_SPACE_R
                                timingSuppressedDirection := timingPlanDirection
                                timingSuppressedTime := timingPlanTime
                                timingState := TIMING_LOCKED
                                timingFrozenTrigger := na
                                timingTriggerAge := 0
                                timingReason := TIMING_REASON_SPACE_LT_1R
                                timingLockedReason := TIMING_REASON_SPACE_LT_1R
                            else
                                timingSuppressedDirection := timingPlanDirection
                                timingSuppressedTime := timingPlanTime
                                timingEventPulse := timingLongEntry ? TIMING_EVENT_LONG_ENTRY : TIMING_EVENT_SHORT_ENTRY
                                timingMarkerPrice := close
                                timingEventDirection := timingPlanDirection
                                timingEventOpportunityTime := timingPlanTime
                                timingState := TIMING_ENTERED
                                timingReason := TIMING_REASON_ENTRY_CONFIRMED
                        else
                            timingReason := TIMING_REASON_WAIT_LATER_TRIGGER
                else if timingState == TIMING_ENTERED
                    timingReason := TIMING_REASON_ENTERED_PLAN_MANAGEMENT

f_price(float value) =>
    na(value) ? "—" : str.tostring(value, format.mintick)

f_time(int value) =>
    na(value) ? "—" : str.format_time(value, "MM-dd HH:mm", "America/New_York")

f_timing_state_text(int state) =>
    state == TIMING_DISABLED ? "DISABLED" : state == TIMING_WAIT_10M ? "WAIT_10M" : state == TIMING_WAIT_PULLBACK ? "WAIT_PULLBACK" : state == TIMING_WAIT_TRIGGER ? "WAIT_TRIGGER" : state == TIMING_ENTERED ? "ENTERED" : "LOCKED"

f_timing_reason_text(int reason) =>
    reason == TIMING_REASON_DISABLED ? "宿主合同未满足" : reason == TIMING_REASON_DATA_INVALID ? "数据无效，suppression 保留" : reason == TIMING_REASON_DATA_DUPLICATE_IGNORED ? "重复时间戳未推进" : reason == TIMING_REASON_DATA_NON_MONOTONIC ? "倒序时间戳，suppression 保留" : reason == TIMING_REASON_DATA_GAP_RESET ? "3m gap reset，suppression 保留" : reason == TIMING_REASON_WAIT_10M ? "等待 active 10m 主机会" : reason == TIMING_REASON_NEW_OPPORTUNITY ? "采用新 10m plan；本 K 禁入" : reason == TIMING_REASON_REPLACED ? "替换未入场旧 plan；本 K 禁入" : reason == TIMING_REASON_SUPPRESSED ? "该 10m plan 已消费，禁止重接纳" : reason == TIMING_REASON_WAIT_PULLBACK ? "等待 3m 5/12 回踩/反弹" : reason == TIMING_REASON_PULLBACK_FROZEN ? "已冻 trigger；等待 later confirmed" : reason == TIMING_REASON_WAIT_LATER_TRIGGER ? "等待 later trigger" : reason == TIMING_REASON_TRIGGER_EXPIRED ? "3m trigger 到期" : reason == TIMING_REASON_ENTRY_CONFIRMED ? "仅一次入场择时 marker" : reason == TIMING_REASON_INVALIDATED ? "冻结保护被 confirmed close 破坏" : reason == TIMING_REASON_TARGET_REACHED ? "冻结目标已到" : reason == TIMING_REASON_OPPORTUNITY_ENDED ? "未入场 permission 已结束" : reason == TIMING_REASON_SPACE_LT_1R ? "实际入场时空间缩水至 <1R" : reason == TIMING_REASON_ENTERED_PLAN_MANAGEMENT ? "已入场｜持续管理冻结保护/目标" : "未知"

f_timing_reason_card_text() =>
    timingReason == TIMING_REASON_DISABLED ? "宿主合同未满足" : timingReason == TIMING_REASON_DATA_INVALID ? "数据无效｜已停用" : timingReason == TIMING_REASON_DATA_DUPLICATE_IGNORED ? "重复 K｜未推进" : timingReason == TIMING_REASON_DATA_NON_MONOTONIC ? "时间倒序｜已重置" : timingReason == TIMING_REASON_DATA_GAP_RESET ? "3m 缺口｜已重置" : timingReason == TIMING_REASON_WAIT_10M ? "10m 尚无可用主计划" : timingReason == TIMING_REASON_NEW_OPPORTUNITY ? "新 10m 计划｜本 K 禁入" : timingReason == TIMING_REASON_REPLACED ? "替换旧计划｜本 K 禁入" : timingReason == TIMING_REASON_SUPPRESSED ? "该 10m 计划已消费" : timingReason == TIMING_REASON_WAIT_PULLBACK ? "等 3m 回踩 5/12 云" : timingReason == TIMING_REASON_PULLBACK_FROZEN ? "已冻触发价｜等后续收盘" : timingReason == TIMING_REASON_WAIT_LATER_TRIGGER ? "方向+收盘尚未同时满足" : timingReason == TIMING_REASON_TRIGGER_EXPIRED ? "3m 触发窗口已过" : timingReason == TIMING_REASON_ENTRY_CONFIRMED ? "收盘+5/12 同向完成" : timingReason == TIMING_REASON_INVALIDATED ? "确认收盘已破保护" : timingReason == TIMING_REASON_TARGET_REACHED ? "冻结目标已到" : timingReason == TIMING_REASON_OPPORTUNITY_ENDED ? "10m 许可已结束" : timingReason == TIMING_REASON_SPACE_LT_1R ? "实际入场空间 <1R" : timingReason == TIMING_REASON_ENTERED_PLAN_MANAGEMENT ? "入场信号已触发｜跟踪保护/目标" : "未知原因"

f_timing_action_text() =>
    timingEventPulse == TIMING_EVENT_LONG_INVALIDATED ? "多计划失效｜结束" : timingEventPulse == TIMING_EVENT_SHORT_INVALIDATED ? "空计划失效｜结束" : timingEventPulse == TIMING_EVENT_LONG_TARGET_REACHED ? "多计划到达｜结束" : timingEventPulse == TIMING_EVENT_SHORT_TARGET_REACHED ? "空计划到达｜结束" : timingState == TIMING_ENTERED ? (timingPlanDirection == DIRECTION_LONG ? "多入已触发｜按计划管理" : "空入已触发｜按计划管理") : timingState == TIMING_WAIT_TRIGGER ? (timingPlanDirection == DIRECTION_LONG ? "等多触发｜不预判" : "等空触发｜不预判") : timingState == TIMING_WAIT_PULLBACK ? "等 3m 回踩｜不追" : timingState == TIMING_LOCKED ? "本计划结束｜等新 10m" : timingState == TIMING_DISABLED ? "停用｜数据/宿主不合约" : "等待 10m 计划"

f_timing_trigger_text() =>
    timingState == TIMING_WAIT_TRIGGER and not na(timingFrozenTrigger) ? (timingPlanDirection == DIRECTION_LONG ? "3m 收盘 > " + f_price(timingFrozenTrigger) + " 且 5/12 多" : "3m 收盘 < " + f_price(timingFrozenTrigger) + " 且 5/12 空") : timingState == TIMING_WAIT_PULLBACK ? "先等 5/12 回踩" : timingState == TIMING_ENTERED ? "已触发" : "—"

f_timing_direction_text() =>
    timingPlanDirection == DIRECTION_LONG ? "主多 plan" : timingPlanDirection == DIRECTION_SHORT ? "主空 plan" : "—"

float shownFast3Ema5 = showFastCloud and e_modeOk ? fast3Ema5 : na
float shownFast3Ema12 = showFastCloud and e_modeOk ? fast3Ema12 : na
pFast5 = plot(shownFast3Ema5, "3m Ripster EMA5｜hl2", color=color.new(color.green, 0), linewidth=2)
pFast12 = plot(shownFast3Ema12, "3m Ripster EMA12｜hl2", color=color.new(color.red, 0), linewidth=2)
fill(pFast5, pFast12, color=showFastCloud and e_modeOk ? (fast3Ema5 >= fast3Ema12 ? color.new(color.green, 72) : color.new(color.red, 72)) : na, title="3m Ripster 5/12 Cloud")
plot(showPrimaryCloud and e_modeOk ? e_ema5 : na, "previous-completed 10m Ripster EMA5", color=color.new(color.green, 70), linewidth=1, style=plot.style_linebr)
plot(showPrimaryCloud and e_modeOk ? e_ema12 : na, "previous-completed 10m Ripster EMA12", color=color.new(color.red, 70), linewidth=1, style=plot.style_linebr)

plotshape(timingEventPulse == TIMING_EVENT_LONG_ENTRY ? timingMarkerPrice : na, title="3m 多入场", text="多入", style=shape.labelup, location=location.absolute, color=color.new(color.lime, 0), textcolor=color.white, size=size.small)
plotshape(timingEventPulse == TIMING_EVENT_SHORT_ENTRY ? timingMarkerPrice : na, title="3m 空入场", text="空入", style=shape.labeldown, location=location.absolute, color=color.new(color.orange, 0), textcolor=color.white, size=size.small)
plotshape(timingEventPulse == TIMING_EVENT_LONG_INVALIDATED ? timingMarkerPrice : na, title="3m 多计划失效", text="多失", style=shape.xcross, location=location.absolute, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)
plotshape(timingEventPulse == TIMING_EVENT_SHORT_INVALIDATED ? timingMarkerPrice : na, title="3m 空计划失效", text="空失", style=shape.xcross, location=location.absolute, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)
plotshape(timingEventPulse == TIMING_EVENT_LONG_TARGET_REACHED ? timingMarkerPrice : na, title="3m 多计划到达", text="多达", style=shape.diamond, location=location.absolute, color=color.new(color.aqua, 0), textcolor=color.white, size=size.tiny)
plotshape(timingEventPulse == TIMING_EVENT_SHORT_TARGET_REACHED ? timingMarkerPrice : na, title="3m 空计划到达", text="空达", style=shape.diamond, location=location.absolute, color=color.new(color.aqua, 0), textcolor=color.white, size=size.tiny)

bool timingOwnsPlan = not na(timingPlanTime) and (timingState == TIMING_WAIT_PULLBACK or timingState == TIMING_WAIT_TRIGGER or timingState == TIMING_ENTERED)
plot(showPlanLevels and timingOwnsPlan ? timingPlanInvalidation : na, "当前 10m invalidation", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)
plot(showPlanLevels and timingOwnsPlan ? timingPlanTarget : na, "当前 10m target", color=color.new(color.lime, 0), linewidth=1, style=plot.style_linebr)

plot(e_eventPulse, "AUDIT｜10m event", display=display.data_window)
plot(e_opportunityActive ? 1 : 0, "AUDIT｜active 10m permission", display=display.data_window)
plot(e_opportunityTime, "AUDIT｜active 10m opportunity ms", display=display.data_window)
plot(e_nextNamedLevelSource, "AUDIT｜10m target source", display=display.data_window)
plot(timingState, "AUDIT｜3m state", display=display.data_window)
plot(timingReason, "AUDIT｜3m reason", display=display.data_window)
plot(timingSuppressedTime, "AUDIT｜suppressed opportunity ms", display=display.data_window)
plot(timingEventPulse, "AUDIT｜3m event", display=display.data_window)

float timingRiskNowForCard = na(timingPlanTime) ? na : timingPlanDirection == DIRECTION_LONG ? close - timingPlanInvalidation : timingPlanInvalidation - close
float timingSpaceNowForCard = na(timingPlanTime) or na(timingPlanTarget) ? na : timingPlanDirection == DIRECTION_LONG ? timingPlanTarget - close : close - timingPlanTarget
float timingSpaceRNowForCard = timingRiskNowForCard > 0 and timingSpaceNowForCard > 0 ? timingSpaceNowForCard / timingRiskNowForCard : na
bool timingTerminalPulse = timingEventPulse == TIMING_EVENT_LONG_INVALIDATED or timingEventPulse == TIMING_EVENT_SHORT_INVALIDATED or timingEventPulse == TIMING_EVENT_LONG_TARGET_REACHED or timingEventPulse == TIMING_EVENT_SHORT_TARGET_REACHED
bool timingCardPlanContext = timingOwnsPlan or timingTerminalPulse

var table timingCard = table.new(position.bottom_right, 2, 5, bgcolor=color.new(color.black, 8), frame_color=color.new(color.white, 55), frame_width=1)
f_timing_row(int row, string left, string right, color rightColor) =>
    table.cell(timingCard, 0, row, left, text_color=color.white, text_halign=text.align_left)
    table.cell(timingCard, 1, row, right, text_color=rightColor, text_halign=text.align_right)

if barstate.islast
    if showCard
        f_timing_row(0, "现在做", f_timing_action_text(), timingEventPulse == TIMING_EVENT_LONG_INVALIDATED or timingEventPulse == TIMING_EVENT_SHORT_INVALIDATED ? color.red : timingEventPulse == TIMING_EVENT_LONG_TARGET_REACHED or timingEventPulse == TIMING_EVENT_SHORT_TARGET_REACHED ? color.aqua : timingState == TIMING_ENTERED ? (timingPlanDirection == DIRECTION_LONG ? color.lime : color.orange) : color.white)
        f_timing_row(1, "原因", f_timing_reason_card_text(), color.white)
        f_timing_row(2, "触发", f_timing_trigger_text(), color.white)
        f_timing_row(3, "失效", timingCardPlanContext ? f_price(timingPlanInvalidation) : "—", color.white)
        f_timing_row(4, "目标", timingCardPlanContext ? f_price(timingPlanTarget) + "｜" + (na(timingSpaceRNowForCard) ? "—" : str.tostring(timingSpaceRNowForCard, "#0.00") + "R") : "—", timingCardPlanContext and timingSpaceRNowForCard >= MINIMUM_SPACE_R ? color.lime : color.white)
    else
        table.clear(timingCard, 0, 0, 1, 4)
